---
// Editorial header for blog posts and guides: a navy band (homepage family,
// canal-ring motif) with breadcrumb, category pill, H1, dek and a meta row
// with share buttons, plus a reading-progress bar under the site header.
// The page's first main-column element (.ah-feature) and its sidebar
// (.ah-sidebar) are pulled up into the band; see the global styles below.
// Slots: "top" (breadcrumb), default (meta items after the author).
import ShareLinks from './ShareLinks.astro';
interface Props { title: string; dek?: string; pills?: string[]; author?: string }
const { title, dek, pills = [], author = 'HRHelp Team' } = Astro.props;
---
<div class="ah-progress" aria-hidden="true"><span class="ah-progress-bar"></span></div>

<section class="ah">
  <div class="container ah-grid">
    <div class="ah-text">
      <slot name="top" />
      {pills.length > 0 && (
        <div class="ah-pills">
          {pills.map(p => <span class="ah-pill">{p}</span>)}
        </div>
      )}
      <h1 class="ah-title">{title}</h1>
      {dek && <p class="ah-dek">{dek}</p>}
      <div class="ah-meta-row">
        <div class="ah-byline">
          <span class="ah-avatar"><img src="/favicon.svg" alt="" width="26" height="26" /></span>
          <div>
            <span class="ah-author">{author}</span>
            <div class="ah-meta"><slot /></div>
          </div>
        </div>
        <ShareLinks title={title} tone="dark" class="ah-share" />
      </div>
    </div>
  </div>
</section>

<script>
  // Reading progress through the article body (.ah-progress-target)
  const bar = document.querySelector<HTMLElement>('.ah-progress-bar');
  const target = document.querySelector<HTMLElement>('.ah-progress-target');
  if (bar && target) {
    let ticking = false;
    const update = () => {
      ticking = false;
      // 0 when the article's top meets the header, 1 when its end is in view
      const r = target.getBoundingClientRect();
      const total = r.height - window.innerHeight + 72;
      const p = total > 0 ? Math.min(1, Math.max(0, (72 - r.top) / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    window.addEventListener('resize', update);
    update();
  }


</script>

<style>
.ah {
  --ah-pad: clamp(2.5rem, 1.5rem + 2.5vw, 3.75rem);
  position: relative;
  /* 72px clears the fixed site header; the bottom leaves room for the
     overlapping feature element */
  padding: calc(72px + var(--ah-pad)) 0 calc(var(--ah-overlap) + clamp(2.25rem, 1.5rem + 2vw, 3.25rem));
  background: var(--navy-dark) url("/assets/motifs/motif-hero-rings.svg") no-repeat;
  /* Ring centre under the sidebar column */
  background-size: 1400px auto;
  background-position: right calc(max(2rem, (100vw - var(--container-wide)) / 2 + 2rem) + 180px - 700px) bottom calc(var(--ah-overlap) * -1);
  color: #fff;
  overflow: hidden;
}
.ah-text { min-width: 0; }

/* Breadcrumb (slot) on navy */
.ah :global(nav[aria-label="Breadcrumb"]) {
  display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem;
  font-size: 0.85rem; font-weight: 500;
  color: rgba(255, 255, 255, 0.88);
  margin: 0 0 1.5rem;
}
.ah :global(nav[aria-label="Breadcrumb"] a) { color: rgba(255, 255, 255, 0.88); text-decoration: none; }
.ah :global(nav[aria-label="Breadcrumb"] a:hover) { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
.ah :global(nav[aria-label="Breadcrumb"] [class*="sep"]) { color: rgba(255, 255, 255, 0.4); }
.ah :global(nav[aria-label="Breadcrumb"] [class*="current"]) { color: rgba(255, 255, 255, 0.88); }

.ah-pills { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.1rem; }
.ah-pill {
  display: inline-flex; align-items: center;
  padding: 0.38rem 0.8rem;
  border-radius: var(--radius-full, 999px);
  border: 1px solid rgba(255, 154, 77, 0.45);
  background: rgba(255, 154, 77, 0.1);
  color: var(--orange-light);
  font-size: 0.72rem; font-weight: 700;
  letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.2;
}

.ah-title {
  font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.75rem) !important;
  font-weight: 700;
  line-height: 1.15 !important;
  letter-spacing: -0.02em;
  color: #fff;
  /* 18.9em is the old 28ch in Inter bold; em keeps the line breaks when the font swaps */
  max-width: 18.9em;
  text-wrap: balance;
  margin: 0 0 1.1rem;
}
.ah-dek {
  font-size: 1.15rem !important;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.88);
  max-width: 60ch;
  margin: 0;
  /* Long WordPress excerpts stay a short dek; the full text stays in the page */
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ah-meta-row {
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 1rem 2rem;
  margin-top: 1.75rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.14);
}
.ah-byline { display: flex; align-items: center; gap: 0.85rem; }
.ah-meta {
  display: flex; align-items: center; flex-wrap: wrap;
  gap: 0.2rem 0.6rem;
  margin-top: 0.15rem;
  font-size: 0.875rem;
  color: rgba(255, 255, 255, 0.88);
}
.ah-meta :global(a) { color: #fff; font-weight: 600; text-decoration: underline; text-decoration-color: var(--orange-light); text-underline-offset: 3px; }
.ah-meta :global(a:hover) { text-decoration-thickness: 2px; }
.ah-meta :global(svg) { flex-shrink: 0; }
.ah-author { display: block; color: #fff; font-weight: 600; font-size: 0.95rem; line-height: 1.4; }
.ah-avatar {
  flex-shrink: 0;
  display: inline-flex; align-items: center; justify-content: center;
  width: 44px; height: 44px; border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.12);
}
.ah-avatar img { width: 26px; height: 26px; display: block; }

/* Reading progress, just under the fixed site header */
.ah-progress {
  position: fixed; top: 72px; left: 0; right: 0;
  height: 3px; z-index: 999;
  pointer-events: none;
}
.ah-progress-bar {
  display: block; height: 100%;
  background: var(--orange);
  transform: scaleX(0); transform-origin: 0 50%;
}

@media (max-width: 768px) {
  .ah-meta-row { margin-top: 1.4rem; padding-top: 1.25rem; }
  .ah-dek { font-size: 1.02rem !important; }
}
</style>

<style is:global>
/* Shared article layout (blog posts and guides). --ah-overlap is how far the
   feature element and the sidebar reach up into the navy band. */
:root { --ah-overlap: clamp(4.5rem, 2rem + 6vw, 8rem); }
.ah-grid,
.ah-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 360px;
  gap: 4rem;
  align-items: start;
}
.ah-body { padding: 0 0 5rem; }
.ah-feature {
  position: relative; z-index: 1;
  margin: calc(var(--ah-overlap) * -1) 0 2.5rem;
}
.ah-sidebar {
  position: relative;
  z-index: 1;
  margin-top: calc(var(--ah-overlap) * -1);
  align-self: stretch; /* full column height, so the contents card can stay pinned */
}
/* The "On this page" card is last in the sidebar: the other cards scroll
   away normally, then it stays pinned with nothing passing underneath */
.ah-sidebar > .toc--card {
  position: sticky;
  top: calc(72px + 1.5rem);
}
.ah-body h2[id] { scroll-margin-top: calc(72px + 1.5rem); }

@media (max-width: 992px) {
  :root { --ah-overlap: 3rem; }
  .ah-grid, .ah-layout { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
  .ah-sidebar { position: static; margin-top: 0; }
  .ah-feature { margin-bottom: 1.75rem; }
}
@media (max-width: 768px) {
  .ah-body { padding-bottom: 3rem; }
}
</style>
