---
// "On this page" navigation built from the article's h2s (see lib/articleToc).
// variant "card": sidebar card (desktop); "details": collapsible block at the
// top of the article (below 993px). The "heading" slot replaces the plain
// label, for pages that already had a heading on their TOC card.
import type { TocItem } from '../lib/articleToc';
interface Props { items: TocItem[]; variant?: 'card' | 'details'; label?: string; class?: string }
const { items, variant = 'card', label = 'On this page', class: className } = Astro.props;
---
{items.length > 0 && (variant === 'card' ? (
  <nav class:list={['toc toc--card', className]} aria-label={label}>
    {Astro.slots.has('heading') ? <slot name="heading" /> : <p class="toc-label">{label}</p>}
    <ol class="toc-list">
      {items.map(i => <li><a class="toc-link" href={`#${i.id}`} set:html={i.html} /></li>)}
    </ol>
  </nav>
) : (
  <details class:list={['toc toc--details', className]}>
    <summary class="toc-summary">
      <span>{label}</span>
      <svg aria-hidden="true" class="toc-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
    </summary>
    <nav aria-label={label}>
      <ol class="toc-list">
        {items.map(i => <li><a class="toc-link" href={`#${i.id}`} set:html={i.html} /></li>)}
      </ol>
    </nav>
  </details>
))}

<script>
  // Highlight the section being read: the last h2 above ~30% of the viewport
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')];
  const ids = [...new Set(links.map(a => a.hash.slice(1)))];
  const heads = ids.map(id => document.getElementById(id)).filter((h): h is HTMLElement => !!h);
  if (heads.length) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const line = window.innerHeight * 0.3;
      let current = '';
      for (const h of heads) { if (h.getBoundingClientRect().top <= line) current = h.id; else break; }
      links.forEach(a => {
        const on = a.hash.slice(1) === current;
        a.classList.toggle('is-active', on);
        if (on) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');
      });
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
    // Close the mobile TOC after picking a section
    document.querySelectorAll<HTMLDetailsElement>('.toc--details').forEach(d =>
      d.addEventListener('click', e => { if ((e.target as HTMLElement).closest('.toc-link')) d.open = false; }));
  }
</script>

<style>
/* The label looks like the sidebar card titles (h3) next to it */
.toc-label {
  font-family: var(--font-heading);
  font-size: var(--h3-size) !important; font-weight: 700;
  letter-spacing: -0.015em; line-height: 1.15;
  color: var(--navy);
}
.toc-label, .toc :global(h3) { margin: 0 0 0.9rem; }
.toc-list { list-style: none; margin: 0; padding: 0; }
.toc-link {
  display: block;
  padding: 0.42rem 0 0.42rem 0.9rem;
  margin-left: -1px;
  font-size: 0.87rem; font-weight: 500; line-height: 1.45;
  color: var(--gray-600);
  text-decoration: none;
  border-left: 2px solid rgba(15, 37, 72, 0.1);
  transition: color 0.15s ease, border-color 0.15s ease;
}
.toc-link:hover { color: var(--navy); border-left-color: rgba(15, 37, 72, 0.35); }
.toc-link.is-active { color: var(--navy); font-weight: 600; border-left-color: var(--orange-ink); }

.toc--card {
  background: #fff;
  border: 1px solid rgba(15, 37, 72, 0.1);
  border-radius: 12px;
  padding: 1.5rem;
  box-shadow: 0 1px 2px rgba(15, 37, 72, 0.04), 0 12px 32px rgba(15, 37, 72, 0.08);
}

.toc--details {
  display: none;
  border: 1px solid rgba(15, 37, 72, 0.12);
  border-radius: 12px;
  background: #fff;
  margin: 0 0 1.75rem;
}
.toc-summary {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.95rem 1rem;
  font-size: 0.8rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.12em;
  color: var(--navy);
  cursor: pointer; list-style: none;
}
.toc-summary::-webkit-details-marker { display: none; }
.toc-chevron { transition: transform 0.2s ease; color: var(--gray-500); }
.toc--details[open] .toc-chevron { transform: rotate(180deg); }
.toc--details .toc-list { padding: 0 1rem 1rem; }

@media (max-width: 992px) {
  .toc--card { display: none; }
  .toc--details { display: block; }
}
@media (prefers-reduced-motion: reduce) { .toc-link, .toc-chevron { transition: none; } }
</style>
