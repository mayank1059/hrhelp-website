---
// ChatAssistant.astro — first-party lead chatbot (a guided questionnaire, not AI).
// Job seekers are pointed to Quality Immigration; employers and HR people answer a
// few questions and the lead goes through /api/contact (the HRhelp CRM), exactly
// like the contact form. No cookies and no third-party requests, so no consent gate.
import { getImage } from 'astro:assets';
import portrait from '../../public/images/founder/cornelis-portrait.jpg';
import { HELP_NEEDED, EMPLOYEES_NL, TIMELINE, QUALITY_IMMIGRATION } from '../lib/enquiry';
const QI_URL = QUALITY_IMMIGRATION('chatbot');
// Lead and Ads conversion events only count on the production build.
const IS_PROD = import.meta.env.PUBLIC_STAGING !== 'true';
// A small copy of the founder portrait for the round avatars (the original is 600 KB).
const AVATAR = (await getImage({ src: portrait, width: 200, format: 'webp' })).src;
---

<div id="hc" class="hc">
  <div id="hc-teaser" class="hc-teaser" hidden>
    <span class="hc-av hc-av-md" aria-hidden="true"><img src={AVATAR} alt="" width="200" height="268" loading="lazy" decoding="async" /></span>
    <button type="button" class="hc-teaser-text" id="hc-teaser-open"><strong>Hiring in the Netherlands?</strong> I can help you find the right HR support.</button>
    <button type="button" class="hc-teaser-close" id="hc-teaser-close" aria-label="Dismiss message">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>

  <div id="hc-panel" class="hc-panel" role="dialog" aria-modal="false" aria-labelledby="hc-title" tabindex="-1" hidden>
    <div class="hc-head">
      <span class="hc-av-wrap" aria-hidden="true"><span class="hc-av hc-av-lg"><img src={AVATAR} alt="" width="200" height="268" loading="lazy" decoding="async" /></span><span class="hc-online"></span></span>
      <div class="hc-head-text">
        <p id="hc-title" class="hc-title">HRhelp assistant</p>
        <p class="hc-sub">Cornelis and the team reply within 1 business day</p>
      </div>
      <button type="button" class="hc-close" id="hc-close" aria-label="Close chat">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div class="hc-progress" id="hc-progress" role="progressbar" aria-label="Questions answered" aria-valuemin="0" aria-valuemax="10" aria-valuenow="0" hidden><span class="hc-progress-fill" id="hc-progress-fill"></span></div>
    <div class="hc-body" id="hc-body">
      <div class="hc-log" id="hc-log" role="log" aria-live="polite"></div>
      <div class="hc-line hc-bot hc-typing" id="hc-typing" aria-hidden="true" hidden>
        <span class="hc-av hc-av-sm"><img src={AVATAR} alt="" width="200" height="268" loading="lazy" decoding="async" /></span>
        <div class="hc-msg"><span class="hc-dot"></span><span class="hc-dot"></span><span class="hc-dot"></span></div>
      </div>
      <div class="hc-controls" id="hc-controls"></div>
    </div>
    <div class="hc-dock" id="hc-dock" hidden></div>
    <!-- Honeypot: off-screen and out of the tab order, so only bots fill it.
         A non-empty url_confirm makes /api/contact drop the submission. -->
    <div aria-hidden="true" class="hc-hp">
      <label for="hc-url-confirm">Your website</label>
      <input type="text" id="hc-url-confirm" name="url_confirm" tabindex="-1" autocomplete="off" />
    </div>
  </div>

  <button type="button" id="hc-launcher" class="hc-launcher" aria-label="Open chat with the HRhelp assistant" aria-expanded="false" aria-controls="hc-panel">
    <svg class="hc-ico-chat" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.2 3.6c-.5.4-1.3.1-1.3-.6V16A2.5 2.5 0 0 1 4 13.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 8.5h8M8 11.5h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    <svg class="hc-ico-close" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  </button>
</div>

<script is:inline define:vars={{ NEEDS: HELP_NEEDED, SIZES: EMPLOYEES_NL, TIMING: TIMELINE, QI_URL, IS_PROD, AVATAR }}>
(function () {
  var root = document.getElementById('hc');
  if (!root) return;
  var panel = document.getElementById('hc-panel');
  var launcher = document.getElementById('hc-launcher');
  var log = document.getElementById('hc-log');
  var controls = document.getElementById('hc-controls');
  var dock = document.getElementById('hc-dock');
  var body = document.getElementById('hc-body');
  var teaser = document.getElementById('hc-teaser');
  var typing = document.getElementById('hc-typing');
  var progress = document.getElementById('hc-progress');
  var progressFill = document.getElementById('hc-progress-fill');

  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  var PATHS = [
    { id: 'employer', label: "I'm an employer with staff in the Netherlands (or planning to hire)" },
    { id: 'hr', label: 'I work in HR and need support' },
    { id: 'jobseeker', label: "I'm looking for a job or a work visa" },
  ];
  var STEPS = 10; // path, needs, size, timing, company, name, email, phone, notes, consent
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var ICON_SEND = '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  var ICON_OK = '<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  var ICON_OUT = '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M14 5h5v5M19 5l-8 8M17 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  var ICON_CAL = '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="4" y="5.5" width="16" height="14.5" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';

  var a = {}; // answers
  var started = false, opened = false, isOpen = false, done = false, uid = 0, seq = 0;

  function track(name, params) {
    if (typeof window.gtag === 'function') window.gtag('event', name, params || {});
  }
  function ss(get, key, val) {
    try { return get ? sessionStorage.getItem(key) : sessionStorage.setItem(key, val); } catch (e) { return null; }
  }
  function el(tag, cls, text) {
    var n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  }
  function avatar() {
    var s = el('span', 'hc-av hc-av-sm');
    var img = el('img');
    img.src = AVATAR;
    img.alt = '';
    s.appendChild(img);
    return s;
  }
  function scrollDown(instant) {
    if (body.scrollTo) body.scrollTo({ top: body.scrollHeight, behavior: instant || reduce ? 'auto' : 'smooth' });
    else body.scrollTop = body.scrollHeight;
  }
  // Bot lines that follow a bot line join its group: no avatar, tighter spacing.
  function lastIsBot() {
    var last = log.lastElementChild;
    return !!last && last.classList.contains('hc-bot');
  }
  function say(text, who) {
    who = who || 'bot';
    var line = el('div', 'hc-line hc-' + who);
    var m = el('div', 'hc-msg');
    if (typeof text === 'string') m.textContent = text; else m.appendChild(text);
    if (who === 'bot') {
      if (lastIsBot()) line.classList.add('hc-cont');
      else line.appendChild(avatar());
    }
    line.appendChild(m);
    log.appendChild(line);
    scrollDown();
    return m;
  }
  function setProgress(n) {
    progress.hidden = n == null;
    if (n == null) return;
    progress.setAttribute('aria-valuenow', String(n));
    progressFill.style.width = (n / STEPS * 100) + '%';
  }
  function focusFirst() {
    var sel = 'input:not([type=hidden]), textarea, button, a';
    var f = controls.querySelector(sel) || (!dock.hidden && dock.querySelector(sel));
    // preventScroll: the log is already scrolling smoothly to the newest message
    (f || document.getElementById('hc-close')).focus({ preventScroll: true });
  }
  // Show the next question after a short "typing" pause. `answered` feeds the
  // progress bar; `dock` puts the controls in the composer bar at the bottom.
  function step(question, build, opts) {
    opts = opts || {};
    var my = ++seq;
    var hadFocus = panel.contains(document.activeElement);
    controls.innerHTML = '';
    dock.innerHTML = '';
    dock.hidden = true;
    if ('answered' in opts) setProgress(opts.answered);
    // The answered control is gone; keep focus inside the dialog meanwhile.
    if (isOpen && (hadFocus || document.activeElement === document.body) && !panel.contains(document.activeElement)) panel.focus({ preventScroll: true });
    function render() {
      if (my !== seq) return;
      typing.hidden = true;
      if (question) {
        var q = question;
        if (opts.ok) {
          q = el('span', 'hc-ok-line');
          var ic = el('span', 'hc-ok');
          ic.innerHTML = ICON_OK;
          q.appendChild(ic);
          q.appendChild(el('span', null, question));
        }
        say(q);
      }
      var target = opts.dock ? dock : controls;
      build(target);
      if (opts.dock) dock.hidden = false;
      scrollDown();
      if (opened && isOpen) focusFirst();
    }
    if (!question || opts.instant || reduce) { render(); return; }
    typing.classList.toggle('hc-cont', lastIsBot());
    typing.hidden = false;
    scrollDown();
    setTimeout(render, 650);
  }
  function optionButtons(list, onPick) {
    return function (c) {
      var wrap = el('div', 'hc-opts');
      list.forEach(function (o, i) {
        var label = typeof o === 'string' ? o : o.label;
        var b = el('button', 'hc-opt', label);
        b.type = 'button';
        b.style.setProperty('--i', i);
        b.addEventListener('click', function () { say(label, 'user'); onPick(o); });
        wrap.appendChild(b);
      });
      c.appendChild(wrap);
    };
  }
  function sendButton(label, iconOnly) {
    var b = el('button', 'hc-send' + (iconOnly ? ' hc-send-round' : ''));
    b.type = 'submit';
    if (iconOnly) { b.innerHTML = ICON_SEND; b.setAttribute('aria-label', label); }
    else b.textContent = label;
    return b;
  }
  // A one-field composer: text, email or textarea. Optional fields get a Skip button.
  function textStep(question, opts, answered, onDone) {
    step(question, function (c) {
      var f = el('form', 'hc-form');
      f.noValidate = true;
      var id = 'hc-f' + (++uid);
      var input = el(opts.multiline ? 'textarea' : 'input', 'hc-input');
      input.id = id;
      if (!opts.multiline) input.type = opts.type || 'text';
      else input.rows = 1;
      if (opts.autocomplete) input.autocomplete = opts.autocomplete;
      if (opts.placeholder) input.placeholder = opts.placeholder;
      input.setAttribute('aria-label', question);
      input.maxLength = opts.max || 160;
      var err = el('p', 'hc-err');
      err.id = id + '-err';
      err.hidden = true;
      var row = el('div', 'hc-composer');
      row.appendChild(input);
      if (opts.optional) {
        var skip = el('button', 'hc-skip', 'Skip');
        skip.type = 'button';
        skip.addEventListener('click', function () { say('Skipped', 'user'); onDone(''); });
        row.appendChild(skip);
      }
      row.appendChild(sendButton('Send', true));
      f.appendChild(err);
      f.appendChild(row);
      function clearErr() {
        if (err.hidden) return;
        err.hidden = true;
        input.removeAttribute('aria-invalid');
      }
      input.addEventListener('input', function () {
        clearErr();
        if (opts.multiline) { input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 132) + 'px'; }
      });
      // Enter sends, like any chat; Shift+Enter adds a line in the notes box.
      if (opts.multiline) input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); f.requestSubmit ? f.requestSubmit() : f.dispatchEvent(new Event('submit', { cancelable: true })); }
      });
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        var v = input.value.trim();
        var problem = '';
        if (!v && !opts.optional) problem = opts.required || 'Please fill this in.';
        else if (v && opts.validate && !opts.validate(v)) problem = opts.invalid;
        if (problem) {
          err.textContent = problem;
          err.hidden = false;
          input.setAttribute('aria-invalid', 'true');
          input.setAttribute('aria-describedby', err.id);
          input.focus();
          return;
        }
        if (!v) { say('Skipped', 'user'); onDone(''); return; }
        say(v, 'user');
        onDone(v);
      });
      c.appendChild(f);
    }, { dock: true, answered: answered });
  }

  function start() {
    a = {};
    step("Hi, I'm the HRhelp assistant. What brings you here today?", optionButtons(PATHS, function (p) {
      track('chatbot_path', { path: p.id });
      a.path = p;
      if (p.id === 'jobseeker') jobseeker(); else needs();
    }), { answered: 0, instant: !log.childElementCount });
  }

  function jobseeker() {
    step("HRhelp works with employers, so we can't help with job applications or visas. Our partner Quality Immigration helps individuals with work permits and relocation.", function (c) {
      var card = el('div', 'hc-card');
      var link = el('a', 'hc-cta hc-cta-primary', 'Go to Quality Immigration');
      link.insertAdjacentHTML('beforeend', ICON_OUT);
      link.appendChild(el('span', 'hc-sr', ' (opens in a new tab)'));
      link.href = QI_URL;
      link.target = '_blank';
      link.rel = 'noopener';
      link.addEventListener('click', function () { track('referral_quality_immigration', { source: 'chatbot' }); });
      card.appendChild(link);
      var wrap = el('div', 'hc-opts');
      var back = el('button', 'hc-opt', 'Back, I clicked the wrong option');
      back.type = 'button';
      back.addEventListener('click', function () { say('Back', 'user'); start(); });
      wrap.appendChild(back);
      c.appendChild(card);
      c.appendChild(wrap);
    }, { answered: null });
  }

  function needs() {
    step('What do you need help with? Pick one or more.', function (c) {
      var chosen = [];
      var wrap = el('div', 'hc-opts');
      var go = el('button', 'hc-send', 'Continue');
      go.type = 'button';
      go.disabled = true;
      NEEDS.forEach(function (n, i) {
        var b = el('button', 'hc-opt hc-check', n);
        b.type = 'button';
        b.style.setProperty('--i', i);
        b.setAttribute('aria-pressed', 'false');
        b.addEventListener('click', function () {
          var i = chosen.indexOf(n);
          if (i === -1) chosen.push(n); else chosen.splice(i, 1);
          b.setAttribute('aria-pressed', String(i === -1));
          go.disabled = !chosen.length;
        });
        wrap.appendChild(b);
      });
      go.addEventListener('click', function () {
        a.needs = NEEDS.filter(function (n) { return chosen.indexOf(n) !== -1; });
        say(a.needs.join(', '), 'user');
        size();
      });
      var row = el('div', 'hc-row');
      row.appendChild(go);
      c.appendChild(wrap);
      c.appendChild(row);
    }, { answered: 1 });
  }

  function size() {
    step('How many employees do you have in the Netherlands?', optionButtons(SIZES, function (s) { a.size = s; timing(); }), { answered: 2 });
  }
  function timing() {
    step('When do you need help?', optionButtons(TIMING, function (t) { a.timing = t; company(); }), { answered: 3 });
  }
  function company() {
    textStep("What's your company called?", { autocomplete: 'organization', placeholder: 'Company name', required: 'Please enter your company name.' }, 4, function (v) { a.company = v; name(); });
  }
  function name() {
    textStep("And your name?", { autocomplete: 'name', placeholder: 'Your name', required: 'Please enter your name.' }, 5, function (v) { a.name = v; email(); });
  }
  function email() {
    textStep("What's your work email?", { type: 'email', autocomplete: 'email', placeholder: 'you@company.com', max: 200, required: 'Please enter your email address.', validate: function (v) { return EMAIL_RE.test(v); }, invalid: 'That email address looks incomplete. Please check it.' }, 6, function (v) { a.email = v; phone(); });
  }
  function phone() {
    textStep('A phone number, in case a call is easier? (optional)', { type: 'tel', autocomplete: 'tel', placeholder: '+31 6 1234 5678', max: 40, optional: true }, 7, function (v) { a.phone = v; notes(); });
  }
  function notes() {
    textStep('Anything else we should know? (optional)', { multiline: true, placeholder: 'A short description of your situation', max: 2000, optional: true }, 8, function (v) { a.notes = v; consent(); });
  }

  function consent() {
    step('Last step: please confirm and send.', function (c) {
      var f = el('form', 'hc-form');
      f.noValidate = true;
      var lab = el('label', 'hc-consent');
      var box = el('input');
      box.type = 'checkbox';
      box.id = 'hc-privacy';
      lab.htmlFor = 'hc-privacy';
      lab.appendChild(box);
      var span = el('span', null, 'I agree to the ');
      var pl = el('a', null, 'Privacy Policy');
      pl.href = '/privacy/';
      pl.target = '_blank';
      pl.rel = 'noopener';
      span.appendChild(pl);
      lab.appendChild(span);
      var err = el('p', 'hc-err', 'Please tick the box to agree to the Privacy Policy.');
      err.id = 'hc-privacy-err';
      err.hidden = true;
      var row = el('div', 'hc-composer hc-composer-consent');
      var send = sendButton('Send');
      row.appendChild(lab);
      row.appendChild(send);
      box.addEventListener('change', function () { if (box.checked) err.hidden = true; });
      f.appendChild(err);
      f.appendChild(row);
      f.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!box.checked) {
          err.hidden = false;
          box.setAttribute('aria-describedby', err.id);
          box.focus();
          return;
        }
        submit(send);
      });
      c.appendChild(f);
    }, { dock: true, answered: 9 });
  }

  // Same fields as the contact form; /api/contact turns them into the same CRM
  // lead and team alert, so both channels land identically.
  function submit(btn) {
    btn.disabled = true;
    btn.textContent = 'Sending...';
    var submitId = 'cb-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
    var data = {
      name: a.name,
      email: a.email,
      company: a.company,
      phone: a.phone || '',
      who: a.path.label,
      needs: a.needs,
      employees: a.size,
      timeline: a.timing,
      message: a.notes || '',
      page: location.pathname,
      source: 'Website chatbot',
      url_confirm: document.getElementById('hc-url-confirm').value,
    };
    // First-touch lead source (utm_*, click ids, referrer host, landing page)
    if (window.hrhelpAttribution) Object.assign(data, window.hrhelpAttribution());
    fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    })
      .then(function (res) { return res.json().catch(function () { return {}; }); })
      .then(function (r) { if (r && r.success) success(submitId); else failure(btn); })
      .catch(function () { failure(btn); });
  }

  function success(submitId) {
    done = true;
    // Staging builds never count leads or Google Ads conversions. The Ads
    // conversion is the one Calendly bookings used to fire; transaction_id
    // lets Google Ads drop a duplicate of the same submit.
    if (IS_PROD) {
      track('generate_lead', { source: 'chatbot' });
      track('conversion', { send_to: 'AW-16843385395/u4MnCPi347gcELPUxt8-', transaction_id: submitId });
    }
    var first = a.name.split(/\s+/)[0];
    step('Thanks, ' + first + '. Cornelis or one of the team will get back to you within one business day.', function (c) {
      var card = el('div', 'hc-card');
      var top = el('p', 'hc-card-text');
      var ic = el('span', 'hc-card-ico');
      ic.innerHTML = ICON_CAL;
      top.appendChild(ic);
      top.appendChild(el('span', null, 'Prefer to talk sooner?'));
      var link = el('a', 'hc-cta hc-cta-secondary', 'Book a free 30-minute consultation');
      link.href = '/contact/?book=calendar';
      card.appendChild(top);
      card.appendChild(link);
      c.appendChild(card);
    }, { ok: true, answered: STEPS });
  }

  function failure(btn) {
    track('lead_error', { source: 'chatbot' });
    var p = el('span');
    p.appendChild(document.createTextNode("Sorry, your answers didn't come through. Please try again, or email us at "));
    var m = el('a', null, 'info@hrhelp.nl');
    m.href = 'mailto:info@hrhelp.nl';
    p.appendChild(m);
    p.appendChild(document.createTextNode('.'));
    say(p);
    btn.disabled = false;
    btn.textContent = 'Try again';
    btn.focus();
  }

  // ----- open / close (scale and fade from the launcher corner) -----
  var hideTimer = 0;
  function open() {
    hideTeaser();
    ss(false, 'hc_teaser', '1');
    clearTimeout(hideTimer);
    isOpen = true;
    panel.hidden = false;
    void panel.offsetWidth; // start the transition from the closed state
    panel.classList.add('hc-show');
    root.classList.add('hc-is-open');
    launcher.setAttribute('aria-expanded', 'true');
    launcher.setAttribute('aria-label', 'Close chat');
    if (!opened) { opened = true; track('chatbot_open'); }
    if (!started) { started = true; start(); }
    scrollDown(true);
    focusFirst();
  }
  function close() {
    isOpen = false;
    panel.classList.remove('hc-show');
    hideTimer = setTimeout(function () { if (!isOpen) panel.hidden = true; }, reduce ? 0 : 200);
    root.classList.remove('hc-is-open');
    launcher.setAttribute('aria-expanded', 'false');
    launcher.setAttribute('aria-label', 'Open chat with the HRhelp assistant');
    launcher.focus();
  }
  launcher.addEventListener('click', function () { if (!isOpen) open(); else close(); });
  document.getElementById('hc-close').addEventListener('click', close);
  panel.addEventListener('keydown', function (e) { if (e.key === 'Escape') { e.stopPropagation(); close(); } });

  // Phones: size the sheet to the visible area, so the composer stays above the keyboard.
  var vv = window.visualViewport;
  if (vv) {
    var fit = function () {
      root.style.setProperty('--hc-vvh', vv.height + 'px');
      root.style.setProperty('--hc-vvt', vv.offsetTop + 'px');
    };
    vv.addEventListener('resize', fit);
    vv.addEventListener('scroll', fit);
    fit();
  }

  // ----- teaser: at most once per session, only after real engagement -----
  // 20 s on the page and 40% scrolled, or from the second page view on. Never while the
  // cookie banner is up or within 10 s of it being answered, and never while the footer
  // (legal links, "Cookie settings") is in view.
  var t0 = Date.now(), depth = 0, bannerUp = false, footerIn = false, answeredAt = 0, poll = 0;
  var views = (parseInt(ss(true, 'hc_views'), 10) || 0) + 1;
  ss(false, 'hc_views', String(views));
