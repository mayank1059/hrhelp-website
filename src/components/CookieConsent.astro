---
// CookieConsent.astro — GDPR cookie consent banner for Dutch/EU compliance
// Records the visitor's cookie choices (functional, analytics, marketing) and passes them to
// Google Consent Mode v2. Reopened via window.hrhelpCookieSettings() / [data-cookie-settings].
---

<!-- Cookie Consent Banner -->
<div id="cookie-consent" class="cc-banner" role="dialog" aria-label="Cookie consent" aria-modal="false">
  <div class="cc-inner">
    <div class="cc-text">
      <h2 class="as-h3"><span aria-hidden="true">🍪</span> We value your privacy</h2>
      <!-- Phones get the short copy, so the banner leaves the page itself in view -->
      <p class="cc-copy-long">We use cookies to enhance your experience. Essential cookies are always active. With your consent we also use analytics (Google Analytics) and marketing (Google Ads) cookies. You can change your choice at any time via "Cookie settings" at the bottom of every page.</p>
      <p class="cc-copy-short">We use cookies for analytics and ads, only with your consent.</p>
      <a href="/privacy/" class="cc-link">Privacy Policy</a>
    </div>
    <div class="cc-actions">
      <button id="cc-accept" class="cc-btn cc-btn-accept">Accept All</button>
      <button id="cc-essential" class="cc-btn cc-btn-essential">Essential Only</button>
      <button id="cc-manage" class="cc-btn cc-btn-manage" aria-expanded="false" aria-controls="cc-prefs">Manage</button>
    </div>
  </div>

  <!-- Preferences Panel (hidden by default) -->
  <div id="cc-prefs" class="cc-prefs" hidden>
    <div class="cc-pref-row">
      <div>
        <strong>Essential Cookies</strong>
        <span class="cc-pref-desc">Required for the website to function. Cannot be disabled.</span>
      </div>
      <label class="cc-toggle cc-toggle-locked">
        <input type="checkbox" checked disabled aria-label="Essential cookies (always on)" />
        <span class="cc-slider"></span>
      </label>
    </div>
    <div class="cc-pref-row">
      <div>
        <strong>Functional Cookies</strong>
        <span class="cc-pref-desc" id="cc-func-desc">Remembers some of your preferences; no third-party tracking.</span>
      </div>
      <label class="cc-toggle">
        <input type="checkbox" role="switch" id="cc-func-toggle" aria-label="Functional cookies" aria-describedby="cc-func-desc" />
        <span class="cc-slider"></span>
      </label>
    </div>
    <div class="cc-pref-row">
      <div>
        <strong>Analytics Cookies</strong>
        <span class="cc-pref-desc" id="cc-analytics-desc">Google Analytics: shows us how visitors use the site (cookies such as _ga).</span>
      </div>
      <label class="cc-toggle">
        <input type="checkbox" role="switch" id="cc-analytics-toggle" aria-label="Analytics cookies" aria-describedby="cc-analytics-desc" />
        <span class="cc-slider"></span>
      </label>
    </div>
    <div class="cc-pref-row">
      <div>
        <strong>Marketing Cookies</strong>
        <span class="cc-pref-desc" id="cc-marketing-desc">Google Ads: measures the results of our ads (cookies such as _gcl_au) and remembers for up to 90 days how you first found us, including ad click IDs.</span>
      </div>
      <label class="cc-toggle">
        <input type="checkbox" role="switch" id="cc-marketing-toggle" aria-label="Marketing cookies" aria-describedby="cc-marketing-desc" />
        <span class="cc-slider"></span>
      </label>
    </div>
    <div class="cc-pref-actions">
      <button id="cc-save" class="cc-btn cc-btn-accept">Save Preferences</button>
    </div>
  </div>
</div>

<script>
  (function() {
    // Stored as {v: 2, essential, functional, analytics, marketing, timestamp}. Reading (including the
    // old v1 shape and the 12-month expiry) and the Consent Mode update live in Layout.astro's head.
    const COOKIE_KEY = 'hrhelp_cookie_consent';
    const VERSION = 2;
    const banner = document.getElementById('cookie-consent');
    const prefs = document.getElementById('cc-prefs');
    const manageBtn = document.getElementById('cc-manage');
    const toggles = {
      functional: document.getElementById('cc-func-toggle'),
      analytics: document.getElementById('cc-analytics-toggle'),
      marketing: document.getElementById('cc-marketing-toggle'),
    };
    let hideTimer = 0;
    let returnFocus = null;

    function readConsent() {
      return window.hrhelpReadConsent ? window.hrhelpReadConsent() : null;
    }

    // Reserve the banner's height at the bottom so keyboard focus is never hidden behind it.
    function reserveSpace() {
      document.documentElement.style.scrollPaddingBottom = banner.offsetHeight + 'px';
    }

    function setManage(open) {
      prefs.hidden = !open;
      manageBtn.setAttribute('aria-expanded', String(open));
      // The Save bar takes over the bottom padding (it sticks to the sheet's bottom edge)
      banner.classList.toggle('cc-managing', open);
      reserveSpace();
    }

    // Categories that are off: expire the Google cookies already set. gtag puts them on the
    // parent domain (.hrhelp.nl), so try host-only, this host and the last two labels.
    function dropCookies(c) {
      const host = location.hostname;
      const domains = ['', host, host.split('.').slice(-2).join('.')];
      document.cookie.split(';').forEach(function(pair) {
        const name = pair.split('=')[0].trim();
        const drop = (!c.analytics && /^_ga(_|$)/.test(name)) || (!c.marketing && /^_gcl_/.test(name));
        if (!drop) return;
        domains.forEach(function(d) {
          document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + (d ? '; domain=' + d : '');
        });
      });
    }

    function showBanner(manage) {
      clearTimeout(hideTimer);
      // Pre-fill the toggles from the stored choice (all off when there is none).
      const saved = readConsent();
      Object.keys(toggles).forEach(function(k) { toggles[k].checked = !!(saved && saved[k]); });
      banner.style.display = 'block';
      banner.style.opacity = '';
      banner.style.transform = '';
      setManage(!!manage);
      window.addEventListener('resize', reserveSpace);
    }

    function hideBanner() {
      window.removeEventListener('resize', reserveSpace);
      document.documentElement.style.scrollPaddingBottom = '';
      banner.style.opacity = '0';
      banner.style.transform = 'translateY(100%)';
      hideTimer = setTimeout(function() { banner.style.display = 'none'; }, 400);
      if (returnFocus && document.contains(returnFocus)) returnFocus.focus();
      returnFocus = null;
    }

    function saveConsent(choice) {
      const consent = {
        v: VERSION,
        essential: true,
        functional: !!choice.functional,
        analytics: !!choice.analytics,
        marketing: !!choice.marketing,
        timestamp: new Date().toISOString(),
      };
      try { localStorage.setItem(COOKIE_KEY, JSON.stringify(consent)); } catch (e) {}
      // Tell the Google tags straight away, no reload needed.
      if (window.hrhelpApplyConsent) window.hrhelpApplyConsent(consent);
      // Without marketing consent, drop the 90-day lead-source copy (see LeadAttribution.astro).
      if (!consent.marketing) { try { localStorage.removeItem('hrhelp_attr'); } catch (e) {} }
      // A withdrawal also removes the cookies set while it was on.
      dropCookies(consent);
      hideBanner();
    }

    document.getElementById('cc-accept').addEventListener('click', function() {
      saveConsent({ functional: true, analytics: true, marketing: true });
    });

    document.getElementById('cc-essential').addEventListener('click', function() {
      saveConsent({ functional: false, analytics: false, marketing: false });
    });

    manageBtn.addEventListener('click', function() {
      setManage(prefs.hidden);
    });

    document.getElementById('cc-save').addEventListener('click', function() {
      saveConsent({
        functional: toggles.functional.checked,
        analytics: toggles.analytics.checked,
        marketing: toggles.marketing.checked,
      });
    });

    // Reopen in Manage mode with the current choices, e.g. from the footer's "Cookie settings" button.
    window.hrhelpCookieSettings = function() {
      returnFocus = document.activeElement;
      showBanner(true);
      toggles.functional.focus();
    };
    document.querySelectorAll('[data-cookie-settings]').forEach(function(el) {
      el.addEventListener('click', function(e) {
        e.preventDefault();
        window.hrhelpCookieSettings();
      });
    });

    // Show the banner unless there is a current choice (no focus change: it must not steal focus on page load).
    const saved = readConsent();
    if (saved && saved.current) {
      banner.style.display = 'none';
      // Also catches cookies written again by a tab that still had consent when it was withdrawn.
      dropCookies(saved);
    } else {
      showBanner(false);
    }
  })();
</script>

<style>
  .cc-banner {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 10000;
    background: rgba(10, 26, 50, 0.97);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.5rem;
    transition: opacity 0.4s ease, transform 0.4s ease;
    box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.3);
    max-height: 100vh;
    max-height: 100dvh;
    overflow-y: auto;
  }

  .cc-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .cc-text {
    flex: 1;
  }

  .cc-text h2 {
    font-size: 1.1rem;
    font-weight: 700;
    color: white;
    margin: 0 0 0.5rem;
  }

  .cc-text p {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.5;
    margin: 0 0 0.5rem;
  }

  .cc-copy-short {
    display: none;
  }

  .cc-link {
    font-size: 0.8rem;
    color: var(--orange-light);
    text-decoration: underline;
    text-decoration-color: var(--orange-light);
    font-weight: 600;
  }

  .cc-actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .cc-btn {
    border: none;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .cc-btn-accept {
    background: var(--orange-ink);
    color: white;
  }

  .cc-btn-accept:hover {
    background: var(--orange-ink-dark);
    transform: translateY(-1px);
  }

  .cc-btn-essential {
    background: rgba(255, 255, 255, 0.12);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .cc-btn-essential:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  .cc-btn-manage {
    background: transparent;
    color: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .cc-btn-manage:hover {
    color: white;
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* Preferences Panel */
  .cc-prefs {
    max-width: 1200px;
    margin: 1rem auto 0;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cc-pref-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .cc-pref-row strong {
    display: block;
    color: white;
    font-size: 0.88rem;
    margin-bottom: 0.15rem;
  }

  .cc-pref-desc {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5);
  }

  /* Save stays in view: when the sheet is taller than the screen, the rows scroll under this bar */
  .cc-pref-actions {
    position: sticky;
    bottom: 0;
    padding: 0.75rem 0 1.5rem;
    text-align: right;
    background: rgb(10, 26, 50);
  }

  .cc-banner.cc-managing {
    padding-bottom: 0;
  }

  /* Toggle Switch */
  .cc-toggle {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
    flex-shrink: 0;
    margin-left: 1rem;
  }

  .cc-toggle input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .cc-slider {
    position: absolute;
    cursor: pointer;
    inset: 0;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    transition: 0.3s;
  }

  .cc-slider::before {
    content: '';
    position: absolute;
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background: white;
    border-radius: 50%;
    transition: 0.3s;
  }

  .cc-toggle input:checked + .cc-slider {
    background: var(--orange);
  }

  /* The real checkbox is visually hidden: show its focus ring on the slider */
  .cc-toggle input:focus-visible + .cc-slider {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }

  .cc-toggle input:checked + .cc-slider::before {
    transform: translateX(20px);
  }

  .cc-toggle-locked {
    opacity: 0.6;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .cc-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    /* Accept and Essential side by side with equal weight; Manage as a text link under them */
    .cc-actions {
      flex-wrap: wrap;
      gap: 0.25rem 0.5rem;
    }

    .cc-btn {
      width: 100%;
      text-align: center;
    }

    .cc-actions .cc-btn-accept,
    .cc-actions .cc-btn-essential {
      flex: 1 1 calc(50% - 0.25rem);
      min-height: 44px;
    }

    .cc-actions .cc-btn-manage {
      width: auto;
      min-height: 44px;
      margin: 0 auto;
      padding: 0 0.75rem;
      border: 0;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  @media (max-width: 600px) {
    .cc-banner {
      padding: 1rem;
    }

    .cc-text h2 {
      margin-bottom: 0.25rem;
    }

    .cc-copy-long {
      display: none;
    }

    /* The Privacy Policy link runs on straight after the short copy, on the same tight lines */
    .cc-text {
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .cc-copy-short {
      display: inline;
    }

    .cc-pref-actions {
      padding-bottom: 1rem;
    }
  }
</style>
