---
// "Core expertise" cards linking a solution, service, guide or blog page to the
// matching expertise pages (topic map in data/expertiseLinks.js). The label is
// a <p>, not a heading, so the host page's heading outline stays the same.
// No outer margin: the host page places and spaces it.
import { coreExpertise } from '../data/expertiseLinks.js';
interface Props { slugs: string[] }
const { slugs } = Astro.props;
const items = slugs
  .filter((slug) => slug in coreExpertise)
  .map((slug) => ({ slug, ...coreExpertise[slug as keyof typeof coreExpertise] }));
---
{items.length > 0 && (
  <div class="cx">
    <p class="eyebrow cx-label">Core expertise</p>
    <div class="cx-list">
      {items.map((e) => (
        <a href={`/expertise/${e.slug}/`} class="cx-card">
          <span class="cx-title">{e.title}</span>
          <span class="cx-line">{e.line}</span>
          <svg aria-hidden="true" class="cx-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      ))}
    </div>
  </div>
)}

<style>
/* Same card as the service links (ServiceLinks "cards"): hairline, 10px, name + one line */
.cx-label {
  display: block;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  line-height: 1.4;
  color: #44546d;
  margin: 0 0 0.75rem;
}
.cx-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 0.85rem;
}
.cx-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 1rem 2.6rem 1.05rem 1.15rem;
  background: var(--white);
  border: 1px solid rgba(15, 37, 72, 0.1);
  border-radius: 10px;
  text-decoration: none;
  transition: border-color 0.2s ease;
}
.cx-card:hover { border-color: rgba(15, 37, 72, 0.28); }
.cx-card:focus-visible { outline: 2px solid var(--orange-ink); outline-offset: 2px; }
.cx-title { font-size: 0.98rem; font-weight: 700; line-height: 1.3; color: var(--navy); }
.cx-card:hover .cx-title { text-decoration: underline; text-decoration-color: var(--orange-ink); text-underline-offset: 3px; }
.cx-line { font-size: 0.88rem; line-height: 1.5; color: var(--gray-600); }
.cx-arrow {
  position: absolute;
  top: 1.15rem;
  right: 1rem;
  color: var(--gray-400);
  transition: color 0.2s ease, transform 0.2s ease;
}
.cx-card:hover .cx-arrow { color: var(--navy); transform: translateX(3px); }
@media (max-width: 768px) {
  .cx-list { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
  .cx-card { padding-left: 1rem; }
}
@media (prefers-reduced-motion: reduce) { .cx-card, .cx-arrow { transition: none; } }
</style>
