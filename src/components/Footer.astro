---
// Footer.astro — Global footer (same on every page)
import { serviceLinks } from '../data/pseo/service-groups.js';

// Social profiles under "Follow us", one line each. The visible text is also the link's
// accessible name. icon: the path of a 24px SVG icon.
const LINKEDIN_ICON = 'M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z';
const socialLinks = [
  { name: 'HRhelp on LinkedIn', href: 'https://www.linkedin.com/company/hrhelp/', icon: LINKEDIN_ICON },
];
---

<footer class="site-footer">
  <!-- Booking band: the footer's primary action -->
  <div class="footer-cta">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-person">
          <!-- Eager (low priority): lazy left the avatar empty on long pages until scrolled near it
               (and always in full-page captures); /about/ only looked fine because it loads the same file higher up -->
          <img src="/images/home/cornelis-candid-face.jpg" alt="Cornelis Leerlooijer, founder of HRHelp" class="cta-photo" width="320" height="320" loading="eager" fetchpriority="low" decoding="async" />
          <div class="cta-content">
            <h3>Your HR Needs, Our Support</h3>
            <p>Talk to a senior HR consultant in a free 30-minute consultation.<span class="cta-more"> Fixed pricing, agreed upfront.</span></p>
          </div>
        </div>
        <!-- .btn-primary: Layout.astro fires the GA4 cta_click on it -->
        <a href="/contact/" class="btn btn-primary btn-lg">
          Book Free Consultation
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Main footer -->
  <div class="footer-main motif-canal">
    <div class="container">
      <div class="footer-grid">
        <!-- Brand column -->
        <div class="footer-brand">
          <a href="/" class="footer-logo">
            <img src="/images/logo-white.png" alt="HRHelp" class="logo-img" width="1280" height="310" />
          </a>
          <p class="footer-tagline">Your Dutch HR partner for international success</p>
          <ul class="footer-contact">
            <li>
              <a href="tel:+31857608188">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <span>+31 85 760 8188</span>
              </a>
            </li>
            <li>
              <a href="mailto:info@hrhelp.nl">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
                <span>info@hrhelp.nl</span>
              </a>
            </li>
          </ul>
          <address class="footer-address">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Oeverwalweg 3, 1332 CG Almere<br />KVK 69913919</span>
          </address>
          <!-- Social profiles: socialLinks at the top of this file -->
          <div class="footer-social">
            <h4>Follow us</h4>
            <ul>
              {socialLinks.map((s) => (
                <li>
                  <a href={s.href} class="social-link" target="_blank" rel="noopener">
                    <span class="social-icon">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d={s.icon} /></svg>
                    </span>
                    <span>{s.name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <nav class="footer-nav" aria-label="Footer">
          <!-- Solutions column -->
          <div class="footer-col footer-col-solutions">
            <h4>Solutions</h4>
            <ul>
              <li><a href="/solutions/hr-settlers/">HR Settlers</a></li>
              <li><a href="/solutions/hr-teams/">HR Teams</a></li>
              <li><a href="/solutions/hr-reset/">HR Reset</a></li>
              <li><a href="/solutions/hr-sos/">HR S.O.S.</a></li>
              <li><a href="/solutions/">All Solutions</a></li>
            </ul>
          </div>

          <!-- HR Services column: every visible service page -->
          <div class="footer-col footer-col-services">
            <h4>HR Services</h4>
            <ul>
              <li><a href="/services/#core-expertise">Core expertise</a></li>
              {serviceLinks.map((s: any) => (
                <li><a href={`/services/${s.slug}/`}>{s.short || s.name}</a></li>
              ))}
              <li><a href="/services/">All HR Services</a></li>
            </ul>
          </div>

          <!-- Resources column -->
          <div class="footer-col footer-col-resources">
            <h4>Resources</h4>
            <ul>
              <li><a href="/blog/">Blog</a></li>
              <li><a href="/guides/">Employer Guides</a></li>
              <li><a href="/resources/faq/">FAQ</a></li>
              <li><a href="/resources/case-studies/">Case Studies</a></li>
            </ul>
          </div>

          <!-- Company column -->
          <div class="footer-col footer-col-company">
            <h4>Company</h4>
            <ul>
              <li><a href="/about/">About Us</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/careers/">Careers</a></li>
              <li><a href="/about/partners/">Partners</a></li>
              <li><a href="/privacy/">Privacy Policy</a></li>
            </ul>
          </div>
        </nav>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="container">
      <div class="footer-bottom-inner">
        <span>© 2026 HRHelp.nl B.V. · All rights reserved</span>
        <span class="footer-legal">
          <a href="/privacy/">Privacy Policy</a> · <a href="/terms/">Terms of Service</a> · <button type="button" class="footer-cookie-btn" data-cookie-settings>Cookie settings</button> · <a href="/sitemap/">Sitemap</a> · <a href="/llms.txt">LLM Citations &amp; Learning</a>
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Pre-footer CTA: a quiet strip on the footer navy instead of a full
     orange band (the pages above already end with a CTA panel) */
  .footer-cta {
    background: var(--navy);
    padding: 2.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  /* globals.css gives .footer-cta a navy focus ring for the old orange band */
  .footer-cta :global(:focus-visible) { outline-color: var(--orange-light) !important; }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .cta-person {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .cta-photo {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 50%;
    border: 2px solid rgba(255, 255, 255, 0.2);
    background: var(--navy-light);
  }

  .cta-content h3 {
    font-family: var(--font-heading);
    color: var(--white);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-bottom: 0.35rem;
  }

  .cta-content p {
    color: rgba(255, 255, 255, 0.88);
    font-size: 1rem;
  }

  .footer-cta .btn {
    white-space: nowrap;
  }

  /* Main footer */
  /* background-color only, so the .motif-canal image from globals.css stays */
  .footer-main {
    background-color: var(--navy);
    padding: 3.5rem 0 3rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.35fr repeat(4, 1fr);
    gap: 2.5rem;
    max-width: var(--container-max);
    margin: 0 auto;
  }

  /* The nav spans the three link columns and reuses the parent tracks */
  .footer-nav {
    grid-column: span 4;
    display: grid;
    grid-template-columns: subgrid;
  }

  /* Brand */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .footer-logo .logo-img {
    height: 36px;
    width: auto;
    display: block;
  }

  .footer-tagline {
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.95rem;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  /* Contact rows: 44px tall tap targets */
  .footer-contact {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 44px;
    color: rgba(255,255,255,0.85);
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    transition: color var(--transition-fast);
  }

  .footer-contact svg {
    flex-shrink: 0;
    color: var(--icon-accent);
  }

  .footer-contact a:hover {
    color: var(--white);
  }

  .footer-address {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin: 0.35rem 0 0;
    font-style: normal;
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
  }

  .footer-address svg {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--icon-accent);
  }

  /* Social profiles: a divided block under the contact details. .social-icon is the
     original 36px .social-link square, now beside a text label (44px row). */
  .footer-social {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    max-width: 340px;
  }

  .footer-social ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 44px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95rem;
    transition: color var(--transition-fast);
  }

  .social-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.6);
    transition: all var(--transition-fast);
  }

  .social-link:hover {
    color: var(--white);
  }

  .social-link:hover .social-icon {
    background: var(--orange);
    color: var(--white);
  }

  /* Columns ("Follow us" uses the same label style) */
  .footer-col h4,
  .footer-social h4 {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--white);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 1.25rem;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
  }

  .footer-col li {
    margin-bottom: 0.6rem;
  }

  .footer-col a {
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.9rem;
    transition: color var(--transition-fast);
  }

  .footer-col a:hover {
    color: var(--white);
    text-decoration: underline;
    text-decoration-color: var(--orange-light);
    text-underline-offset: 3px;
  }

  /* Bottom bar */
  .footer-bottom {
    background: var(--navy-dark);
    padding: 1.25rem 0;
  }

  .footer-bottom-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    display: flex;
    /* Too narrow for one row (about 768-950px): the legal links move under the copyright line */
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.88);
    /* The fixed chat button sits in the bottom-right corner (24px in, 60px wide): keep the
       right-aligned legal links, "Cookie settings" included, at least 96px from the viewport
       edge. Up to the 1400px container that is 80px on top of the gutter; wider screens'
       side margins take over. */
    padding-right: max(0px, calc(80px - max(0px, (100vw - var(--container-max)) / 2)));
  }


  .footer-legal a {
    /* Each link wraps as a whole, at the · separators (as on mobile) */
    display: inline-block;
    color: rgba(255, 255, 255, 0.88);
    transition: color var(--transition-fast);
  }

  .footer-legal a:hover {
    color: var(--white);
    text-decoration: underline;
    text-decoration-color: var(--orange-light);
    text-underline-offset: 3px;
  }

  /* "Cookie settings" reopens the cookie banner (CookieConsent.astro); styled like the links beside it */
  .footer-cookie-btn {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: rgba(255, 255, 255, 0.88);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .footer-cookie-btn:hover {
    color: var(--white);
    text-decoration: underline;
    text-decoration-color: var(--orange-light);
    text-underline-offset: 3px;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-nav {
      grid-column: auto;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (min-width: 901px) and (max-width: 1180px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-nav {
      grid-column: auto;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
  }

  /* Mobile: one 16px gutter (the .container), compact blocks, links in a
     two-column grid with 44px rows */
  @media (max-width: 767.98px) {
    .footer-cta,
    .footer-main,
    .footer-bottom {
      padding-inline: 0;
    }

    .footer-cta {
      padding-block: 1.75rem;
    }

    .cta-inner {
      gap: 1.25rem;
      align-items: stretch;
    }

    .cta-person {
      align-items: flex-start;
      gap: 1rem;
    }

    .cta-photo {
      width: 56px;
      height: 56px;
    }

    .cta-content h3 {
      font-size: 1.3rem;
      margin-bottom: 0.3rem;
    }

    .cta-content p {
      font-size: 0.95rem;
    }

    .footer-cta .btn {
      justify-content: center;
      padding-block: 0.95rem;
    }

    .footer-main {
      padding-block: 1.75rem 1.5rem;
    }

    .footer-grid {
      gap: 0;
    }

    .footer-brand {
      padding-bottom: 0.75rem;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    /* 44px tap target around the 30px logo */
    .footer-logo {
      min-height: 44px;
      margin: -7px 0 0.25rem;
    }

    .footer-logo .logo-img {
      height: 30px;
    }

    .footer-tagline {
      font-size: 0.9rem;
      margin-bottom: 0.5rem;
      line-height: 1.5;
    }

    /* Phone | email side by side, on the same two columns as the links */
    .footer-contact {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 1rem;
    }

    .footer-contact a {
      display: flex;
      gap: 0.5rem;
    }

    .footer-nav {
      grid-template-columns: 1fr 1fr;
      column-gap: 1rem;
      row-gap: 1.25rem;
    }

    /* Mobile order: Solutions | Company, then Resources full width in two
       columns (markup and desktop order stay Solutions, Resources, Company) */
    .footer-col-company {
      grid-column: 2;
      grid-row: 1;
    }

    .footer-col-resources {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .footer-col-services {
      grid-column: 1 / -1;
      grid-row: 3;
    }

    .footer-col-resources ul,
    .footer-col-services ul {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 1rem;
    }

    .footer-social {
      max-width: none;
      margin-top: 1.25rem;
      padding-top: 1.25rem;
    }

    /* Muted small caps labels */
    .footer-col h4,
    .footer-social h4 {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: rgba(255, 255, 255, 0.88);
      margin-bottom: 0.1rem;
    }

    .footer-col li {
      margin: 0;
    }

    /* 13px + 18px + 13px = 44px rows */
    .footer-col a {
      display: block;
      padding-block: 13px;
      line-height: 18px;
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.85);
    }

    .footer-bottom {
      padding-block: 0.75rem 5.5rem; /* room for the fixed chat button */
    }

    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding-right: 0; /* stacked on the left; the bottom padding above clears the chat button */
    }

    .footer-bottom-inner > span:first-child {
      padding-top: 0.5rem;
    }

    .footer-legal a,
    .footer-cookie-btn {
      display: inline-block;
      padding-block: 13px;
      line-height: 18px;
    }
  }
</style>
