---
// Header.astro — Global navigation with mega menu for all pages except homepage
import MenuIcon from './MenuIcon.astro';
const currentPath = Astro.url.pathname;

const solutions = [
  {
    slug: 'hr-settlers', name: 'HR Settlers',
    tagline: 'Enter the Dutch market with confidence',
    icon: 'location_on'
  },
  {
    slug: 'hr-teams', name: 'HR Teams',
    tagline: 'Your outsourced HR department',
    icon: 'groups'
  },
  {
    slug: 'hr-reset', name: 'HR Reset',
    tagline: 'Modernise your existing HR',
    icon: 'cycle'
  },
  {
    slug: 'hr-sos', name: 'HR S.O.S.',
    tagline: 'Urgent HR crisis support',
    icon: 'sos'
  }
];

const industries = [
  { slug: 'technology', name: 'Technology & Startups', icon: 'terminal' },
  { slug: 'life-sciences', name: 'Life Sciences & Pharma', icon: 'biotech' },
  { slug: 'finance', name: 'Finance & Fintech', icon: 'account_balance' },
  { slug: 'professional-services', name: 'Professional Services', icon: 'work' },
  { slug: 'logistics', name: 'Logistics & Supply Chain', icon: 'local_shipping' },
  { slug: 'ngo', name: 'NGO & Non-Profit', icon: 'public' },
  { slug: 'manufacturing', name: 'Greenfield & Manufacturing', icon: 'precision_manufacturing' },
  { slug: 'industrial', name: 'Production & Industrial', icon: 'engineering' },
];

import { getFeaturedArticles } from '../lib/wordpress';

const featuredArticles = await getFeaturedArticles();

const resourceLinks = [
  { label: 'HR Guides', icon: 'menu_book', href: '/guides/' },
  { label: 'Case Studies', icon: 'trending_up', href: '/resources/case-studies/' },
  { label: 'Blog', icon: 'article', href: '/blog/' },
  { label: 'FAQ', icon: 'help', href: '/resources/faq/' },
];

const navLinks = [
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

// Service mega menu columns — same source as the /services index (staging-gated).
import { serviceGroups } from '../data/pseo/service-groups.js';

// Core expertise: the three areas HRhelp is most often brought in for (top of the HR Services menu)
const coreExpertise = [
  { label: 'Sickness Management', href: '/expertise/sickness-management/' },
  { label: 'Restructuring', href: '/expertise/restructuring/' },
  { label: 'Leadership Training', href: '/expertise/leadership-training/' },
];
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <!-- Logo -->
    <a href="/" class="header-logo">
      <img src="/images/logo.png" alt="HRHelp" class="logo-img" width="1280" height="310" />
    </a>

    <!-- Navigation with Mega Menus -->
    <nav class="header-nav" id="header-nav" aria-label="Main">
      <!-- Solutions (mega menu) -->
      <div class="nav-item has-mega">
        <a href="/solutions/" aria-expanded="false" aria-controls="mega-solutions" class:list={['nav-link', { active: currentPath.startsWith('/solutions') }]}>
          Solutions
          <svg aria-hidden="true" class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="mega-panel mega-solutions" id="mega-solutions">
          <div class="mega-inner">
            <div class="mega-section-label">Our Solutions</div>
            <div class="mega-solutions-grid">
              {solutions.map(s => (
                <a href={`/solutions/${s.slug}/`} class="mega-sol-card">
                  <span class="mega-ico" aria-hidden="true"><MenuIcon name={s.icon} /></span>
                  <div class="mega-sol-text">
                    <span class="mega-sol-name">{s.name}</span>
                    <span class="mega-sol-tagline">{s.tagline}</span>
                  </div>
                </a>
              ))}
            </div>
            <div class="mega-footer">
              <a href="/solutions/" class="mega-footer-link">
                View All Solutions
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="/contact/" class="btn btn-primary header-cta">Book Consultation</a>
            </div>
          </div>
        </div>
      </div>

      <!-- HR Services (mega menu) -->
      <div class="nav-item has-mega">
        <a href="/services/" aria-expanded="false" aria-controls="mega-services" class:list={['nav-link', { active: currentPath.startsWith('/services') || currentPath.startsWith('/expertise') }]}>
          HR Services
          <svg aria-hidden="true" class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="mega-panel mega-services" id="mega-services">
          <div class="mega-inner">
            <div class="mega-core">
              <div class="mega-section-label mega-svc-label">Core expertise</div>
              <div class="mega-core-grid">
                {coreExpertise.map(c => (
                  <a href={c.href} class="mega-svc-item">{c.label}</a>
                ))}
              </div>
            </div>
            <div class="mega-services-grid">
              {serviceGroups.map(g => (
                <div class="mega-svc-col">
                  <div class="mega-section-label mega-svc-label">{g.label}</div>
                  {g.items.map(s => (
                    <a href={`/services/${s.slug}/`} class="mega-svc-item">{s.short}</a>
                  ))}
                </div>
              ))}
            </div>
            <div class="mega-footer">
              <a href="/services/" class="mega-footer-link">
                View all HR services
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="/contact/" class="btn btn-primary header-cta">Book Consultation</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Industries (mega menu) -->
      <div class="nav-item has-mega">
        <a href="/industries/" aria-expanded="false" aria-controls="mega-industries" class:list={['nav-link', { active: currentPath.startsWith('/industries') }]}>
          Industries
          <svg aria-hidden="true" class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="mega-panel mega-industries" id="mega-industries">
          <div class="mega-inner">
            <div class="mega-section-label">Industry Expertise</div>
            <div class="mega-industries-grid">
              {industries.map(ind => (
                <a href={`/industries/${ind.slug}/`} class="mega-ind-item">
                  <span class="mega-ico" aria-hidden="true"><MenuIcon name={ind.icon} /></span>
                  <span class="mega-ind-name">{ind.name}</span>
                </a>
              ))}
            </div>
            <div class="mega-footer">
              <a href="/industries/" class="mega-footer-link">
                Explore All Industries
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Resources (mega menu) -->
      <div class="nav-item has-mega">
        <a href="/resources/" aria-expanded="false" aria-controls="mega-resources" class:list={['nav-link', { active: currentPath.startsWith('/resources') }]}>
          Resources
          <svg aria-hidden="true" class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="mega-panel mega-resources" id="mega-resources">
          <div class="mega-inner">
            <div class="mega-res-layout">
              <!-- Featured articles -->
              <div class="mega-res-featured">
                <div class="mega-section-label">Featured Articles</div>
                <div class="mega-res-articles">
                  {featuredArticles.map(article => (
                    <a href={article.href} class="mega-res-card">
                      <div class="mega-res-img">
                        <img src={article.image} alt="" loading="lazy" />
                        <span class="mega-res-cat">{article.category}</span>
                      </div>
                      <span class="mega-res-title">{article.title}</span>
                    </a>
                  ))}
                </div>
              </div>
              <!-- Quick Links -->
              <div class="mega-res-links">
                <div class="mega-section-label">Quick Links</div>
                {resourceLinks.map(link => (
                  <a href={link.href} class="mega-res-link-item">
                    <span class="mega-ico" aria-hidden="true"><MenuIcon name={link.icon} /></span>
                    <span class="mega-res-link-label">{link.label}</span>
                  </a>
                ))}
              </div>
            </div>
            <div class="mega-footer">
              <a href="/resources/" class="mega-footer-link">
                Visit Resource Centre
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Simple links -->
      {navLinks.map(link => (
        <div class="nav-item">
          <a
            href={link.href}
            class:list={['nav-link', { active: currentPath.startsWith(link.href) }]}
          >
            {link.label}
          </a>
        </div>
      ))}
    </nav>

    <!-- Right side -->
    <div class="header-actions">
      <a href="/contact/" class="btn btn-primary header-cta">Book Consultation</a>
    </div>

    <!-- Mobile hamburger -->
    <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<!-- Mobile menu overlay -->
<div class="mobile-menu" id="mobile-menu">
  <nav class="mobile-nav" aria-label="Mobile">
    <!-- Solutions accordion -->
    <div class="mobile-accordion">
      <button class="mobile-accordion-trigger" aria-expanded="false">
        Solutions
        <svg aria-hidden="true" class="mobile-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="mobile-accordion-content">
        {solutions.map(s => (
          <a href={`/solutions/${s.slug}/`} class="mobile-sub-link">
            <span class="mobile-ico" aria-hidden="true"><MenuIcon name={s.icon} /></span>
            <span class="mobile-sub-label">{s.name}</span>
          </a>
        ))}
        <a href="/solutions/" class="mobile-sub-all">View All Solutions →</a>
      </div>
    </div>

    <!-- HR Services accordion -->
    <div class="mobile-accordion">
      <button class="mobile-accordion-trigger" aria-expanded="false">
        HR Services
        <svg aria-hidden="true" class="mobile-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="mobile-accordion-content">
        <span class="mobile-sub-group">Core expertise</span>
        {coreExpertise.map(c => (
          <a href={c.href} class="mobile-sub-link"><span class="mobile-sub-label">{c.label}</span></a>
        ))}
        {serviceGroups.map(g => (
          <>
            <span class="mobile-sub-group">{g.label}</span>
            {g.items.map(s => (
              <a href={`/services/${s.slug}/`} class="mobile-sub-link"><span class="mobile-sub-label">{s.short}</span></a>
            ))}
          </>
        ))}
        <a href="/services/" class="mobile-sub-all">View all HR services →</a>
      </div>
    </div>

    <!-- Industries accordion -->
    <div class="mobile-accordion">
      <button class="mobile-accordion-trigger" aria-expanded="false">
        Industries
        <svg aria-hidden="true" class="mobile-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="mobile-accordion-content">
        {industries.map(ind => (
          <a href={`/industries/${ind.slug}/`} class="mobile-sub-link">
            <span class="mobile-ico" aria-hidden="true"><MenuIcon name={ind.icon} /></span>
            <span class="mobile-sub-label">{ind.name}</span>
          </a>
        ))}
        <a href="/industries/" class="mobile-sub-all">Explore All Industries →</a>
      </div>
    </div>

    <!-- Resources accordion -->
    <div class="mobile-accordion">
      <button class="mobile-accordion-trigger" aria-expanded="false">
        Resources
        <svg aria-hidden="true" class="mobile-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="mobile-accordion-content">
        {resourceLinks.map(link => (
          <a href={link.href} class="mobile-sub-link">
            <span class="mobile-ico" aria-hidden="true"><MenuIcon name={link.icon} /></span>
            <span class="mobile-sub-label">{link.label}</span>
          </a>
        ))}
        <a href="/resources/" class="mobile-sub-all">Visit Resource Centre →</a>
      </div>
    </div>

    <a href="/about/" class:list={['mobile-nav-link', { active: currentPath.startsWith('/about') }]}>About</a>
    <a href="/contact/" class:list={['mobile-nav-link', { active: currentPath.startsWith('/contact') }]}>Contact</a>

    <a href="/contact/" class="btn btn-primary header-cta" style="margin-top: 1rem; width: 100%; justify-content: center;">
      Book Consultation
    </a>
  </nav>
</div>

<style>
  /* ═══════════════════════════════════════
     BASE HEADER
     ═══════════════════════════════════════ */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: var(--white);
    border-bottom: 1px solid rgba(15, 43, 70, 0.08);
    transition: all var(--transition-base);
  }

  .site-header.scrolled {
    box-shadow: 0 2px 12px rgba(15, 43, 70, 0.06);
  }

  .header-inner {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 0 2rem;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Same mobile gutter as the page heroes (PageHero) */
  @media (max-width: 768px) {
    .header-inner { padding: 0 var(--gutter-mobile); }
  }

  /* Logo */
  .header-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header-logo .logo-img {
    height: 38px;
    width: auto;
    display: block;
  }

  /* ═══════════════════════════════════════
     NAVIGATION
     ═══════════════════════════════════════ */
  .header-nav {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--gray-800);
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
    letter-spacing: 0.2px;
    text-decoration: none;
    cursor: pointer;
  }

  .nav-link:hover {
    color: var(--navy);
    background: var(--gray-50);
  }

  /* Active section: navy text, orange-ink underline (same state as the menu items) */
  .nav-link.active {
    color: var(--navy);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--orange-ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .chevron {
    transition: transform 0.25s ease;
    opacity: 0.5;
    flex-shrink: 0;
  }

  .nav-item.has-mega:hover .chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* ═══════════════════════════════════════
     MEGA PANEL — shared styles
     ═══════════════════════════════════════ */
  .mega-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
    z-index: 999;
    padding-top: 12px; /* hover bridge */
  }

  .nav-item.has-mega:hover .mega-panel,
  .nav-item.has-mega:focus-within .mega-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translateX(-50%) translateY(0);
  }

  /* Escape closes a panel even while hovered or focused */
  .nav-item.has-mega.mega-dismissed .mega-panel {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: none;
  }

  /* links inside transition "all", which would keep them visible (and focusable) for a moment */
  .nav-item.has-mega.mega-dismissed .mega-panel * {
    transition: none;
  }

  .nav-link[aria-expanded="true"] .chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  .mega-inner {
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12), 0 4px 20px rgba(0, 0, 0, 0.06);
    overflow: hidden;
  }

  .mega-section-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: var(--gray-500);
    padding: 1.25rem 1.5rem 0.75rem;
  }

  .mega-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.5rem;
    background: var(--gray-50);
    border-top: 1px solid var(--gray-100);
  }

  .mega-footer-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--navy);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  /* One hover/active state in every menu: navy text with an orange-ink underline */
  .mega-footer-link:hover,
  .mega-svc-item:hover,
  .mega-sol-card:hover .mega-sol-name,
  .mega-ind-item:hover .mega-ind-name,
  .mega-res-card:hover .mega-res-title,
  .mega-res-link-item:hover .mega-res-link-label,
  .mobile-sub-link:hover .mobile-sub-label,
  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--navy);
    text-decoration: underline;
    text-decoration-color: var(--orange-ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /* Plain line icon, no box: fixed 24px column so the titles line up */
  .mega-ico,
  .mobile-ico {
    display: flex;
    align-items: center;
    width: 24px;
    min-width: 24px;
    color: var(--icon-accent);
  }

  /* ═══════════════════════════════════════
     HR SERVICES MEGA MENU
     ═══════════════════════════════════════ */
  .mega-services {
    width: 700px;
  }

  .mega-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    padding: 0 0.75rem 0.75rem;
  }

  /* Core expertise row above the service columns, same item style, hairline below */
  .mega-core {
    padding: 0 0.75rem 0.5rem;
    border-bottom: 1px solid var(--gray-100);
  }
  .mega-core-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .mega-svc-col {
    display: flex;
    flex-direction: column;
  }

  .mega-svc-label {
    padding: 1.25rem 0.75rem 0.5rem;
  }

  .mega-svc-item {
    display: block;
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.35;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.2s ease;
  }


  /* Keep the wide panel inside the viewport on narrow desktops */
  @media (max-width: 1100px) {
    .mega-services { width: 520px; }
    .mega-services-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ═══════════════════════════════════════
     SOLUTIONS MEGA MENU
     ═══════════════════════════════════════ */
  .mega-solutions {
    width: 520px;
  }

  .mega-solutions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    padding: 0 0.75rem 0.75rem;
  }

  .mega-sol-card {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.9rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .mega-sol-card .mega-ico {
    height: 20px; /* centre the icon on the first line of the title */
  }

  .mega-sol-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mega-sol-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--navy);
    line-height: 1.3;
  }

  .mega-sol-tagline {
    font-size: 0.78rem;
    color: var(--gray-500);
    line-height: 1.4;
  }


  /* ═══════════════════════════════════════
     INDUSTRIES MEGA MENU
     ═══════════════════════════════════════ */
  .mega-industries {
    width: 520px;
  }

  .mega-industries-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    padding: 0 0.5rem 0.5rem;
  }

  .mega-ind-item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.2s ease;
  }


  .mega-ind-name {
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.3;
  }


  /* ═══════════════════════════════════════
     RESOURCES MEGA MENU
     ═══════════════════════════════════════ */
  .mega-resources {
    width: 660px;
  }

  .mega-res-layout {
    display: flex;
    gap: 0;
  }

  .mega-res-featured {
    flex: 1;
    border-right: 1px solid var(--gray-100);
  }

  .mega-res-articles {
    display: flex;
    gap: 0.5rem;
    padding: 0 1rem 1rem;
  }

  .mega-res-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all 0.2s ease;
    flex: 1;
    padding: 0.4rem;
  }


  .mega-res-img {
    position: relative;
    width: 100%;
    aspect-ratio: 16/10;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--gray-100);
  }

  .mega-res-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .mega-res-card:hover .mega-res-img img {
    transform: scale(1.05);
  }

  .mega-res-cat {
    position: absolute;
    top: 6px;
    left: 6px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--white);
    background: var(--navy);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .mega-res-title {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--navy);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }


  .mega-res-links {
    min-width: 190px;
    padding-right: 0.5rem;
  }

  .mega-res-link-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1rem;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
    margin: 0 0.5rem;
  }

  .mega-res-link-label {
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--navy);
  }

  /* ═══════════════════════════════════════
     RIGHT SIDE
     ═══════════════════════════════════════ */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  /* One header CTA site-wide: the same pill as HomeHeader's .home-cta-btn */
  .btn.header-cta {
    padding: 0.6rem 1.5rem;
    font-size: 0.85rem;
    line-height: inherit;
    letter-spacing: 0.2px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .btn.header-cta:hover {
    transform: none;
  }

  /* ═══════════════════════════════════════
     MOBILE TOGGLE
     ═══════════════════════════════════════ */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    z-index: 1001;
  }

  .mobile-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--navy);
    border-radius: 2px;
    transition: all var(--transition-base);
  }

  .mobile-toggle.open span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-toggle.open span:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle.open span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* ═══════════════════════════════════════
     MOBILE MENU OVERLAY
     ═══════════════════════════════════════ */
  .mobile-menu {
    display: none;
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--white);
    z-index: 999;
    padding: 1rem 1.5rem 2rem;
    opacity: 0;
    transform: translateY(-10px);
    transition: all var(--transition-base);
    overflow-y: auto;
  }

  .mobile-menu.open {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Mobile accordion */
  .mobile-accordion {
    border-bottom: 1px solid var(--gray-100);
  }

  .mobile-accordion-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: none;
    padding: 1rem 0;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--navy);
    cursor: pointer;
    text-align: left;
  }

  .mobile-acc-chevron {
    transition: transform 0.3s ease;
    color: var(--gray-400);
  }

  .mobile-accordion-trigger[aria-expanded="true"] .mobile-acc-chevron {
    transform: rotate(180deg);
    color: var(--orange-ink);
  }

  .mobile-accordion-content {
    display: none;
    padding: 0 0 0.75rem 0.5rem;
  }

  .mobile-accordion-content.open {
    display: block;
  }

  .mobile-sub-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.5rem;
    text-decoration: none;
    color: var(--navy);
    font-size: 0.92rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .mobile-sub-group {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.4px;
    color: var(--gray-400);
    padding: 0.75rem 0.5rem 0.25rem;
  }

  .mobile-sub-all {
    display: block;
    padding: 0.6rem 0.5rem;
    color: var(--orange-ink);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    margin-top: 0.25rem;
  }

  .mobile-nav-link {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--navy);
    padding: 1rem 0;
    border-bottom: 1px solid var(--gray-100);
    transition: color var(--transition-fast);
    text-decoration: none;
  }


  /* ═══════════════════════════════════════
     RESPONSIVE
     ═══════════════════════════════════════ */
  @media (max-width: 900px) {
    .header-nav,
    .header-actions {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .mobile-menu {
      display: block;
      pointer-events: none;
      visibility: hidden;
    }

    .mobile-menu.open {
      pointer-events: all;
      visibility: visible;
      /* become visible at once so focus can move into the menu */
      transition-property: opacity, transform;
    }
  }
</style>

<script>
  // Scroll effect
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });

  // Mobile toggle
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const setMenu = (open: boolean) => {
    toggle?.classList.toggle('open', open);
    menu?.classList.toggle('open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => {
    const open = !menu?.classList.contains('open');
    setMenu(open);
    if (open) (menu?.querySelector('a, button') as HTMLElement | null)?.focus();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('open')) {
      setMenu(false);
      toggle?.focus();
    }
  });
  // Keep Tab inside the open menu: after its last link, go back to the toggle
  menu?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || e.shiftKey) return;
    const links = menu.querySelectorAll('a, button');
    if (document.activeElement === links[links.length - 1]) {
      e.preventDefault();
      toggle?.focus();
    }
  });

  // Mega menus: expose open state on the trigger, Escape closes and returns focus
  document.querySelectorAll('.nav-item.has-mega').forEach((item) => {
    const trigger = item.querySelector('.nav-link') as HTMLElement | null;
    if (!trigger) return;
    const isOpen = () => !item.classList.contains('mega-dismissed') && (item.matches(':hover') || item.matches(':focus-within'));
    const sync = () => requestAnimationFrame(() => trigger.setAttribute('aria-expanded', String(isOpen())));
    item.addEventListener('mouseenter', () => { item.classList.remove('mega-dismissed'); sync(); });
    item.addEventListener('mouseleave', () => { item.classList.remove('mega-dismissed'); sync(); });
    item.addEventListener('focusin', sync);
    item.addEventListener('focusout', (e) => {
      if (!item.contains((e as FocusEvent).relatedTarget as Node)) item.classList.remove('mega-dismissed');
      sync();
    });
    item.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key === 'Escape' && isOpen()) {
        e.preventDefault();
        item.classList.add('mega-dismissed');
        void (item as HTMLElement).offsetHeight; // apply the hidden state before the next Tab
        trigger.focus();
        sync();
      } else if (key === 'ArrowDown' && document.activeElement === trigger) {
        e.preventDefault();
        item.classList.remove('mega-dismissed');
        sync();
      }
    });
  });

  // Mobile accordions
  document.querySelectorAll('.mobile-accordion-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      // Close all other accordions
      document.querySelectorAll('.mobile-accordion-trigger').forEach(other => {
        if (other !== btn) {
          other.setAttribute('aria-expanded', 'false');
          other.nextElementSibling?.classList.remove('open');
        }
      });
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      btn.nextElementSibling?.classList.toggle('open');
    });
  });
</script>
