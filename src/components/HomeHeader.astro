    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12), 0 4px 20px rgba(0, 0, 0, 0.06);
  }
  .home-header.scrolled .hh-mega-label { color: var(--gray-500); }
  .home-header.scrolled .hh-mega-footer { background: var(--gray-50); border-top-color: var(--gray-100); }
  .home-header.scrolled .hh-mega-footer-link { color: var(--navy); }
  .home-header.scrolled .hh-mega-inner { --icon-accent: var(--orange-ink); }

  .home-header.scrolled .hh-mega-svc-item { color: var(--navy); }
  .home-header.scrolled .hh-mega-core { border-bottom-color: var(--gray-100); }
  .home-header.scrolled .hh-mega-sol-name { color: var(--navy); }
  .home-header.scrolled .hh-mega-sol-tagline { color: var(--gray-500); }
  .home-header.scrolled .hh-mega-ind-name { color: var(--navy); }
  .home-header.scrolled .hh-mega-res-featured { border-right-color: var(--gray-100); }
  .home-header.scrolled .hh-mega-res-img { background: var(--gray-100); }
  .home-header.scrolled .hh-mega-res-title { color: var(--navy); }
  .home-header.scrolled .hh-mega-res-link-label { color: var(--navy); }

  /* Hover/active on white: navy text, orange-ink underline (as in Header.astro) */
  .home-header.scrolled .hh-mega-footer-link:hover,
  .home-header.scrolled .hh-mega-svc-item:hover,
  .home-header.scrolled .hh-mega-sol-card:hover .hh-mega-sol-name,
  .home-header.scrolled .hh-mega-ind-item:hover .hh-mega-ind-name,
  .home-header.scrolled .hh-mega-res-card:hover .hh-mega-res-title,
  .home-header.scrolled .hh-mega-res-link-item:hover .hh-mega-res-link-label,
  .home-header.scrolled ~ .home-mobile-menu .hh-mob-sub-link:hover .hh-mob-sub-label,
  .home-header.scrolled ~ .home-mobile-menu .home-mobile-link:hover,
  .home-header.scrolled ~ .home-mobile-menu .home-mobile-link.active {
    color: var(--navy);
    text-decoration-color: var(--orange-ink);
  }

  /* Mobile menu (sibling of the header) */
  .home-header.scrolled ~ .home-mobile-menu {
    background: var(--white);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    --icon-accent: var(--orange-ink);
  }
  .home-header.scrolled ~ .home-mobile-menu .hh-mob-accordion { border-bottom-color: var(--gray-100); }
  .home-header.scrolled ~ .home-mobile-menu .hh-mob-acc-trigger { color: var(--navy); }
  .home-header.scrolled ~ .home-mobile-menu .hh-mob-acc-chevron { color: var(--gray-400); }
  .home-header.scrolled ~ .home-mobile-menu .hh-mob-acc-trigger[aria-expanded="true"] .hh-mob-acc-chevron { color: var(--orange-ink); }
  .home-header.scrolled ~ .home-mobile-menu .hh-mob-sub-link { color: var(--navy); }
  .home-header.scrolled ~ .home-mobile-menu .hh-mob-sub-all { color: var(--orange-ink); }
  .home-header.scrolled ~ .home-mobile-menu .hh-mob-sub-group { color: var(--gray-400); }
  .home-header.scrolled ~ .home-mobile-menu .home-mobile-link { color: var(--navy); border-bottom-color: var(--gray-100); }

  /* Focus ring: light orange on navy (top of page), the global orange-ink on white once scrolled */
  .home-header:not(.scrolled) :focus-visible,
  .home-header:not(.scrolled) ~ .home-mobile-menu :focus-visible {
