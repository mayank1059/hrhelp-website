---
// HomeHeader.astro — Homepage-specific header with dark navy styling + mega menus
import MenuIcon from './MenuIcon.astro';
const currentPath = Astro.url.pathname;

const solutions = [
  {
    slug: 'hr-settlers', name: 'HR Settlers',
    tagline: 'Enter the Dutch market with confidence',
    icon: 'location_on'
  },
  {
    slug: 'hr-teams', name: 'HR Teams',
    tagline: 'Your outsourced HR department',
    icon: 'groups'
  },
  {
    slug: 'hr-reset', name: 'HR Reset',
    tagline: 'Modernise your existing HR',
    icon: 'cycle'
  },
  {
    slug: 'hr-sos', name: 'HR S.O.S.',
    tagline: 'Urgent HR crisis support',
    icon: 'sos'
  }
];

const industries = [
  { slug: 'technology', name: 'Technology & Startups', icon: 'terminal' },
  { slug: 'life-sciences', name: 'Life Sciences & Pharma', icon: 'biotech' },
  { slug: 'finance', name: 'Finance & Fintech', icon: 'account_balance' },
  { slug: 'professional-services', name: 'Professional Services', icon: 'work' },
  { slug: 'logistics', name: 'Logistics & Supply Chain', icon: 'local_shipping' },
  { slug: 'ngo', name: 'NGO & Non-Profit', icon: 'public' },
  { slug: 'manufacturing', name: 'Greenfield & Manufacturing', icon: 'precision_manufacturing' },
  { slug: 'industrial', name: 'Production & Industrial', icon: 'engineering' },
];

import { getFeaturedArticles } from '../lib/wordpress';

const featuredArticles = await getFeaturedArticles();

const resourceLinks = [
  { label: 'HR Guides', icon: 'menu_book', href: '/guides/' },
  { label: 'Case Studies', icon: 'trending_up', href: '/resources/case-studies/' },
  { label: 'Blog', icon: 'article', href: '/blog/' },
  { label: 'FAQ', icon: 'help', href: '/resources/faq/' },
];

const navLinks = [
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

// Service mega menu columns — same source as the /services index (staging-gated).
import { serviceGroups } from '../data/pseo/service-groups.js';

// Core expertise: the three areas HRhelp is most often brought in for (top of the HR Services menu)
const coreExpertise = [
  { label: 'Sickness Management', href: '/expertise/sickness-management/' },
  { label: 'Restructuring', href: '/expertise/restructuring/' },
  { label: 'Leadership Training', href: '/expertise/leadership-training/' },
];
---

<header class="home-header" id="site-header">
  <div class="home-header-inner">
    <!-- Logo: white over the navy hero, navy once the header turns white on scroll -->
    <a href="/" class="home-header-logo">
      <img src="/images/logo-white.png" alt="HRHelp" class="logo-img logo-on-dark" width="1280" height="310" />
      <img src="/images/logo.png" alt="HRHelp" class="logo-img logo-on-light" width="1280" height="310" />
    </a>

    <!-- Navigation with Mega Menus -->
    <nav class="home-header-nav" aria-label="Main">
      <!-- Solutions (mega menu) -->
      <div class="hh-nav-item hh-has-mega">
        <a href="/solutions/" aria-expanded="false" aria-controls="hh-mega-solutions" class:list={['home-nav-link', { active: currentPath.startsWith('/solutions') }]}>
          Solutions
          <svg aria-hidden="true" class="hh-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="hh-mega-panel hh-mega-solutions" id="hh-mega-solutions">
          <div class="hh-mega-inner">
            <div class="hh-mega-label">Our Solutions</div>
            <div class="hh-mega-sol-grid">
              {solutions.map(s => (
                <a href={`/solutions/${s.slug}/`} class="hh-mega-sol-card">
                  <span class="hh-ico" aria-hidden="true"><MenuIcon name={s.icon} /></span>
                  <div class="hh-mega-sol-text">
                    <span class="hh-mega-sol-name">{s.name}</span>
                    <span class="hh-mega-sol-tagline">{s.tagline}</span>
                  </div>
                </a>
              ))}
            </div>
            <div class="hh-mega-footer">
              <a href="/solutions/" class="hh-mega-footer-link">
                View All Solutions
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="/contact/" class="home-cta-btn btn-primary">Book Consultation</a>
            </div>
          </div>
        </div>
      </div>

      <!-- HR Services (mega menu) -->
      <div class="hh-nav-item hh-has-mega">
        <a href="/services/" aria-expanded="false" aria-controls="hh-mega-services" class:list={['home-nav-link', { active: currentPath.startsWith('/services') || currentPath.startsWith('/expertise') }]}>
          HR Services
          <svg aria-hidden="true" class="hh-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="hh-mega-panel hh-mega-services" id="hh-mega-services">
          <div class="hh-mega-inner">
            <div class="hh-mega-core">
              <div class="hh-mega-label hh-mega-svc-label">Core expertise</div>
              <div class="hh-mega-core-grid">
                {coreExpertise.map(c => (
                  <a href={c.href} class="hh-mega-svc-item">{c.label}</a>
                ))}
              </div>
            </div>
            <div class="hh-mega-svc-grid">
              {serviceGroups.map(g => (
                <div class="hh-mega-svc-col">
                  <div class="hh-mega-label hh-mega-svc-label">{g.label}</div>
                  {g.items.map(s => (
                    <a href={`/services/${s.slug}/`} class="hh-mega-svc-item">{s.short}</a>
                  ))}
                </div>
              ))}
            </div>
            <div class="hh-mega-footer">
              <a href="/services/" class="hh-mega-footer-link">
                View all HR services
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="/contact/" class="home-cta-btn btn-primary">Book Consultation</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Industries (mega menu) -->
      <div class="hh-nav-item hh-has-mega">
        <a href="/industries/" aria-expanded="false" aria-controls="hh-mega-industries" class:list={['home-nav-link', { active: currentPath.startsWith('/industries') }]}>
          Industries
          <svg aria-hidden="true" class="hh-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="hh-mega-panel hh-mega-industries" id="hh-mega-industries">
          <div class="hh-mega-inner">
            <div class="hh-mega-label">Industry Expertise</div>
            <div class="hh-mega-ind-grid">
              {industries.map(ind => (
                <a href={`/industries/${ind.slug}/`} class="hh-mega-ind-item">
                  <span class="hh-ico" aria-hidden="true"><MenuIcon name={ind.icon} /></span>
                  <span class="hh-mega-ind-name">{ind.name}</span>
                </a>
              ))}
            </div>
            <div class="hh-mega-footer">
              <a href="/industries/" class="hh-mega-footer-link">
                Explore All Industries
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Resources (mega menu) -->
      <div class="hh-nav-item hh-has-mega">
        <a href="/resources/" aria-expanded="false" aria-controls="hh-mega-resources" class:list={['home-nav-link', { active: currentPath.startsWith('/resources') }]}>
          Resources
          <svg aria-hidden="true" class="hh-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="hh-mega-panel hh-mega-resources" id="hh-mega-resources">
          <div class="hh-mega-inner">
            <div class="hh-mega-res-layout">
              <!-- Featured articles -->
              <div class="hh-mega-res-featured">
                <div class="hh-mega-label">Featured Articles</div>
                <div class="hh-mega-res-articles">
                  {featuredArticles.map(article => (
                    <a href={article.href} class="hh-mega-res-card">
                      <div class="hh-mega-res-img">
                        <img src={article.image} alt="" loading="lazy" />
                        <span class="hh-mega-res-cat">{article.category}</span>
                      </div>
                      <span class="hh-mega-res-title">{article.title}</span>
                    </a>
                  ))}
                </div>
              </div>
              <!-- Quick Links -->
              <div class="hh-mega-res-links">
                <div class="hh-mega-label">Quick Links</div>
                {resourceLinks.map(link => (
                  <a href={link.href} class="hh-mega-res-link-item">
                    <span class="hh-ico" aria-hidden="true"><MenuIcon name={link.icon} /></span>
                    <span class="hh-mega-res-link-label">{link.label}</span>
                  </a>
                ))}
              </div>
            </div>
            <div class="hh-mega-footer">
              <a href="/resources/" class="hh-mega-footer-link">
                Visit Resource Centre
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Simple links -->
      {navLinks.map(link => (
        <div class="hh-nav-item">
          <a
            href={link.href}
            class:list={['home-nav-link', { active: currentPath.startsWith(link.href) }]}
          >
            {link.label}
          </a>
        </div>
      ))}
    </nav>

    <!-- Right side -->
    <div class="home-header-actions">
      <a href="/contact/" class="home-cta-btn btn-primary">Book Consultation</a>
    </div>

    <!-- Mobile hamburger -->
    <button class="home-mobile-toggle" id="home-mobile-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="home-mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<!-- Mobile menu overlay -->
<div class="home-mobile-menu" id="home-mobile-menu">
  <nav class="home-mobile-nav" aria-label="Mobile">
    <!-- Solutions accordion -->
    <div class="hh-mob-accordion">
      <button class="hh-mob-acc-trigger" aria-expanded="false">
        Solutions
        <svg aria-hidden="true" class="hh-mob-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="hh-mob-acc-content">
        {solutions.map(s => (
          <a href={`/solutions/${s.slug}/`} class="hh-mob-sub-link">
            <span class="hh-ico" aria-hidden="true"><MenuIcon name={s.icon} /></span>
            <span class="hh-mob-sub-label">{s.name}</span>
          </a>
        ))}
        <a href="/solutions/" class="hh-mob-sub-all">View All Solutions →</a>
      </div>
    </div>

    <!-- HR Services accordion -->
    <div class="hh-mob-accordion">
      <button class="hh-mob-acc-trigger" aria-expanded="false">
        HR Services
        <svg aria-hidden="true" class="hh-mob-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="hh-mob-acc-content">
        <span class="hh-mob-sub-group">Core expertise</span>
        {coreExpertise.map(c => (
          <a href={c.href} class="hh-mob-sub-link"><span class="hh-mob-sub-label">{c.label}</span></a>
        ))}
        {serviceGroups.map(g => (
          <>
            <span class="hh-mob-sub-group">{g.label}</span>
            {g.items.map(s => (
              <a href={`/services/${s.slug}/`} class="hh-mob-sub-link"><span class="hh-mob-sub-label">{s.short}</span></a>
            ))}
          </>
        ))}
        <a href="/services/" class="hh-mob-sub-all">View all HR services →</a>
      </div>
    </div>

    <!-- Industries accordion -->
    <div class="hh-mob-accordion">
      <button class="hh-mob-acc-trigger" aria-expanded="false">
        Industries
        <svg aria-hidden="true" class="hh-mob-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="hh-mob-acc-content">
        {industries.map(ind => (
          <a href={`/industries/${ind.slug}/`} class="hh-mob-sub-link">
            <span class="hh-ico" aria-hidden="true"><MenuIcon name={ind.icon} /></span>
            <span class="hh-mob-sub-label">{ind.name}</span>
          </a>
        ))}
        <a href="/industries/" class="hh-mob-sub-all">Explore All Industries →</a>
      </div>
    </div>

    <!-- Resources accordion -->
    <div class="hh-mob-accordion">
      <button class="hh-mob-acc-trigger" aria-expanded="false">
        Resources
        <svg aria-hidden="true" class="hh-mob-acc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="hh-mob-acc-content">
        {resourceLinks.map(link => (
          <a href={link.href} class="hh-mob-sub-link">
            <span class="hh-ico" aria-hidden="true"><MenuIcon name={link.icon} /></span>
            <span class="hh-mob-sub-label">{link.label}</span>
          </a>
        ))}
        <a href="/resources/" class="hh-mob-sub-all">Visit Resource Centre →</a>
      </div>
    </div>

    <a href="/about/" class:list={['home-mobile-link', { active: currentPath.startsWith('/about') }]}>About</a>
    <a href="/contact/" class:list={['home-mobile-link', { active: currentPath.startsWith('/contact') }]}>Contact</a>

    <a href="/contact/" class="home-cta-btn btn-primary" style="margin-top: 1rem; width: 100%; justify-content: center;">
      Book Consultation
    </a>
  </nav>
</div>

<style>
  /* ═══════════════════════════════════════
     HOME HEADER — Dark navy style
     ═══════════════════════════════════════ */
  .home-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  /* Scrolled: the same solid white header as the inner pages (Header.astro) */
  .home-header.scrolled {
    background: var(--white);
    border-bottom-color: rgba(15, 43, 70, 0.08);
    box-shadow: 0 2px 12px rgba(15, 43, 70, 0.06);
  }

  .home-header-inner {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 0 2rem;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Same mobile gutter as the page heroes (PageHero) */
  @media (max-width: 768px) {
    .home-header-inner { padding: 0 var(--gutter-mobile); }
  }

  /* ── Logo ── */
  .home-header-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .home-header-logo .logo-img {
    height: 38px;
    width: auto;
    display: block;
    grid-area: 1 / 1;
    transition: opacity 180ms ease, visibility 180ms ease;
  }

  /* Both logos share one grid cell; only one is visible (and exposed) at a time */
  .home-header-logo { display: grid; }
  .home-header .logo-on-light,
  .home-header.scrolled .logo-on-dark { opacity: 0; visibility: hidden; }
  .home-header.scrolled .logo-on-light { opacity: 1; visibility: visible; }

  /* ═══════════════════════════════════════
     NAVIGATION
     ═══════════════════════════════════════ */
  .home-header-nav {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .hh-nav-item {
    position: relative;
  }

  .home-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.88rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
    letter-spacing: 0.2px;
    text-decoration: none;
    cursor: pointer;
  }

  .home-nav-link:hover {
    color: var(--white);
    background: rgba(255, 255, 255, 0.08);
  }

  /* Active section: same underline state as the menu items (light orange on navy) */
  .home-nav-link.active {
    color: var(--white);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--orange-light);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .hh-chevron {
    transition: transform 0.25s ease;
    opacity: 0.5;
    flex-shrink: 0;
  }

  .hh-nav-item.hh-has-mega:hover .hh-chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* ═══════════════════════════════════════
     MEGA PANEL — Dark theme shared styles
     ═══════════════════════════════════════ */
  .hh-mega-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
    z-index: 999;
    padding-top: 12px;
  }

  .hh-nav-item.hh-has-mega:hover .hh-mega-panel,
  .hh-nav-item.hh-has-mega:focus-within .hh-mega-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translateX(-50%) translateY(0);
  }

  /* Escape closes a panel even while hovered or focused */
  .hh-nav-item.hh-has-mega.mega-dismissed .hh-mega-panel {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: none;
  }

  /* links inside transition "all", which would keep them visible (and focusable) for a moment */
  .hh-nav-item.hh-has-mega.mega-dismissed .hh-mega-panel * {
    transition: none;
  }

  .home-nav-link[aria-expanded="true"] .hh-chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* Opaque: a translucent panel let the hero headline show through */
  .hh-mega-inner {
    background: rgb(10, 25, 50);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35), 0 4px 20px rgba(0, 0, 0, 0.2);
    overflow: hidden;
  }

  .hh-mega-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: rgba(255, 255, 255, 0.88);
    padding: 1.25rem 1.5rem 0.75rem;
  }

  .hh-mega-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.5rem;
    background: rgba(255, 255, 255, 0.04);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hh-mega-footer-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  /* One hover/active state in every menu: title colour stays, orange underline
     (--orange-light on navy here, --orange-ink once the header turns white) */
  .hh-mega-footer-link:hover,
  .hh-mega-svc-item:hover,
  .hh-mega-sol-card:hover .hh-mega-sol-name,
  .hh-mega-ind-item:hover .hh-mega-ind-name,
  .hh-mega-res-card:hover .hh-mega-res-title,
  .hh-mega-res-link-item:hover .hh-mega-res-link-label,
  .hh-mob-sub-link:hover .hh-mob-sub-label,
  .home-mobile-link:hover,
  .home-mobile-link.active {
    color: var(--white);
    text-decoration: underline;
    text-decoration-color: var(--orange-light);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /* Plain line icon, no box: fixed 24px column so the titles line up */
  .hh-ico {
    display: flex;
    align-items: center;
    width: 24px;
    min-width: 24px;
    color: var(--icon-accent);
  }

  /* Line icons on navy use the light orange */
  .hh-mega-inner,
  .home-mobile-menu {
    --icon-accent: var(--orange-light);
  }

  /* ═══════════════════════════════════════
     HR SERVICES MEGA MENU
     ═══════════════════════════════════════ */
  .hh-mega-services {
    width: 700px;
  }

  .hh-mega-svc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    padding: 0 0.75rem 0.75rem;
  }

  /* Core expertise row above the service columns, same item style, hairline below */
  .hh-mega-core {
    padding: 0 0.75rem 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .hh-mega-core-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .hh-mega-svc-col {
    display: flex;
    flex-direction: column;
  }

  .hh-mega-svc-label {
    padding: 1.25rem 0.75rem 0.5rem;
  }

  .hh-mega-svc-item {
    display: block;
    font-size: 0.84rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.35;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.2s ease;
  }


  /* Keep the wide panel inside the viewport on narrow desktops */
  @media (max-width: 1100px) {
    .hh-mega-services { width: 520px; }
    .hh-mega-svc-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ═══════════════════════════════════════
     SOLUTIONS MEGA MENU
     ═══════════════════════════════════════ */
  .hh-mega-solutions {
    width: 520px;
  }

  .hh-mega-sol-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    padding: 0 0.75rem 0.75rem;
  }

  .hh-mega-sol-card {
    display: flex;
    align-items: flex-start;
