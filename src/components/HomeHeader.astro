    .home-mobile-toggle {
      display: flex;
    }

    .home-mobile-menu {
      display: block;
      pointer-events: none;
      visibility: hidden;
    }

    .home-mobile-menu.open {
      pointer-events: all;
      visibility: visible;
      /* become visible at once so focus can move into the menu */
      transition-property: opacity, transform;
    }
  }
</style>

<script>
  // Scroll effect
  const header = document.getElementById('site-header');
  // The homepage always opens at the top of the hero. Without this, browsers
  // (Brave, Chrome) restore the previous scroll position on reload, the page
  // opens a few pixels down and the header starts in its white state.
  // Links to a section (#hash) keep their normal jump.
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  if (!location.hash) window.scrollTo({ top: 0, left: 0, behavior: 'instant' as ScrollBehavior });

  // White header as soon as the page is scrolled.
  const syncScrolled = () => header?.classList.toggle('scrolled', window.scrollY > 10);
  syncScrolled();
  window.addEventListener('scroll', syncScrolled, { passive: true });

  // Mobile toggle
  const toggle = document.getElementById('home-mobile-toggle');
  const menu = document.getElementById('home-mobile-menu');
  const setMenu = (open: boolean) => {
    toggle?.classList.toggle('open', open);
    menu?.classList.toggle('open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => {
    const open = !menu?.classList.contains('open');
    setMenu(open);
    if (open) (menu?.querySelector('a, button') as HTMLElement | null)?.focus();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('open')) {
      setMenu(false);
      toggle?.focus();
    }
  });
  // Keep Tab inside the open menu: after its last link, go back to the toggle
  menu?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || e.shiftKey) return;
    const links = menu.querySelectorAll('a, button');
    if (document.activeElement === links[links.length - 1]) {
      e.preventDefault();
      toggle?.focus();
    }
  });

  // Mega menus: expose open state on the trigger, Escape closes and returns focus
  document.querySelectorAll('.hh-nav-item.hh-has-mega').forEach((item) => {
    const trigger = item.querySelector('.home-nav-link') as HTMLElement | null;
    if (!trigger) return;
    const isOpen = () => !item.classList.contains('mega-dismissed') && (item.matches(':hover') || item.matches(':focus-within'));
    const sync = () => requestAnimationFrame(() => trigger.setAttribute('aria-expanded', String(isOpen())));
    item.addEventListener('mouseenter', () => { item.classList.remove('mega-dismissed'); sync(); });
    item.addEventListener('mouseleave', () => { item.classList.remove('mega-dismissed'); sync(); });
    item.addEventListener('focusin', sync);
    item.addEventListener('focusout', (e) => {
      if (!item.contains((e as FocusEvent).relatedTarget as Node)) item.classList.remove('mega-dismissed');
      sync();
    });
    item.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key === 'Escape' && isOpen()) {
        e.preventDefault();
        item.classList.add('mega-dismissed');
        void (item as HTMLElement).offsetHeight; // apply the hidden state before the next Tab
        trigger.focus();
        sync();
      } else if (key === 'ArrowDown' && document.activeElement === trigger) {
        e.preventDefault();
        item.classList.remove('mega-dismissed');
        sync();
      }
    });
  });

  // Mobile accordions
  document.querySelectorAll('.hh-mob-acc-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.hh-mob-acc-trigger').forEach(other => {
        if (other !== btn) {
          other.setAttribute('aria-expanded', 'false');
          other.nextElementSibling?.classList.remove('open');
        }
      });
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      btn.nextElementSibling?.classList.toggle('open');
    });
  });
</script>
