  /* ═══════════════════════════════════════
     SCROLLED — light theme, mirrors Header.astro
     ═══════════════════════════════════════ */
  .home-header.scrolled .home-nav-link { color: var(--gray-800); }
  .home-header.scrolled .home-nav-link:hover { color: var(--navy); background: var(--gray-50); }
  .home-header.scrolled .home-nav-link.active { color: var(--navy); text-decoration-color: var(--orange-ink); }

  .home-header.scrolled .home-mobile-toggle span { background: var(--navy); }

  /* Mega panels */
  .home-header.scrolled .hh-mega-inner {
    background: var(--white);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
