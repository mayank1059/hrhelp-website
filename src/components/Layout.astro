---
// Layout.astro — Wraps every page with consistent header + footer
import Header from './Header.astro';
import HomeHeader from './HomeHeader.astro';
import Footer from './Footer.astro';
import CookieConsent from './CookieConsent.astro';
import ChatAssistant from './ChatAssistant.astro';
import LeadAttribution from './LeadAttribution.astro';
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
  homeHeader?: boolean;
  ogImage?: string;
  schema?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description = 'Expert HR consulting for international companies in the Netherlands. Employment law, payroll, compliance, talent acquisition, all handled by Dutch HR experts.',
  homeHeader = false,
  ogImage = '/images/og-default.png',
  schema,
  noindex = false,
} = Astro.props;

// Force noindex on staging builds
const isStaging = import.meta.env.PUBLIC_STAGING === 'true';
const shouldNoindex = noindex || isStaging;

const siteUrl = 'https://www.hrhelp.nl';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const fullTitle = title.includes('HRHelp') ? title : `${title} | HRHelp.nl`;

// Base Organization schema (included on every page)
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "HRHelp.nl",
  "url": siteUrl,
  "logo": `${siteUrl}/favicon.svg`,
  "description": "Expert HR consulting for international companies in the Netherlands",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Oeverwalweg 3",
    "addressLocality": "Almere",
    "postalCode": "1332 CG",
    "addressCountry": "NL"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+31-85-760-8188",
    "contactType": "customer service",
    "email": "info@hrhelp.nl",
    "availableLanguage": ["English", "Dutch"]
  }
  // No "sameAs" until the company's real LinkedIn page URL is confirmed: the one listed
  // before (https://www.linkedin.com/company/hrhelp-nl) returns 404. Don't guess one.
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "HRHelp.nl",
  "url": siteUrl,
  "description": "Expert HR consulting for international companies in the Netherlands",
  "publisher": { "@type": "Organization", "name": "HRHelp.nl" }
};

// Combine all schemas
const allSchemas = [orgSchema, websiteSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Marks JS as available; scroll-reveal content stays visible without it -->
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Google tag (gtag.js) with Consent Mode v2 (advanced mode): analytics and ad storage stay
       denied (cookieless pings only) until the visitor chooses in the cookie banner (CookieConsent.astro).
       gtag() only queues commands in dataLayer; gtag.js (loaded below, never on staging) runs them in order. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
      analytics_storage: 'denied', functionality_storage: 'denied', personalization_storage: 'denied',
      security_storage: 'granted', wait_for_update: 500
    });
    gtag('set', 'ads_data_redaction', true);
    gtag('set', 'url_passthrough', true);
    // Stored choice in localStorage 'hrhelp_cookie_consent'. Version 2: {v, functional, analytics, marketing, timestamp}.
    // The old shape {essential, functional, timestamp} reads as version 1 with analytics/marketing not chosen.
    // A choice only counts ("current") while it is version 2 and under 12 months old; otherwise the banner asks again.
    window.hrhelpReadConsent = function () {
      try {
        var c = JSON.parse(localStorage.getItem('hrhelp_cookie_consent'));
        if (!c || typeof c !== 'object') return null;
        var v = c.v || 1;
        return {
          v: v,
          functional: c.functional === true,
          analytics: v >= 2 && c.analytics === true,
          marketing: v >= 2 && c.marketing === true,
          current: v === 2 && (Date.parse(c.timestamp) || 0) > Date.now() - 365 * 864e5
        };
      } catch (e) { return null; }
    };
    window.hrhelpApplyConsent = function (c) {
      function g(on) { return on ? 'granted' : 'denied'; }
      gtag('consent', 'update', {
        analytics_storage: g(c.analytics),
        ad_storage: g(c.marketing), ad_user_data: g(c.marketing), ad_personalization: g(c.marketing),
        functionality_storage: g(c.functional)
      });
    };
    (function () { var c = window.hrhelpReadConsent(); if (c && c.current) window.hrhelpApplyConsent(c); })();
    gtag('js', new Date());
    gtag('config', 'G-3PMP3P8VTF');
    gtag('config', 'AW-16843385395');
  </script>
  {!isStaging && (
    <script is:inline>
      // gtag.js is loaded once (GA4 ID) for both configs above, after the page has loaded so it
      // stays off the critical path; everything queued in dataLayer runs, in order, once it arrives.
      // Google's tag still fetches the Ads destination itself unless both IDs share one Google tag.
      (function () {
        function load() {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-3PMP3P8VTF';
          document.head.appendChild(s);
        }
        function whenIdle() {
          if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 1500 });
          else setTimeout(load, 200);
        }
        if (document.readyState === 'complete') whenIdle();
        else window.addEventListener('load', whenIdle, { once: true });
      })();
    </script>
  )}
  <meta name="description" content={description} />
  <meta name="robots" content={shouldNoindex ? 'noindex, nofollow' : 'index, follow'} />
  <title>{fullTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {!noindex && <link rel="canonical" href={canonicalUrl} />}

  <!-- Self-hosted fonts (globals.css): no Google Fonts request. Inter latin is used on every page. -->
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_NL" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={fullOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="HRHelp.nl" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOgImage} />

  <!-- Structured Data -->
  {allSchemas.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>
  {homeHeader ? <HomeHeader /> : <Header />}
  <main id="main">
    <slot />
  </main>
  <Footer />
  <!-- First-touch lead source for the contact form and the chatbot -->
  <LeadAttribution />
  <!-- First-party lead chatbot: no cookies, so no consent gate -->
  <ChatAssistant />
  <CookieConsent />
  <!-- Conversion tracking: CTA clicks -->
  <script is:inline>
    (function () {
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a.btn-primary, button.btn-primary') : null;
        if (a && typeof gtag === 'function') {
          gtag('event', 'cta_click', {
            cta_text: (a.textContent || '').trim().slice(0, 60),
            page_path: location.pathname,
          });
        }
      }, { passive: true });
    })();
  </script>
  <!-- Calendly bookings (the /contact "Pick a time" tab): GA4 + Ads conversion,
       and a relay of the two Calendly API URIs to the CRM, which fetches the details.
       Leads and Ads conversions only count on the production build. -->
  <script is:inline define:vars={{ IS_PROD: !isStaging }}>
    (function () {
      var seen = {};
      window.addEventListener('message', function (e) {
        if (e.origin !== 'https://calendly.com') return;
        if (!e.data || e.data.event !== 'calendly.event_scheduled') return;
        var payload = e.data.payload || {};
        var invitee = payload.invitee || {};
        var event = payload.event || {};
        var id = invitee.uri || event.uri ||
          'cal-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
        // One booking, one conversion, even if the embed posts the event twice.
        if (seen[id]) return;
        seen[id] = true;
        if (typeof gtag === 'function') {
          gtag('event', 'book_consultation', { page_path: location.pathname });
          if (IS_PROD) {
            gtag('event', 'generate_lead', { source: 'calendly' });
            gtag('event', 'conversion', {
              send_to: 'AW-16843385395/u4MnCPi347gcELPUxt8-',
              transaction_id: id
            });
          }
        }
        if (!invitee.uri || !event.uri) return;
        fetch('/api/calendly', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ invitee_uri: invitee.uri, event_uri: event.uri }),
          keepalive: true
        }).catch(function () {});
      });
    })();
  </script>
</body>
</html>
