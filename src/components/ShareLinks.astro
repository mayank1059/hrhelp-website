---
// Share buttons for articles and guides: LinkedIn, X, WhatsApp, email and
// copy link. The shared URL is the page's canonical URL (same as Layout).
// tone: "dark" = white outline icons for the navy hero, "light" = navy on white.
interface Props { title: string; tone?: 'dark' | 'light'; class?: string }
const { title, tone = 'light', class: className } = Astro.props;
const url = new URL(Astro.url.pathname, 'https://www.hrhelp.nl').toString();
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const links = [
  { label: 'Share on LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`, icon: 'linkedin' },
  { label: 'Share on X', href: `https://twitter.com/intent/tweet?url=${u}&text=${t}`, icon: 'x' },
  { label: 'Share on WhatsApp', href: `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`, icon: 'whatsapp' },
  { label: 'Share by email', href: `mailto:?subject=${t}&body=${u}`, icon: 'email' },
];
---
<div class:list={['share', `share--${tone}`, className]}>
  <slot />
  <ul class="share-list">
    {links.map(l => (
      <li>
        <a class="share-btn" href={l.href} target={l.icon === 'email' ? undefined : '_blank'} rel={l.icon === 'email' ? undefined : 'noopener'} aria-label={l.label} title={l.label}>
          {l.icon === 'linkedin' && <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0z"/></svg>}
          {l.icon === 'x' && <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64z"/></svg>}
          {l.icon === 'whatsapp' && <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.05 21.8h-.01a9.9 9.9 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.89 9.88zm8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41z"/></svg>}
          {l.icon === 'email' && <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3 6 9 7 9-7"/></svg>}
        </a>
      </li>
    ))}
    <li class="share-copy-item">
      <button type="button" class="share-btn share-copy" data-url={url} aria-label="Copy link" title="Copy link">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      </button>
      <span class="share-toast" role="status" aria-live="polite"></span>
    </li>
  </ul>
</div>

<script>
  // Copy link: Clipboard API, falling back to a hidden textarea + execCommand
  document.querySelectorAll<HTMLButtonElement>('.share-copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.url || location.href;
      let ok = false;
      try { await navigator.clipboard.writeText(url); ok = true; } catch {
        const ta = document.createElement('textarea');
        ta.value = url; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        try { ok = document.execCommand('copy'); } catch { ok = false; }
        ta.remove();
      }
      const toast = btn.parentElement?.querySelector<HTMLElement>('.share-toast');
      if (!toast) return;
      toast.textContent = ok ? 'Link copied' : 'Press Ctrl+C to copy';
      toast.classList.add('is-visible');
      clearTimeout(Number(toast.dataset.t));
      toast.dataset.t = String(window.setTimeout(() => { toast.classList.remove('is-visible'); toast.textContent = ''; }, 2000));
    });
  });
</script>

<style>
.share { display: flex; align-items: center; flex-wrap: wrap; gap: 0.75rem 1rem; }
.share-list { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
.share-copy-item { position: relative; }
.share-btn {
  display: inline-flex; align-items: center; justify-content: center;
  width: 40px; height: 40px; padding: 0;
  border-radius: 50%;
  border: 1px solid; background: transparent;
  cursor: pointer; text-decoration: none;
  transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}
.share--dark .share-btn { color: #fff; border-color: rgba(255, 255, 255, 0.35); }
.share--dark .share-btn:hover { background: rgba(255, 255, 255, 0.1); border-color: #fff; }
.share--dark .share-btn:focus-visible { outline: 2px solid var(--orange-light); outline-offset: 2px; }
.share--light .share-btn { color: var(--navy); border-color: rgba(15, 37, 72, 0.22); background: #fff; }
.share--light .share-btn:hover { border-color: var(--navy); background: #f6f7f9; }
.share-toast {
  position: absolute; bottom: calc(100% + 8px); left: 50%;
  transform: translate(-50%, 4px);
  white-space: nowrap;
  font-size: 0.78rem; font-weight: 600; line-height: 1;
  padding: 0.45rem 0.65rem; border-radius: 4px;
  background: var(--navy-dark); color: #fff;
  box-shadow: 0 4px 14px rgba(15, 37, 72, 0.2);
  opacity: 0; pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.share--dark .share-toast { background: #fff; color: var(--navy-dark); }
.share-toast.is-visible { opacity: 1; transform: translate(-50%, 0); }
@media (prefers-reduced-motion: reduce) { .share-btn, .share-toast { transition: none; } }
</style>
