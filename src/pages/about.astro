---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import LineIcon from '../components/LineIcon.astro';
import OfficeMap from '../components/OfficeMap.astro';
import { photo } from '../lib/servicePhotos';

const timeline = [
  { 
    year: '2019', 
    title: 'The Spark', 
    desc: 'Founded by two HR veterans who recognized a critical gap: international companies in the Netherlands lacked the specialized, high-touch support needed to navigate local complexity.' 
  },
  { 
    year: '2021', 
    title: 'The Network Evolution', 
    desc: 'Transitioned to a boutique network organisation. By collaborating with top-tier specialists across employment law, payroll, and talent strategy, we deliver elite expertise without the overhead of big-box firms.' 
  },
  { 
    year: '2025', 
    title: 'Strategic Partnership', 
    desc: 'Today, we serve as the trusted HR partner for modern enterprises, bridging the gap between global strategy and local Dutch compliance.' 
  }
];

const partners = [
  { icon: 'gavel', title: 'Legal & Compliance', desc: 'Expert Dutch employment law counsel for complex contracts and restructuring.' },
  { icon: 'payments', title: 'Payroll & Benefits', desc: 'Close cooperation with specialized Dutch payroll providers.' },
  { icon: 'psychology', title: 'Talent Strategy', desc: 'Behavioral psychologists and niche headhunters for critical hires.' },
  { icon: 'shield', title: 'Risk Management', desc: 'Insurance and health safety specialists ensuring workplace compliance.' }
];

const heroImage = photo('office-meeting');
// Cornelis's LinkedIn profile URL. The "Connect on LinkedIn" button stays hidden until a real
// profile URL is filled in here (it used to link to plain https://linkedin.com).
const founderLinkedIn = 'https://www.linkedin.com/in/cornelis-leerlooijer-4b99205/';
// LineIcon names for the partner cards (Material names kept in the data)
const iconName: Record<string, string> = { payments: 'euro' };

const stats = [
  { value: '20+', label: 'Years in HR' },
  { value: '75+', label: 'Clients Served' },
  { value: '100%', label: 'Dutch Compliance' },
  { value: '1 business day', label: 'Response Time' }
];
---

<Layout title="About Us" description="Founded in 2019 to humanize Dutch HR for international companies. Learn about our founder Cornelis Leerlooijer and our network of specialists.">

<!-- ===== HERO SECTON ===== -->
<PageHero variant="split" eyebrow="Our Story" subtitle={'Founded in 2019 on the principle that international businesses deserve better than "standard" HR. We combine senior experience with the flexibility of a specialist network.'} image={{ ...heroImage, alt: 'Strategic HR planning in Amsterdam' }}>
  <Fragment slot="title">Human Expertise. <br/><span>Strategic Network.</span></Fragment>
  <div class="ab2-hero-stats">
    {stats.map(stat => (
      <div class="ab2-hero-stat">
        <span class="ab2-stat-val">{stat.value}</span>
        <span class="ab2-stat-lbl">{stat.label}</span>
      </div>
    ))}
  </div>
  <a class="ab2-hero-founder" href="#founder">
    <img src="/images/home/cornelis-candid-face.jpg" alt="" width="320" height="320" loading="eager" decoding="async" />
    <span>
      <strong>Cornelis Leerlooijer</strong>
      <span>Founder &amp; Managing Director, over two decades in international HR</span>
    </span>
  </a>
  <div class="ab2-img-label" slot="media">
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
    <span>Almere Head Office</span>
  </div>
</PageHero>

<!-- ===== THE HRHELP APPROACH ===== -->
<section class="ab2-approach">
  <div class="container">
    <div class="ab2-approach-header">
      <h2>The HRHelp Approach</h2>
      <p>Our core values shape how we run the business every day.</p>
    </div>
    <div class="ab2-values-grid">
      <div class="ab2-value-card">
        <span class="ab2-value-num" aria-hidden="true">01</span>
        <h3>Transparency</h3>
        <p>No hidden fees, no ghosting. We keep communication channels open and honest at every step of the journey.</p>
      </div>
      <div class="ab2-value-card">
        <span class="ab2-value-num" aria-hidden="true">02</span>
        <h3>Empathy</h3>
        <p>We look beyond the resume. Understanding the human behind the candidate and the culture behind the company.</p>
      </div>
      <div class="ab2-value-card">
        <span class="ab2-value-num" aria-hidden="true">03</span>
        <h3>Speed</h3>
        <p>The business world moves fast, and so do we. Our agile processes are designed to keep pace with rapid growth.</p>
      </div>
      <div class="ab2-value-card">
        <span class="ab2-value-num" aria-hidden="true">04</span>
        <h3>Strategic Insight</h3>
        <p>Data-driven decisions that put people first. We combine analytics with intuition for the perfect match.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== THE JOURNEY (Timeline) ===== -->
<section class="ab2-journey section-navy">
  <div class="container">
    <div class="ab2-section-header">
      <h2 class="text-white">Our Evolution</h2>
      <p class="text-muted">From a vision to a specialized network of experts.</p>
    </div>

    <ol class="ab2-timeline">
      {timeline.map((step) => (
        <li class="ab2-timeline-item">
          <span class="ab2-year">{step.year}</span>
          <div class="ab2-time-content">
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ===== FOUNDER SPOTLIGHT ===== -->
<section class="ab2-founder" id="founder">
  <div class="container">
    <div class="ab2-founder-inner">
      <figure class="ab2-founder-image">
        <img src="/images/founder/cornelis-portrait.jpg" alt="Cornelis Leerlooijer - Founder" width="1600" height="2143" loading="lazy" decoding="async" />
        <figcaption class="ab2-founder-badge">
          <span>Founder & Managing Director</span>
        </figcaption>
      </figure>

      <div class="ab2-founder-text">
        <span class="ab2-eyebrow">Meet the Founder</span>
        <h2>Cornelis Leerlooijer</h2>
        <p class="ab2-founder-quote">"I saw first-hand how international companies struggled with the rigid nature of Dutch HR. We founded HRHelp.nl to provide a bridge: clear, strategic, and deeply localized support."</p>

        <div class="ab2-founder-bio">
          <p>With over two decades of experience in international HR, Cornelis built HRHelp.nl as an alternative to the traditional corporate consultancy model. He believes in direct access to senior expertise, full transparency, and results that make a real difference to your business.</p>
        </div>

        {founderLinkedIn && (
        <div class="ab2-founder-social">
          <a href={founderLinkedIn} target="_blank" rel="noopener" class="ab2-social-btn">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            <span>Connect on LinkedIn</span>
          </a>
        </div>
        )}
      </div>
    </div>
  </div>
</section>

<!-- ===== NETWORK ORGANIZATION SECTION ===== -->
<section class="ab2-network section-cream">
  <div class="container">
    <div class="ab2-grid-layout">
      <div class="ab2-network-text">
        <h2>The Best of <span>Both Worlds</span></h2>
        <p>We are a <strong>Network Organization</strong>. This means you get the intimacy and dedication of a boutique firm, backed by the comprehensive expertise of a large enterprise.</p>
        <p>By working with a selected network of partners, we make sure every challenge, from complex litigation to fast-growth hiring, is handled by a specialist in that field.</p>
      </div>

      <div class="ab2-partners-grid">
        {partners.map(p => (
          <div class="ab2-partner-card">
            <LineIcon name={iconName[p.icon] || p.icon} class="ab2-partner-icon" />
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>

      <figure class="ab2-team-photo">
        <img src="/images/about/cornelis-team.jpg" alt="Cornelis Leerlooijer, founder of HRhelp, with the HRhelp team at the office in Almere" width="1200" height="1490" loading="lazy" decoding="async" />
        <figcaption>Cornelis and the team, Almere office</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- ===== CONTACT / ADDRESS ===== -->
<section class="ab2-cta-address">
  <div class="container">
    <div class="ab2-cta-card">
      <div class="ab2-cta-info">
        <h2>Visit Us</h2>
        <p>Strategic HR guidance at the heart of the Netherlands.</p>
        <div class="ab2-address-item">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <div>
            <strong>Oeverwalweg 3</strong>
            <p>1332 CG, Almere, Netherlands</p>
          </div>
        </div>
        <div class="ab2-address-item">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="22 6 12 13 2 6"/></svg>
          <p>info@hrhelp.nl</p>
        </div>
        <div class="ab2-cta-btns">
          <a href="/contact/" class="btn btn-primary btn-lg">Book a Consultation</a>
        </div>
      </div>
      <div class="ab2-cta-map">
        <OfficeMap variant="panel" />
      </div>
    </div>
  </div>
</section>

</Layout>

<style>
/* Same sections and order; calmer treatment matching the service pages:
   shared light hero, documentary photos, hairline cards, numerals instead of
   icon tiles, one navy band (Our Evolution), light Visit Us panel. */
h2, h3 { font-weight: 700; letter-spacing: -0.015em; }

/* ===== HERO extras ===== */
.ab2-hero-stats {
  display: flex; flex-wrap: wrap; gap: 1.25rem 2.5rem;
  margin-top: 2.25rem; padding-top: 1.25rem;
  border-top: 1px solid rgba(15, 37, 72, 0.14);
}
.ab2-stat-val { display: block; font-size: 1.9rem; font-weight: 700; letter-spacing: -0.02em; color: var(--navy); line-height: 1.1; }
.ab2-stat-lbl { display: block; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #44546d; margin-top: 0.3rem; }
.ab2-hero-founder {
  display: inline-flex; align-items: center; gap: 0.85rem;
  margin-top: 1.75rem; padding: 0.6rem 1.1rem 0.6rem 0.6rem;
  background: white; border: 1px solid rgba(15, 37, 72, 0.12); border-radius: 999px;
  text-decoration: none; color: var(--navy); max-width: 100%;
}
.ab2-hero-founder:hover { border-color: rgba(15, 37, 72, 0.3); }
.ab2-hero-founder img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
.ab2-hero-founder strong { display: block; font-size: 1rem; line-height: 1.3; }
.ab2-hero-founder span span { display: block; font-size: 0.85rem; line-height: 1.4; color: var(--gray-600); }
@media (max-width: 480px) { .ab2-hero-founder { border-radius: 16px; } }
.ab2-img-label { display: flex; align-items: center; gap: 0.45rem; margin-top: 0.85rem; font-size: 0.88rem; font-weight: 600; color: var(--navy); }

/* ===== APPROACH ===== */
.ab2-approach { padding: 5.5rem 0; background: var(--white); }
.ab2-approach-header { margin-bottom: 2.5rem; }
.ab2-approach-header h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin-bottom: 0.5rem; }
.ab2-approach-header p { color: var(--gray-600); }
.ab2-values-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
.ab2-value-card {
  padding: 1.5rem;
  background: white;
  border: 1px solid rgba(15, 37, 72, 0.1);
  border-radius: 10px;
}
.ab2-value-num { display: block; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; color: var(--gray-500); margin-bottom: 1rem; font-variant-numeric: tabular-nums; }
.ab2-value-card h3 { font-size: 1.1rem; color: var(--navy); margin-bottom: 0.5rem; }
.ab2-value-card p { font-size: 0.92rem; line-height: 1.6; color: var(--gray-600); }

/* ===== JOURNEY (the page's one navy band) ===== */
.ab2-journey { padding: 5.5rem 0; }
.ab2-section-header { margin-bottom: 2.75rem; }
.ab2-section-header h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin-bottom: 0.5rem; }
.ab2-section-header p { color: rgba(255, 255, 255, 0.88); }
.ab2-timeline { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
.ab2-timeline-item { position: relative; padding-top: 1.5rem; border-top: 1px solid rgba(255, 255, 255, 0.2); }
.ab2-timeline-item::before { content: ''; position: absolute; top: -1px; left: 0; width: 32px; height: 2px; background: var(--orange); }
.ab2-year { display: block; font-size: 2.5rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1; color: white; margin-bottom: 1rem; font-variant-numeric: tabular-nums; }
.ab2-time-content h3 { font-size: 1.15rem; color: white; margin-bottom: 0.5rem; }
.ab2-time-content p { font-size: 0.95rem; line-height: 1.7; color: rgba(255, 255, 255, 0.88); }

/* ===== FOUNDER ===== */
.ab2-founder { padding: 5.5rem 0; background: var(--white); }
.ab2-founder-inner { display: grid; grid-template-columns: 5fr 7fr; gap: 4rem; align-items: center; }
/* Photo fills the height of the text column (floor 380px) instead of a fixed 4:5 */
.ab2-founder-image { margin: 0; align-self: stretch; display: flex; flex-direction: column; }
.ab2-founder-image img { flex: 1 1 0; min-height: 380px; width: 100%; height: auto; object-fit: cover; object-position: 50% 25%; border-radius: 4px; background: #e9edf2; }
.ab2-founder-badge { margin-top: 0.85rem; font-size: 0.88rem; font-weight: 600; color: var(--navy); }
.ab2-eyebrow { display: block; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #44546d; margin-bottom: 0.75rem; }
.ab2-founder-text h2 { font-size: clamp(1.8rem, 3.2vw, 2.4rem); margin-bottom: 1.5rem; }
.ab2-founder-quote {
  font-size: 1.2rem; font-weight: 500; line-height: 1.6; color: var(--navy);
  padding-left: 1.4rem; border-left: 3px solid var(--orange);
  margin-bottom: 1.5rem;
}
.ab2-founder-bio p { font-size: 1.02rem; line-height: 1.75; color: var(--gray-600); margin-bottom: 1.5rem; }
.ab2-social-btn {
  display: inline-flex; align-items: center; gap: 0.5rem;
  font-size: 0.92rem; font-weight: 600; color: var(--navy);
  text-decoration: underline; text-decoration-color: var(--orange-ink); text-underline-offset: 4px;
}
.ab2-social-btn:hover { color: var(--navy); text-decoration-thickness: 2px; }

/* ===== NETWORK ===== */
.ab2-network { padding: 5.5rem 0; }
.ab2-grid-layout { display: grid; grid-template-columns: 1.25fr 0.75fr; grid-template-rows: auto 1fr; gap: 2.5rem 4rem; align-items: start; }
.ab2-network-text, .ab2-partners-grid { grid-column: 1; }
.ab2-team-photo { grid-column: 2; grid-row: 1 / span 2; margin: 0; align-self: stretch; display: flex; flex-direction: column; }
.ab2-team-photo img { display: block; flex: 1 1 0; min-height: 400px; width: 100%; height: auto; object-fit: cover; object-position: 50% 30%; border-radius: 4px; background: #e9edf2; }
.ab2-team-photo figcaption { margin-top: 0.85rem; font-size: 0.88rem; font-weight: 600; color: var(--navy); }
.ab2-network-text h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin-bottom: 1.25rem; }
.ab2-network-text p { font-size: 1.02rem; line-height: 1.75; color: var(--gray-600); margin-bottom: 1rem; }
.ab2-network-text strong { color: var(--navy); }
.ab2-partners-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
.ab2-partner-card { padding: 1.5rem; background: white; border: 1px solid rgba(15, 37, 72, 0.1); border-radius: 10px; }
:global(.ab2-partner-icon) { color: var(--icon-accent); margin-bottom: 0.9rem; }
.ab2-partner-card h3 { font-size: 1.05rem; color: var(--navy); margin-bottom: 0.4rem; }
.ab2-partner-card p { font-size: 0.9rem; line-height: 1.6; color: var(--gray-600); }

/* ===== VISIT US: light panel ===== */
.ab2-cta-address { padding: 5.5rem 0; background: var(--white); }
.ab2-cta-card {
  display: grid; grid-template-columns: 1.1fr 0.9fr;
  background: #f6f7f9;
  border: 1px solid rgba(15, 37, 72, 0.08);
  border-radius: 12px;
  overflow: hidden;
}
.ab2-cta-info { padding: 3rem; }
.ab2-cta-info h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); margin-bottom: 0.5rem; }
.ab2-cta-info > p { color: var(--gray-600); margin-bottom: 1.75rem; }
.ab2-address-item { display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 1rem; color: var(--gray-700); }
.ab2-address-item svg { color: var(--icon-accent); flex-shrink: 0; margin-top: 0.2rem; }
.ab2-address-item strong { color: var(--navy); }
.ab2-address-item p { color: var(--gray-600); }
.ab2-cta-btns { margin-top: 1.75rem; }
.ab2-cta-map { display: flex; flex-direction: column; min-width: 0; background: white; border-left: 1px solid rgba(15, 37, 72, 0.08); }

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
  .ab2-values-grid { grid-template-columns: repeat(2, 1fr); }
  .ab2-founder-inner, .ab2-grid-layout { grid-template-columns: 1fr; gap: 2.5rem; }
  .ab2-founder-image { max-width: 420px; }
  .ab2-network-text, .ab2-partners-grid, .ab2-team-photo { grid-column: auto; grid-row: auto; }
  .ab2-team-photo { max-width: 420px; }
  .ab2-founder-image img, .ab2-team-photo img { flex: none; min-height: 0; aspect-ratio: 4 / 3; }
}
@media (max-width: 768px) {
  .ab2-approach, .ab2-journey, .ab2-founder, .ab2-network, .ab2-cta-address { padding: 4rem 0; }
  .ab2-values-grid, .ab2-partners-grid { grid-template-columns: 1fr; gap: 0.75rem; }
  .ab2-timeline { grid-template-columns: 1fr; gap: 2rem; }
  .ab2-year { font-size: 2rem; }
  .ab2-hero-stats { gap: 1rem 1.75rem; }
  .ab2-stat-val { font-size: 1.5rem; }
  .ab2-founder-quote { font-size: 1.05rem; }
  .ab2-cta-card { grid-template-columns: 1fr; }
  .ab2-cta-info { padding: 1.75rem 1.35rem; }
  .ab2-cta-map { border-left: 0; border-top: 1px solid rgba(15, 37, 72, 0.08); }
  .ab2-cta-btns .btn { width: 100%; justify-content: center; }
}

/* Mobile: cards keep a 1rem side padding inside the page gutter */
@media (max-width: 768px) {
  .ab2-cta-info,
  .ab2-partner-card,
  .ab2-value-card {
    padding-left: 1rem;
    padding-right: 1rem;
  }
  .ab2-founder-quote { padding-left: 1rem; }
}
</style>
