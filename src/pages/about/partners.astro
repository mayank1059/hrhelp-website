---
import Layout from '../../components/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import LineIcon from '../../components/LineIcon.astro';
import { photo } from '../../lib/servicePhotos';

const partnerTypes = [
  { icon: 'gavel', title: 'Legal & Compliance', desc: 'Boutique law firms specialized in Dutch labor law, collective bargaining, and international contract harmonization.' },
  { icon: 'payments', title: 'Payroll & Benefits', desc: 'Expert providers managing complex payroll cycles, pension schemes, and 30% ruling administration.' },
  { icon: 'person_search', title: 'Talent & Search', desc: 'Specialized recruiters and executive search partners focused on tech, finance, and industrial leadership.' },
  { icon: 'memory', title: 'Tech & Tooling', desc: 'HRIS implementation specialists and software partners who make HR processes more efficient.' },
];

const heroImage = photo('office-collaboration');
const introImage = photo('office-consultation');
// LineIcon names for the discipline cards (Material names kept in the data)
const iconName: Record<string, string> = { payments: 'euro', person_search: 'person', memory: 'tune' };

const stats = [
  { value: '15+', label: 'Trusted Partner Firms' },
  { value: '100%', label: 'Dutch Compliance' },
  { value: '6', label: 'Specialized Disciplines' },
  { value: '1 business day', label: 'Partner Response Time' },
];
---

<Layout title="Partners | Our Ecosystem" description="Discover the specialized partners that make up HRHelp.nl's network organization, each an expert in their HR field.">

<!-- ===== HERO ===== -->
<PageHero variant="split" eyebrow="The Network Model" subtitle={'We don\'t believe in "one size fits all." We curate the best specialists from across the Netherlands to serve your unique needs.'} image={{ ...heroImage, alt: 'Collaborative network partners at HRHelp.nl' }}>
  <Fragment slot="title">A Powerful Ecosystem <br/><span>of HR Specialists</span></Fragment>
  <div class="pt-hero-stats">
    {stats.map(stat => (
      <div class="pt-hero-stat">
        <span class="pt-stat-val">{stat.value}</span>
        <span class="pt-stat-lbl">{stat.label}</span>
      </div>
    ))}
  </div>
</PageHero>

<!-- ===== BEST OF BOTH WORLDS ===== -->
<section class="pt-intro">
  <div class="container">
    <div class="pt-intro-grid">
      <div class="pt-intro-text">
        <span class="eyebrow">Our Approach</span>
        <h2>The Best of <span>Both Worlds</span></h2>
        <p>By operating as a <strong>Network Organization</strong>, we offer our clients the agility and personal touch of a boutique firm, backed by the comprehensive expertise of a large enterprise.</p>
        <p>Our partners are vetted specialists who share our values of transparency, high standards, and human-centric HR. Together, we deliver solutions that no single firm could offer alone.</p>
      </div>
      <div class="pt-intro-visual">
        <img src={introImage.src} alt="Team mentorship at HRHelp.nl" width={introImage.width} height={introImage.height} loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

<!-- ===== PARTNER DISCIPLINES ===== -->
<section class="pt-disciplines section-cream">
  <div class="container">
    <div class="section-header pt-head">
      <span class="eyebrow">Specialized Disciplines</span>
      <h2>Expertise Through Deep Collaboration</h2>
      <p>Category leaders in every field of HR and employment services.</p>
    </div>
    <div class="pt-disciplines-grid">
      {partnerTypes.map(p => (
        <div class="pt-discipline-card">
          <LineIcon name={iconName[p.icon] || p.icon} class="pt-disc-icon" />
          <h3>{p.title}</h3>
          <p>{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="pt-cta-section">
  <div class="container">
    <div class="pt-cta-card">
      <div class="pt-cta-inner">
        <h2>Become a Network Partner</h2>
        <p>Are you a boutique firm or independent specialist in HR, Law, or Benefits? We're always looking to expand our ecosystem of excellence.</p>
        <a href="/contact/" class="btn btn-primary btn-lg">Inquire About Partnership</a>
      </div>
      <div class="pt-cta-photo">
        <img src="/images/home/cornelis-candid.jpg" alt="Cornelis Leerlooijer, founder of HRHelp" width="962" height="825" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

</Layout>

<style>
/* Same sections and order; calmer treatment: shared light hero, documentary
   photos, hairline cards with navy line icons, light CTA panel. */
h2, h3 { font-weight: 700; letter-spacing: -0.015em; }
.eyebrow { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; color: #44546d; margin-bottom: 0.75rem; }

.pt-hero-stats {
  display: flex; flex-wrap: wrap; gap: 1.25rem 2.5rem;
  margin-top: 2.25rem; padding-top: 1.25rem;
  border-top: 1px solid rgba(15, 37, 72, 0.14);
}
.pt-stat-val { display: block; font-size: 1.9rem; font-weight: 700; letter-spacing: -0.02em; color: var(--navy); line-height: 1.1; }
.pt-stat-lbl { display: block; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #44546d; margin-top: 0.3rem; }

.pt-intro { padding: 5.5rem 0; }
.pt-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
.pt-intro-text h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin-bottom: 1.25rem; }
.pt-intro-text p { font-size: 1.05rem; line-height: 1.8; color: var(--gray-600); margin-bottom: 1.1rem; }
.pt-intro-text strong { color: var(--navy); }
/* Photo fills the height of the text column (floor 320px) instead of a fixed 4:3 */
.pt-intro-visual { position: relative; align-self: stretch; min-height: 320px; }
.pt-intro-visual img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 4px; background: #e9edf2; }

.pt-disciplines { padding: 5.5rem 0; }
.pt-head { text-align: left; max-width: none; margin: 0 0 2.5rem; }
.pt-head h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin: 0 0 0.5rem; }
.pt-head p { color: var(--gray-600); font-size: 1rem; }
.pt-disciplines-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
.pt-discipline-card { padding: 1.6rem 1.5rem; background: white; border-radius: 10px; border: 1px solid rgba(15, 37, 72, 0.1); }
:global(.pt-disc-icon) { color: var(--icon-accent); margin-bottom: 1rem; }
.pt-discipline-card h3 { font-size: 1.1rem; color: var(--navy); margin-bottom: 0.5rem; }
.pt-discipline-card p { font-size: 0.92rem; line-height: 1.6; color: var(--gray-600); }

.pt-cta-section { padding: 5.5rem 0; }
.pt-cta-card {
  display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: 3rem; align-items: center;
  background: #f6f7f9; border: 1px solid rgba(15, 37, 72, 0.08); border-radius: 12px; padding: 2.75rem 3rem;
}
.pt-cta-card h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); color: var(--navy); margin-bottom: 0.9rem; }
.pt-cta-card p { color: var(--gray-600); font-size: 1.02rem; line-height: 1.7; margin-bottom: 1.75rem; max-width: 560px; }
/* Photo fills the height of the text column (floor 220px) in a fixed 22rem column, instead of a fixed square */
.pt-cta-photo { position: relative; align-self: stretch; min-height: 220px; }
.pt-cta-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 22%; border-radius: 4px; background: #e9edf2; }

@media (max-width: 1024px) {
  .pt-intro-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  .pt-intro-visual { max-width: 560px; min-height: 0; }
  .pt-intro-visual img { position: static; height: auto; aspect-ratio: 4 / 3; }
  .pt-disciplines-grid { grid-template-columns: repeat(2, 1fr); }
  .pt-cta-card { grid-template-columns: 1fr; gap: 2rem; }
  .pt-cta-photo { max-width: 360px; }
  .pt-cta-photo { min-height: 0; }
  .pt-cta-photo img { position: static; height: auto; aspect-ratio: 4 / 3; }
}
@media (max-width: 768px) {
  .pt-intro, .pt-disciplines, .pt-cta-section { padding: 4rem 0; }
  .pt-disciplines-grid { grid-template-columns: 1fr; gap: 0.75rem; }
  .pt-hero-stats { gap: 1rem 1.75rem; }
  .pt-stat-val { font-size: 1.5rem; }
  .pt-cta-card { padding: 1.75rem 1.35rem; }
  .pt-cta-card .btn { width: 100%; justify-content: center; }
}

/* Mobile: cards keep a 1rem side padding inside the page gutter */
@media (max-width: 768px) {
  .pt-discipline-card,
  .pt-cta-card {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}
</style>
