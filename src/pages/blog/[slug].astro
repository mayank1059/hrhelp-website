---
import Layout from '../../components/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import ArticleEnd from '../../components/ArticleEnd.astro';
import { addHeadingIds } from '../../lib/articleToc';
import { getBlogPosts, getBlogPost } from '../../lib/wordpress';
import { solutions, solutionBySlug } from '../../data/solutions.js';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map(p => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;
const post = await getBlogPost(slug as string);
if (!post) return Astro.redirect('/blog/');

// Get other posts for "Related Articles"
const allPosts = await getBlogPosts();
const relatedPosts = allPosts.filter(p => p.slug !== slug).slice(0, 2);

// Feature the solution that best matches the post's categories, otherwise keep fixed order.
const categoryText = (post.category || []).join(' ').toLowerCase();
const solutionMatches: [string, RegExp][] = [
  ['hr-sos', /sick|verzuim/],
  ['hr-teams', /hiring|recruit|team/],
  ['hr-settlers', /relocation|entity|settle/],
  ['hr-reset', /restructur|reset/],
];
const featuredSlug = (solutionMatches.find(([, re]) => re.test(categoryText)) || [])[0];
const orderedSolutions = featuredSlug
  ? [solutionBySlug[featuredSlug], ...solutions.filter(s => s.slug !== featuredSlug)]
  : solutions;

// h2 ids for the "On this page" navigation
const { html: articleHtml, toc } = addHeadingIds(post.content);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": post.excerpt,
  "image": post.image.startsWith('http') ? post.image : `https://www.hrhelp.nl${post.image}`,
  "author": {
    "@type": "Organization",
    "name": post.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "HRHelp.nl",
    "logo": { "@type": "ImageObject", "url": "https://www.hrhelp.nl/favicon.svg" }
  },
  // ISO 8601 from WordPress (post.date is the display form, "17 September 2026")
  "datePublished": post.datePublished || undefined,
  "dateModified": post.dateModified || post.datePublished || undefined,
  "mainEntityOfPage": `https://www.hrhelp.nl/blog/${slug}/`
};
---

<Layout title={`${post.title} | Blog`} description={post.excerpt} ogImage={post.image} schema={articleSchema}>

<!-- ===== HERO ===== -->
<ArticleHero title={post.title} dek={post.excerpt} pills={post.category} author={post.author}>
  <nav aria-label="Breadcrumb" slot="top">
    <a href="/">Home</a>
    <span class="bp-sep">›</span>
    <a href="/blog/">Blog</a>
  </nav>
  <span>{post.date}</span>
  {post.modified && post.modified !== post.date && (
    <>
      <span class="bp-dot">·</span>
      <span>Updated {post.modified}</span>
    </>
  )}
  <span class="bp-dot">·</span>
  <span>{post.readTime}</span>
</ArticleHero>

<!-- ===== CONTENT ===== -->
<section class="bp-content-section ah-body">
  <div class="container">
    <div class="bp-layout ah-layout">
      <div class="bp-main">
        <figure class="bp-feature ah-feature">
          <img src={post.image} alt={post.title} width="1024" height="576" loading="eager" fetchpriority="high" decoding="async" />
        </figure>
        <ArticleToc items={toc} variant="details" />
        <article class="bp-article ah-progress-target" set:html={articleHtml} />
        <ArticleEnd title={post.title} author={post.author} />
      </div>

      <aside class="bp-sidebar ah-sidebar">

        <div class="bp-sidebar-card">
          <h3>Need Help?</h3>
          <p>Our HR experts are ready to assist with any questions about Dutch employment law and HR management.</p>
          <a href="/contact/" class="btn btn-primary bp-sidebar-btn">Book a Consultation →</a>
        </div>

        <div class="bp-sidebar-card">
          <h3>How HRhelp can help</h3>
          <ul class="bp-sidebar-links">
            {orderedSolutions.map(sol => (
              <li><a href={`/solutions/${sol.slug}/`}>{sol.name}</a></li>
            ))}
          </ul>
          <a href="/contact/#book" class="btn btn-primary bp-sidebar-btn" style="margin-top: 1rem;">Book a Free Consultation</a>
        </div>

        <div class="bp-sidebar-card">
          <h3>Our Expertise</h3>
          <ul class="bp-sidebar-links">
            <li><a href="/expertise/leadership-training/">Leadership Training</a></li>
            <li><a href="/expertise/restructuring/">Restructuring</a></li>
            <li><a href="/expertise/sickness-management/">Sickness Management</a></li>
          </ul>
        </div>
        <ArticleToc items={toc} variant="card" />
      </aside>
    </div>
  </div>
</section>

<!-- ===== RELATED ARTICLES ===== -->
{relatedPosts.length > 0 && (
<section class="bp-related">
  <div class="container">
    <h2>Related Articles</h2>
    <div class="bp-related-grid">
      {relatedPosts.map(rp => (
        <PostCard
          href={`/blog/${rp.slug}/`}
          image={rp.image}
          alt={rp.title}
          width={1024}
          height={576}
          title={rp.title}
          heading="h3"
          date={rp.date}
          readTime={rp.readTime}
          tags={rp.tags}
        />
      ))}
    </div>
  </div>
</section>
)}

<!-- ===== BACK LINK ===== -->
<section class="bp-back">
  <div class="container">
    <a href="/blog/" class="btn btn-secondary">
      ← Back to All Articles
    </a>
  </div>
</section>

</Layout>

<style>
/* Calmer chrome around the WordPress content: shared article hero, the
   featured image as a plain figure, hairline cards, no navy bands. */
h2, h3 { font-weight: 700; letter-spacing: -0.015em; }

/* HERO (ArticleHero): meta separators on navy */
.bp-dot, .bp-sep { color: rgba(255, 255, 255, 0.4); }

/* CONTENT: grid, overlap and sticky sidebar come from ArticleHero (.ah-*);
   the text inside the column keeps a reading measure under the full-column image */
.bp-content-section { background: var(--white); }
.bp-main { min-width: 0; }
.bp-feature img {
  display: block;
  width: 100%; height: auto;
  aspect-ratio: 16 / 9; object-fit: cover;
  border-radius: 4px; background: #e9edf2;
  box-shadow: 0 2px 4px rgba(15, 37, 72, 0.06), 0 18px 48px rgba(15, 37, 72, 0.18);
}

.bp-article {
  font-size: 1.125rem; line-height: 1.8;
  color: var(--gray-700);
  /* Same width as the featured image above it */
  min-width: 0;
}
.bp-article :global(h2) {
  font-size: 1.5rem; font-weight: 700;
  color: var(--navy); margin: 2.5rem 0 1rem;
  padding-bottom: 0.6rem;
  border-bottom: 1px solid rgba(15, 37, 72, 0.14);
}
.bp-article :global(h2:first-child) { margin-top: 0; }
.bp-article :global(h3) { font-size: 1.2rem; margin: 1.75rem 0 0.6rem; }
.bp-article :global(p) { font-size: inherit; margin-bottom: 1.25rem; }
.bp-article :global(ul), .bp-article :global(ol) { margin: 1rem 0 1.5rem; padding-left: 1.4rem; }
.bp-article :global(li) { margin-bottom: 0.5rem; }
.bp-article :global(li::marker) { color: var(--gray-500); }
.bp-article :global(strong) { color: var(--navy); }
.bp-article :global(a) { color: var(--navy); font-weight: 600; text-decoration: underline; text-decoration-color: var(--orange-ink); text-underline-offset: 3px; }
.bp-article :global(a:hover) { color: var(--navy); text-decoration-thickness: 2px; }
.bp-article :global(figure) { margin: 2.25rem 0; }
.bp-article :global(figure img), .bp-article :global(img) { max-width: 100%; height: auto; border-radius: 10px; display: block; }
.bp-article :global(figcaption) { margin-top: 0.6rem; font-size: 0.875rem; color: var(--gray-500); }
.bp-article :global(table) { width: 100%; border-collapse: collapse; margin: 1.25rem 0 1.75rem; font-size: 0.95rem; display: block; overflow-x: auto; }
.bp-article :global(th), .bp-article :global(td) { padding: 0.6rem 0.75rem; border-bottom: 1px solid rgba(15, 37, 72, 0.12); text-align: left; vertical-align: top; }

.bp-sidebar { display: flex; flex-direction: column; gap: 1rem; }
.bp-sidebar-card {
  background: white; border-radius: 12px;
  padding: 1.5rem; border: 1px solid rgba(15, 37, 72, 0.1);
}
.bp-sidebar-card:first-of-type { background: #f6f7f9; }
.bp-sidebar-card h3 { font-size: 1.02rem; color: var(--navy); margin-bottom: 0.75rem; }
.bp-sidebar-card p { font-size: 0.9rem; color: var(--gray-600); line-height: 1.6; margin-bottom: 1rem; }
.bp-sidebar-btn { width: 100%; justify-content: center; text-align: center; }
.bp-sidebar-links { list-style: none; padding: 0; margin: 0; }
.bp-sidebar-links a {
  display: block;
  font-size: 0.9rem; font-weight: 600; color: var(--navy);
  text-decoration: none; padding: 0.55rem 0;
  border-bottom: 1px solid rgba(15, 37, 72, 0.1);
}
.bp-sidebar-links a:hover { text-decoration: underline; text-decoration-color: var(--orange-ink); text-underline-offset: 3px; }

/* RELATED */
.bp-related { padding: 4.5rem 0; background: var(--cream); }
.bp-related h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); margin-bottom: 2rem; }
.bp-related-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; max-width: 860px; --post-card-ratio: 4 / 3; }

.bp-back { padding: 2.5rem 0 3.5rem; background: var(--cream); }

@media (max-width: 992px) {
  .bp-related-grid { grid-template-columns: 1fr; max-width: 520px; }
}
@media (max-width: 768px) {
  .bp-article { font-size: 1rem; line-height: 1.75; }
  .bp-article :global(h2) { font-size: 1.25rem; margin: 1.75rem 0 0.75rem; }
  .bp-article :global(ul), .bp-article :global(ol) { padding-left: 1.25rem; }
  .bp-sidebar-card { padding: 1.25rem; }
  .bp-related { padding: 3rem 0; }
  .bp-back { padding: 2rem 0 3rem; }
  .bp-back .btn { width: 100%; justify-content: center; }
}

/* Mobile: cards keep a 1rem side padding inside the page gutter */
@media (max-width: 768px) {
  .bp-sidebar-card {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}
</style>
