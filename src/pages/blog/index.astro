---
import Layout from '../../components/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import { getBlogPosts, clip } from '../../lib/wordpress';

const posts = await getBlogPosts();
---

<Layout title="Blog & Insights" description="Expert articles, guides, and insights on Dutch employment law, HR strategy, and managing international teams in the Netherlands.">

<!-- ===== HERO ===== -->
<PageHero variant="archive" eyebrow="Knowledge & Insights" subtitle="Expert guides, practical insights, and essential updates on Dutch employment law and international HR management.">
  <Fragment slot="title">HR <span>Blog</span></Fragment>
</PageHero>

<!-- ===== BLOG GRID ===== -->
<section class="blog-section">
  <div class="container">
    <div class="blog-grid">
      {posts.map((post, i) => (
        <PostCard
          href={`/blog/${post.slug}/`}
          image={post.image}
          alt={post.title}
          width={1024}
          height={576}
          loading={i < 3 ? 'eager' : 'lazy'}
          title={post.title}
          heading="h2"
          headingClass="as-h3"
          date={post.date}
          readTime={post.readTime}
          excerpt={clip(post.excerpt)}
          tags={post.tags}
        />
      ))}
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="blog-cta">
  <div class="container">
    <div class="blog-cta-inner">
      <div>
        <h2>Need Expert HR Advice?</h2>
        <p>Our team is ready to help you navigate Dutch employment law and build a compliant, thriving workforce.</p>
        <a href="/contact/" class="btn btn-primary btn-lg">Get in Touch →</a>
      </div>
      <div class="blog-cta-photo">
        <img src="/images/home/cornelis-candid.jpg" alt="Cornelis Leerlooijer, founder of HRHelp" width="962" height="825" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

</Layout>

<style>
/* Shared hero, image-overlay post cards (PostCard), light CTA panel. */
h2 { font-weight: 700; letter-spacing: -0.015em; }

.blog-section { padding: 4.5rem 0 5rem; background: var(--white); }
.blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }

.blog-cta { padding: 0 0 5.5rem; background: var(--white); }
.blog-cta-inner {
  display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: 3rem; align-items: center;
  background: #f6f7f9; border: 1px solid rgba(15, 37, 72, 0.08); border-radius: 12px; padding: 2.75rem 3rem;
}
.blog-cta h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); color: var(--navy); margin-bottom: 0.9rem; }
.blog-cta p { color: var(--gray-600); max-width: 520px; line-height: 1.7; margin-bottom: 1.75rem; }
/* Photo fills the height of the text column (floor 220px) in a fixed 22rem column, instead of a fixed square */
.blog-cta-photo { position: relative; align-self: stretch; min-height: 220px; }
.blog-cta-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 22%; border-radius: 4px; background: #e9edf2; }

@media (max-width: 1024px) {
  .blog-grid { grid-template-columns: repeat(2, 1fr); }
  .blog-cta-inner { grid-template-columns: 1fr; gap: 2rem; }
  .blog-cta-photo { max-width: 360px; }
  .blog-cta-photo { min-height: 0; }
  .blog-cta-photo img { position: static; height: auto; aspect-ratio: 4 / 3; }
}
@media (max-width: 768px) {
  .blog-section { padding: 2.5rem 0 3.5rem; }
  .blog-grid { grid-template-columns: 1fr; gap: 1rem; --post-card-ratio: 1 / 1; }
  .blog-cta { padding: 0 0 4rem; }
  .blog-cta-inner { padding: 1.75rem 1.35rem; }
  .blog-cta .btn { width: 100%; justify-content: center; }
}

/* Mobile: cards keep a 1rem side padding inside the page gutter */
@media (max-width: 768px) {
  .blog-cta-inner {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}
</style>
