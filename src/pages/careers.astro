---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import LineIcon from '../components/LineIcon.astro';
import { photo } from '../lib/servicePhotos';
import { getJobOpenings } from '../lib/wordpress';

const benefits = [
  { icon: 'hub', title: 'Network Model', desc: 'Work as a specialist in our agile network organisation, not a cog in a machine. Your expertise drives impact.' },
  { icon: 'rocket_launch', title: 'High Impact', desc: 'Directly shape the success of international companies scaling their operations in the Netherlands.' },
  { icon: 'psychology', title: 'Continuous Growth', desc: 'Learn from senior consultants with 15+ years of international HR and employment law experience.' },
  { icon: 'balance', title: 'True Flexibility', desc: 'Outcome-focused work environment with professional autonomy and flexible scheduling.' },
];

const openings = await getJobOpenings();
const heroImage = photo('office-informal');
// No JobPosting markup on this list of openings: Google only accepts it on a job's own page
// (careers/apply/[slug].astro carries it).
---

<Layout title="Careers | Join the Network" description="Join HRHelp.nl as a specialized HR consultant or network partner. Shape the future of Dutch HR for international companies.">

<!-- ===== HERO ===== -->
<PageHero variant="split" eyebrow="Join Our Team" subtitle="We are a network organisation of senior experts. Whether you're a specialist consultant or a growing HR talent, there's a place for you in our ecosystem." image={{ ...heroImage, alt: 'HR team collaboration at HRHelp.nl' }}>
  <Fragment slot="title">Shape the Future of <br/><span>HR in the Netherlands</span></Fragment>
  <div class="page-hero-actions">
    <a href="#openings" class="btn btn-primary btn-lg">View Open Roles</a>
    <a href="/about/" class="btn btn-secondary btn-lg">About HRHelp</a>
  </div>
</PageHero>

<!-- ===== WHY JOIN ===== -->
<section class="cr-benefits">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Why HRHelp.nl?</span>
      <h2>The Advantages of Our Network</h2>
      <p>The personal attention of a boutique firm with the reach of a wide network.</p>
    </div>
    <div class="cr-benefits-grid">
      {benefits.map((b, i) => (
        <div class="cr-benefit-card">
          <span class="cr-benefit-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{b.title}</h3>
          <p>{b.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== OPENINGS ===== -->
<section class="cr-openings section-cream" id="openings">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Open Positions</span>
      <h2>Currently Looking For...</h2>
      <p>We hire for both internal roles and our network of project-based specialists.</p>
    </div>
    {openings.length > 0 ? (
      <div class="cr-openings-list">
        {openings.map(o => (
          <div class="cr-opening-card">
            <div class="cr-opening-top">
              <div class="cr-opening-info">
                <h3>{o.title}</h3>
                <div class="cr-opening-meta">
                  <span class="cr-tag">{o.type}</span>
                  <span class="cr-location">
                    <LineIcon name="location_on" size={16} />
                    {o.location}
                  </span>
                </div>
              </div>
              <a href={`/careers/apply/${o.slug}/`} class="btn btn-primary btn-sm cr-apply-btn">
                Apply Now
                <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
            {o.description && (
              <div class="cr-opening-desc">
                <div class="cr-desc-content" set:html={o.description} />
              </div>
            )}
          </div>
        ))}
      </div>
    ) : (
      <div class="cr-no-openings">
        <p>No open positions at the moment. Check back soon or join our talent pool below.</p>
      </div>
    )}
  </div>
</section>

<!-- ===== TALENT POOL CTA ===== -->
<section class="cr-talent">
  <div class="container">
    <div class="cr-talent-card">
      <div class="cr-talent-inner">
        <h2>Don't See Your Role?</h2>
        <p>We're always building our network of specialised partners: legal, payroll, coaching, talent strategy, and more. Introduce yourself.</p>
        <a href="/contact/" class="btn btn-primary btn-lg">Join the Network</a>
      </div>
      <div class="cr-talent-photo">
        <img src="/images/home/cornelis-candid.jpg" alt="Cornelis Leerlooijer, founder of HRHelp" width="962" height="825" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

</Layout>

<style>
/* Same sections and order; calmer treatment: shared light hero with a
   documentary photo, numerals instead of icon tiles, hairline cards without
   hover lift, light talent panel. JobPosting schema unchanged. */
h2, h3 { font-weight: 700; letter-spacing: -0.015em; }
.eyebrow { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; color: #44546d; margin-bottom: 0.75rem; }
.cr-benefits .section-header, .cr-openings .section-header { text-align: left; max-width: 760px; margin: 0 0 2.5rem; }
.cr-benefits .section-header h2, .cr-openings .section-header h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin: 0 0 0.5rem; }
.cr-benefits .section-header p, .cr-openings .section-header p { color: var(--gray-600); font-size: 1rem; }

/* ===== BENEFITS ===== */
.cr-benefits { padding: 5.5rem 0; }
.cr-benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
.cr-benefit-card { padding: 1.6rem 1.5rem; background: white; border-radius: 10px; border: 1px solid rgba(15, 37, 72, 0.1); }
.cr-benefit-num { display: block; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; color: var(--gray-500); margin-bottom: 1rem; font-variant-numeric: tabular-nums; }
.cr-benefit-card h3 { font-size: 1.1rem; color: var(--navy); margin-bottom: 0.5rem; }
.cr-benefit-card p { font-size: 0.92rem; line-height: 1.6; color: var(--gray-600); }

/* ===== OPENINGS ===== */
.cr-openings { padding: 5.5rem 0; }
.cr-openings-list { display: flex; flex-direction: column; gap: 1rem; }
.cr-opening-card {
  background: white; border-radius: 12px;
  border: 1px solid rgba(15, 37, 72, 0.1);
  box-shadow: 0 1px 2px rgba(15, 37, 72, 0.04), 0 4px 14px rgba(15, 37, 72, 0.04);
  overflow: hidden;
}
.cr-opening-top { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; padding: 1.75rem 2rem; }
.cr-opening-info h3 { margin-bottom: 0.4rem; font-size: 1.25rem; color: var(--navy); }
.cr-opening-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 0.4rem 1.25rem; }
.cr-tag { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #44546d; }
.cr-location { display: flex; align-items: center; gap: 0.35rem; font-size: 0.9rem; color: var(--gray-600); }
.cr-location :global(svg) { color: var(--icon-accent); }
.cr-apply-btn { display: inline-flex !important; align-items: center; gap: 0.4rem; white-space: nowrap; flex-shrink: 0; }
.cr-opening-desc { border-top: 1px solid rgba(15, 37, 72, 0.08); padding: 1.5rem 2rem 1.75rem; }
.cr-opening-desc :global(h2), .cr-opening-desc :global(h3), .cr-opening-desc :global(h4) { font-size: 1.05rem; font-weight: 700; color: var(--navy); margin: 1.25rem 0 0.5rem; }
.cr-opening-desc :global(h2:first-child), .cr-opening-desc :global(h3:first-child), .cr-opening-desc :global(h4:first-child) { margin-top: 0; }
.cr-opening-desc :global(p) { font-size: 0.95rem; line-height: 1.7; color: var(--gray-600); margin-bottom: 0.75rem; }
.cr-opening-desc :global(ul), .cr-opening-desc :global(ol) { padding-left: 1.4rem; margin-bottom: 1rem; }
.cr-opening-desc :global(li) { font-size: 0.95rem; line-height: 1.7; color: var(--gray-600); margin-bottom: 0.25rem; }
.cr-opening-desc :global(strong) { color: var(--navy); }
.cr-no-openings { padding: 2.5rem 2rem; background: white; border-radius: 12px; border: 1px dashed rgba(15, 37, 72, 0.2); }
.cr-no-openings p { color: var(--gray-600); font-size: 1.02rem; }

/* ===== TALENT CTA: light panel ===== */
.cr-talent { padding: 5.5rem 0; }
.cr-talent-card {
  display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: 3rem; align-items: center;
  background: #f6f7f9; border: 1px solid rgba(15, 37, 72, 0.08); border-radius: 12px; padding: 2.75rem 3rem;
}
.cr-talent-card h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); color: var(--navy); margin-bottom: 0.9rem; }
.cr-talent-card p { color: var(--gray-600); font-size: 1.02rem; line-height: 1.7; margin-bottom: 1.75rem; max-width: 560px; }
/* Photo fills the height of the text column (floor 220px) in a fixed 22rem column, instead of a fixed square */
.cr-talent-photo { position: relative; align-self: stretch; min-height: 220px; }
.cr-talent-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 22%; border-radius: 4px; background: #e9edf2; }

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
  .cr-benefits-grid { grid-template-columns: repeat(2, 1fr); }
  .cr-talent-card { grid-template-columns: 1fr; gap: 2rem; }
  .cr-talent-photo { max-width: 360px; }
  .cr-talent-photo { min-height: 0; }
  .cr-talent-photo img { position: static; height: auto; aspect-ratio: 4 / 3; }
}
@media (max-width: 768px) {
  .cr-benefits, .cr-openings, .cr-talent { padding: 4rem 0; }
  .cr-benefits-grid { grid-template-columns: 1fr; gap: 0.75rem; }
  .cr-opening-top { flex-direction: column; align-items: flex-start; padding: 1.4rem 1.25rem; gap: 1rem; }
  .cr-opening-desc { padding: 1.25rem; }
  .cr-talent-card { padding: 1.75rem 1.35rem; }
  .cr-talent-card .btn { width: 100%; justify-content: center; }
}

/* Mobile: cards keep a 1rem side padding inside the page gutter */
@media (max-width: 768px) {
  .cr-benefit-card,
  .cr-opening-top,
  .cr-opening-desc,
  .cr-talent-card {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}
</style>
