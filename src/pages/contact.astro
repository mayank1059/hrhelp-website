---
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import LineIcon from '../components/LineIcon.astro';
import OfficeMap from '../components/OfficeMap.astro';
import { HELP_NEEDED, EMPLOYEES_NL, TIMELINE, PREFERRED_CONTACT, QUALITY_IMMIGRATION } from '../lib/enquiry';

const qiUrl = QUALITY_IMMIGRATION('contact');
// Lead and Ads conversion events only count on the production build.
const IS_PROD = import.meta.env.PUBLIC_STAGING !== 'true';


const channels = [
  { icon: 'mail', title: 'Email Us', value: 'info@hrhelp.nl', href: 'mailto:info@hrhelp.nl', desc: 'For general inquiries, partnerships, and project proposals.' },
  { icon: 'phone_in_talk', title: 'Call Us', value: '+31 85 760 8188', href: 'tel:+31857608188', desc: 'Direct line for urgent HR consultation and immediate support.' },
  { icon: 'schedule', title: 'Business Hours', value: 'Mon – Fri, 08:30 – 18:00', href: null, desc: 'Central European Time (CET). We respond within one business day.' },
];

const faqs = [
  { q: 'How quickly can you start supporting our company?', a: 'For urgent needs, we arrange an initial consultation within one business day. Full project onboarding typically begins within 5 business days, depending on scope.' },
  { q: 'Do you support companies outside the Netherlands?', a: 'Yes. While we specialize in Dutch employment law, our network of partners covers the EU and UK for cross-border employment matters, expat onboarding, and 30% ruling applications.' },
  { q: 'What does a typical engagement look like?', a: 'We offer retainer-based advisory for ongoing support, and fixed-price projects for specific needs like restructuring, compliance audits, or recruitment campaigns. Every engagement starts with a free consultation.' },
  { q: 'Are you a traditional HR consultancy?', a: 'No. We are a network organisation: a boutique firm that works with specialised partners to cover every HR discipline, from legal to payroll to talent strategy.' },
];

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact HRHelp.nl",
  "description": "Get in touch with HRHelp.nl for specialized HR support in the Netherlands.",
  "mainEntity": {
    "@type": "Organization",
    "name": "HRHelp.nl",
    "telephone": "+31-85-760-8188",
    "email": "info@hrhelp.nl",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Oeverwalweg 3",
      "addressLocality": "Almere",
      "postalCode": "1332 CG",
      "addressCountry": "NL"
    }
  }
};
---

<Layout title="Contact Us" description="Get in touch with HRHelp.nl for specialized HR support for international companies in the Netherlands. Free consultation, Almere office." schema={contactSchema}>

<!-- ===== HERO ===== -->
<PageHero variant="archive" eyebrow="Get In Touch" subtitle="Whether you're entering the Dutch market, restructuring your team, or need expert compliance guidance, our senior consultants are ready to help.">
  <Fragment slot="title">Let's Build Your <br/><span>HR Strategy</span></Fragment>
  <div class="page-hero-actions">
    <a href="#book" class="btn btn-primary btn-lg">Book Free Consultation</a>
    <a href="tel:+31857608188" class="btn btn-secondary btn-lg">
      <LineIcon name="call" size={18} />
      +31 85 760 8188
    </a>
  </div>

  <div class="ct2-hero-stats">
    <div class="ct2-hero-stat">
      <span class="ct2-stat-val">1 business day</span>
      <span class="ct2-stat-lbl">Response Time</span>
    </div>
    <div class="ct2-hero-stat">
      <span class="ct2-stat-val">Free</span>
      <span class="ct2-stat-lbl">Initial Consult</span>
    </div>
    <div class="ct2-hero-stat">
      <span class="ct2-stat-val">100%</span>
      <span class="ct2-stat-lbl">Confidential</span>
    </div>
    <div class="ct2-hero-stat">
      <span class="ct2-stat-val">NL</span>
      <span class="ct2-stat-lbl">Native Experts</span>
    </div>
  </div>
</PageHero>

<!-- ===== ENQUIRY FORM / CALENDLY (two tabs) + SIDEBAR =====
     id="book" stays on this section: the site-wide "Book a Free Consultation"
     CTAs link to /contact#book and land on the form tab (default).
     /contact?book=calendar and /contact#calendar open the "Pick a time" tab.
     Calendly (third party, sets cookies) only loads once that tab is opened. -->
<section class="ct2-main" id="book">
  <div class="container">
    <div class="ct2-grid">
      <div class="ct2-primary">
        <span class="eyebrow">Fastest Way to Start</span>
        <h2>Book Your Free <span class="ct2-nowrap">30-Minute</span> Consultation</h2>
        <p class="ct2-lead">Tell us what you need and a senior consultant replies within one business day, or pick a time for a free 30-minute call straight away. Fixed pricing, no obligation.</p>
        <div class="ct2-book-trust">
          <span><LineIcon name="schedule" size={18} />30 minutes</span>
          <span><LineIcon name="videocam" size={18} />Online or by phone</span>
          <span><LineIcon name="lock" size={18} />100% confidential</span>
          <span><LineIcon name="euro" size={18} />Fixed pricing, agreed upfront</span>
        </div>

        <p class="ct2-jobseeker">
          <strong>Looking for a job or a work visa?</strong> HRhelp works with employers only. Our partner
          <a href={qiUrl} target="_blank" rel="noopener">Quality Immigration<span class="ct2-vh"> (opens in a new tab)</span></a>
          helps individuals with work permits and relocation.
        </p>

        <div class="ct2-switch">
          <div class="ct2-tabs" role="tablist" aria-label="How would you like to book?">
            <button type="button" class="ct2-tab" role="tab" id="ct2-tab-form" aria-controls="ct2-panel-form" aria-selected="true">Send a message</button>
            <button type="button" class="ct2-tab" role="tab" id="ct2-tab-cal" aria-controls="calendar" aria-selected="false" aria-describedby="ct2-cal-note" tabindex="-1">Pick a time</button>
          </div>
          <p class="ct2-tab-note" id="ct2-cal-note">Opens Calendly's booking calendar.</p>
        </div>

        <div class="ct2-panel" role="tabpanel" id="ct2-panel-form" aria-labelledby="ct2-tab-form">
        <form id="contact-form" class="ct2-form">
          <fieldset class="ct2-set">
            <legend>What do you need help with?<span class="ct2-hint">Optional, pick one or more</span></legend>
            <div class="ct2-chips">
              {HELP_NEEDED.map((n) => (
                <label class="ct2-chip"><input type="checkbox" name="needs" value={n} /><span>{n}</span></label>
              ))}
            </div>
          </fieldset>

          <fieldset class="ct2-set">
            <legend>Employees in the Netherlands <span class="ct2-opt">(optional)</span></legend>
            <div class="ct2-chips">
              {EMPLOYEES_NL.map((n) => (
                <label class="ct2-chip"><input type="radio" name="employees" value={n} /><span>{n}</span></label>
              ))}
            </div>
          </fieldset>

          <fieldset class="ct2-set">
            <legend>When do you need help? <span class="ct2-opt">(optional)</span></legend>
            <div class="ct2-chips">
              {TIMELINE.map((n) => (
                <label class="ct2-chip"><input type="radio" name="timeline" value={n} /><span>{n}</span></label>
              ))}
            </div>
          </fieldset>

          <div class="ct2-form-row">
            <div class="ct2-form-group">
              <label for="ct2-company">Company <span class="ct2-opt">(optional)</span></label>
              <input type="text" id="ct2-company" name="company" autocomplete="organization" maxlength="160" />
            </div>
            <div class="ct2-form-group">
              <label for="ct2-name">Full Name *</label>
              <input type="text" id="ct2-name" name="name" autocomplete="name" maxlength="120" required />
            </div>
          </div>
          <div class="ct2-form-row">
            <div class="ct2-form-group">
              <label for="ct2-email">Work email *</label>
              <input type="email" id="ct2-email" name="email" autocomplete="email" maxlength="200" required />
            </div>
            <div class="ct2-form-group">
              <label for="ct2-phone">Phone <span class="ct2-opt">(optional)</span></label>
              <input type="tel" id="ct2-phone" name="phone" autocomplete="tel" maxlength="40" />
            </div>
          </div>

          <fieldset class="ct2-set">
            <legend>How should we get in touch? <span class="ct2-opt">(optional)</span></legend>
            <div class="ct2-chips">
              {PREFERRED_CONTACT.map((n) => (
                <label class="ct2-chip"><input type="radio" name="preferred_contact" value={n} /><span>{n}</span></label>
              ))}
            </div>
          </fieldset>

          <div class="ct2-form-group">
            <label for="ct2-message">Anything else we should know? <span class="ct2-opt">(optional)</span></label>
            <textarea id="ct2-message" name="message" placeholder="Tell us about your situation..." rows="4" maxlength="5000"></textarea>
          </div>
          <!-- Honeypot: off-screen and out of the tab order, so only bots fill it.
               A non-empty url_confirm makes /api/contact drop the submission. -->
          <div aria-hidden="true" style="position:absolute; left:-9999px; top:-9999px; width:1px; height:1px; overflow:hidden;">
            <label for="ct2-url-confirm">Your website</label>
            <input type="text" id="ct2-url-confirm" name="url_confirm" tabindex="-1" autocomplete="off" />
          </div>
          <div class="ct2-form-check">
            <input type="checkbox" id="privacy" name="privacy" required />
            <label for="privacy">I agree to the <a href="/privacy/" target="_blank" rel="noopener">Privacy Policy</a></label>
          </div>
          <div id="form-status" class="ct2-status" role="status" aria-live="polite" hidden></div>
          <button type="submit" id="form-submit-btn" class="btn btn-primary btn-lg ct2-submit">Send Message</button>
        </form>
        <div id="ct2-done" class="ct2-done" tabindex="-1" hidden>
          <LineIcon name="check" size={28} />
          <div>
            <p class="ct2-done-title" id="ct2-done-title">Thanks, we have your message.</p>
            <p>Cornelis or one of the team will get back to you within one business day.</p>
          </div>
        </div>
        </div>

        <div class="ct2-panel" role="tabpanel" id="calendar" aria-labelledby="ct2-tab-cal" tabindex="-1" hidden>
          <div class="ct2-cal-frame" id="ct2-cal-frame"></div>
          <p class="ct2-book-fallback">Calendar slow to load? <a href="https://calendly.com/hrhelp-info/30min" target="_blank" rel="noopener">Open the booking calendar</a> in a new tab.</p>
        </div>
      </div>

      <aside class="ct2-side" aria-label="What happens next and how to reach us">
        <figure class="ct2-photo">
          <img src="/images/contact/cornelis-client-meeting.jpg" alt="Cornelis Leerlooijer of HRhelp in a consultation with a client" width="1200" height="1490" loading="eager" decoding="async" />
        </figure>

        <div class="ct2-next">
          <h3>What happens next</h3>
          <ol>
            <li><span class="ct2-num">1</span><p>We read your answers.</p></li>
            <li><span class="ct2-num">2</span><p>Cornelis or the team replies within one business day.</p></li>
            <li><span class="ct2-num">3</span><p>A free 30-minute call, if that is useful.</p></li>
          </ol>
        </div>

        <div class="ct2-direct">
          <h2 class="as-h3 ct2-side-title">Send Us a Message</h2>
          <p class="ct2-side-desc">Prefer to write or call directly? We respond within one business day.</p>
          <ul class="ct2-channels">
            {channels.map((ch) => (
              <li>
                <LineIcon name={ch.icon} size={18} />
                <div>
                  <h2 class="as-h3 ct2-ch-title">{ch.title}</h2>
                  {ch.href ? <a href={ch.href}>{ch.value}</a> : <span class="ct2-ch-value">{ch.value}</span>}
                  <p>{ch.desc}</p>
                </div>
              </li>
            ))}
            <li>
              <LineIcon name="location_on" size={18} />
              <div>
                <span class="ct2-ch-value">Oeverwalweg 3</span>
                <p>1332 CG, Almere, Netherlands</p>
              </div>
            </li>
          </ul>
        </div>

        <OfficeMap variant="inline" class="ct2-map" />
      </aside>
    </div>
  </div>

<script is:inline define:vars={{ IS_PROD }}>
(function() {
  var form = document.getElementById('contact-form');
  if (!form) return;
  var needs = form.querySelectorAll('[name="needs"]');

  function checked(name) {
    var el = form.querySelector('[name="' + name + '"]:checked');
    return el ? el.value : '';
  }
  function chosenNeeds() {
    return Array.prototype.filter.call(needs, function(n) { return n.checked; }).map(function(n) { return n.value; });
  }
  // At least one help topic: the browser's own validation bubble on the first chip.
  function syncNeeds() {
    needs[0].setCustomValidity('');
  }
  Array.prototype.forEach.call(needs, function(n) { n.addEventListener('change', syncNeeds); });
  syncNeeds();

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    syncNeeds();
    if (!form.reportValidity()) return;

    var btn = document.getElementById('form-submit-btn');
    var status = document.getElementById('form-status');
    var originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Sending...';
    status.hidden = true;
    var submitId = 'cf-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);

    // Same fields as the website chatbot; /api/contact maps both identically
    // into the CRM lead and the team alert email.
    var data = {
      name: form.querySelector('[name="name"]').value.trim(),
      email: form.querySelector('[name="email"]').value.trim(),
      company: form.querySelector('[name="company"]').value.trim(),
      phone: form.querySelector('[name="phone"]').value.trim(),
      needs: chosenNeeds(),
      employees: checked('employees'),
      timeline: checked('timeline'),
      preferred_contact: checked('preferred_contact'),
      message: form.querySelector('[name="message"]').value.trim(),
      page: location.pathname,
      source: 'Contact Form',
      url_confirm: form.querySelector('[name="url_confirm"]').value
    };
    // First-touch lead source (utm_*, click ids, referrer host, landing page)
    if (window.hrhelpAttribution) Object.assign(data, window.hrhelpAttribution());

    function fail(msg) {
      if (typeof gtag === 'function') gtag('event', 'lead_error', { source: 'contact_form' });
      status.hidden = false;
      status.className = 'ct2-status is-error';
      status.textContent = msg;
      btn.disabled = false;
      btn.textContent = originalText;
    }

    fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
    .then(function(res) { return res.json(); })
    .then(function(result) {
      if (!result.success) {
        fail(result.message || 'Something went wrong. Please try again or email us at info@hrhelp.nl');
        return;
      }
      // Staging builds never count leads or Google Ads conversions. The Ads
      // conversion is the one Calendly bookings used to fire; transaction_id
      // lets Google Ads drop a duplicate of the same submit.
      if (IS_PROD && typeof gtag === 'function') {
        gtag('event', 'generate_lead', { source: 'contact_form' });
        gtag('event', 'conversion', {
          send_to: 'AW-16843385395/u4MnCPi347gcELPUxt8-',
          transaction_id: submitId
        });
      }
      // Terminal state: the message is in, so swap the form for the confirmation.
      var done = document.getElementById('ct2-done');
      document.getElementById('ct2-done-title').textContent = 'Thanks, ' + data.name.split(/\s+/)[0] + '.';
      form.hidden = true;
      done.hidden = false;
      done.focus();
    })
    .catch(function() {
      fail('Network error. Please try again or email us at info@hrhelp.nl');
    });
  });
})();
</script>

<!-- Two-option switch: accessible tabs; Calendly loads only when "Pick a time"
     is opened. Booking tracking + the CRM relay live in Layout.astro. -->
<script is:inline>
(function() {
  var tabs = [document.getElementById('ct2-tab-form'), document.getElementById('ct2-tab-cal')];
  if (!tabs[0] || !tabs[1]) return;
  var CAL_URL = 'https://calendly.com/hrhelp-info/30min?hide_event_type_details=1&primary_color=f47920';
  var calLoaded = false;

  function loadCalendly() {
    if (calLoaded) return;
    calLoaded = true;
    var frame = document.getElementById('ct2-cal-frame');
    // Desktop: fixed 700px. Mobile: starts at 700px, then Calendly reports its
    // page height and sets the frame's height to match (auto height).
    var resize = window.matchMedia('(max-width: 768px)').matches;
    var css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = 'https://assets.calendly.com/assets/external/widget.css';
    document.head.appendChild(css);
    var s = document.createElement('script');
    s.src = 'https://assets.calendly.com/assets/external/widget.js';
    s.async = true;
    s.onload = function() {
      if (window.Calendly && Calendly.initInlineWidget) {
        frame.classList.add('calendly-inline-widget');
        Calendly.initInlineWidget({ url: CAL_URL, parentElement: frame, resize: resize });
      }
    };
    document.head.appendChild(s);
  }

  function select(i, focus) {
    tabs.forEach(function(t, j) {
      var on = i === j;
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
    });
    if (focus) tabs[i].focus();
    if (i === 1) loadCalendly();
  }

  tabs.forEach(function(t, i) {
    t.addEventListener('click', function() { select(i, false); });
    t.addEventListener('keydown', function(e) {
      var n = null;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') n = (i + 1) % tabs.length;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') n = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') n = 0;
      else if (e.key === 'End') n = tabs.length - 1;
      if (n === null) return;
      e.preventDefault();
      select(n, true);
    });
  });

  // Deep links: /contact?book=calendar or /contact#calendar open the calendar tab.
  function wantsCalendar() {
    return location.hash === '#calendar' || new URLSearchParams(location.search).get('book') === 'calendar';
  }
  function openFromUrl() {
    if (!wantsCalendar()) return;
    select(1, false);
    document.getElementById('book').scrollIntoView();
  }
  openFromUrl();
  window.addEventListener('hashchange', function() {
    if (location.hash === '#calendar') openFromUrl();
  });
})();
</script>
</section>

<!-- ===== FAQ ===== -->
<section class="ct2-faq">
  <div class="container">
    <div class="ct2-section-header">
      <h2>Frequently Asked Questions</h2>
      <p>Quick answers to common questions about working with us.</p>
    </div>
    <div class="ct2-faq-list">
      {faqs.map((faq) => (
        <details class="ct2-faq-item">
          <summary>
            <span>{faq.q}</span>
          </summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

</Layout>

<style>
/* Shared light hero, then one two-column block: the enquiry form (the primary
   action, same questions as the website chatbot) and a calm sidebar with the
   photo, next steps, direct contact and the map. Hairlines, 4px radii, no cards. */
h2, h3 { font-weight: 700; letter-spacing: -0.015em; }
.eyebrow { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; color: #44546d; margin-bottom: 0.75rem; }

/* ===== HERO extras ===== */
.ct2-hero-stats {
  display: flex; flex-wrap: wrap; gap: 1.25rem 2.5rem;
  margin-top: 2.25rem; padding-top: 1.25rem;
  border-top: 1px solid rgba(15, 37, 72, 0.14);
}
.ct2-stat-val { display: block; font-size: 1.9rem; font-weight: 700; letter-spacing: -0.02em; color: var(--navy); line-height: 1.1; }
.ct2-stat-lbl { display: block; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #44546d; margin-top: 0.3rem; }

/* ===== ENQUIRY FORM + SIDEBAR ===== */
.ct2-main { padding: 5rem 0; background: white; }
.ct2-grid {
  display: grid;
  grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
  gap: 4rem;
  align-items: stretch;
}
.ct2-primary h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); color: var(--navy); margin: 0 0 0.75rem; }
/* Keeps "30-Minute" on one line on phones instead of breaking after the hyphen */
.ct2-nowrap { white-space: nowrap; }
/* 39.1em is the old 62ch in Inter; ch follows the font, so the line re-wrapped when Inter loaded */
.ct2-lead { color: var(--gray-600); font-size: 1.05rem; line-height: 1.7; margin: 0 0 1.25rem; max-width: 39.1em; }
.ct2-book-trust {
  display: flex; flex-wrap: wrap; gap: 0.6rem 1.75rem;
  margin: 0 0 2rem; font-size: 0.92rem; color: var(--gray-600);
}
.ct2-book-trust span { display: inline-flex; align-items: center; gap: 0.45rem; }
.ct2-book-trust :global(svg) { color: var(--icon-accent); }

.ct2-jobseeker {
  margin: 0 0 2rem; padding: 0.9rem 1rem;
  border: 1px solid rgba(15, 37, 72, 0.12); border-left: 3px solid var(--orange);
  border-radius: 4px; font-size: 0.92rem; line-height: 1.6; color: var(--gray-700);
}
.ct2-jobseeker strong { color: var(--navy); }
.ct2-jobseeker a, .ct2-form-check a, .ct2-channels a {
  color: var(--navy); font-weight: 600; text-decoration: underline;
  text-decoration-color: var(--orange-ink); text-underline-offset: 3px;
}
.ct2-vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* Two-option switch: pill segmented control (active = navy fill) */
.ct2-switch { margin: 0 0 2rem; }
.ct2-tabs { display: inline-flex; flex-wrap: wrap; gap: 0.5rem; }
.ct2-tab {
  min-height: 44px; padding: 0.6rem 1.35rem;
  border: 1px solid var(--navy); border-radius: var(--radius-full);
  background: white; color: var(--navy);
  font-family: var(--font-body); font-size: 0.95rem; font-weight: 600; line-height: 1.2;
  cursor: pointer; transition: background 0.15s ease, color 0.15s ease;
}
.ct2-tab:hover { background: rgba(26, 58, 110, 0.06); }
.ct2-tab[aria-selected="true"] { background: var(--navy); color: white; }
.ct2-tab:focus-visible { outline: 3px solid var(--orange); outline-offset: 2px; }
.ct2-tab-note { margin: 0.6rem 0 0; font-size: 0.85rem; color: var(--gray-500); }
.ct2-panel[hidden] { display: none; }
.ct2-panel:focus { outline: none; }
.ct2-cal-frame {
  position: relative; height: 700px; min-width: 0;
  border: 1px solid rgba(15, 37, 72, 0.12); border-radius: 12px; overflow: hidden; background: white;
  isolation: isolate;
}
.ct2-cal-frame :global(iframe) { display: block; }
.ct2-book-fallback { margin: 1rem 0 0; font-size: 0.92rem; color: var(--gray-600); }
.ct2-book-fallback a {
  color: var(--navy); font-weight: 600; text-decoration: underline;
  text-decoration-color: var(--orange-ink); text-underline-offset: 3px;
}

/* Form: sits on the section, no card */
.ct2-form { display: flex; flex-direction: column; gap: 1.5rem; }
.ct2-form[hidden], .ct2-status[hidden] { display: none; }
.ct2-set { border: 0; margin: 0; padding: 0; min-width: 0; }
.ct2-set legend, .ct2-form-group label {
  display: block; padding: 0; margin-bottom: 0.6rem;
  font-size: 0.9rem; font-weight: 600; color: var(--navy);
}
.ct2-hint, .ct2-opt { font-weight: 400; color: var(--gray-500); }
