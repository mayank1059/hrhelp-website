            <span class={`guide-severity guide-severity-${pitfall.severity}`}>{pitfall.severity}</span>
          </div>
          <h3>{pitfall.title}</h3>
          <p>{pitfall.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
)}

<!-- ===== FAQ ===== -->
{page.faqs && page.faqs.length > 0 && (
<section class="guide-faq">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow" style={`color: ${vc.text};`}>Common Questions</span>
      <h2>Frequently Asked Questions</h2>
    </div>
    <div class="guide-faq-list">
      {page.faqs.map((faq: any) => (
        <details class="guide-faq-item">
          <summary>
            <span>{faq.q}</span>
            <svg class="guide-faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="guide-faq-answer">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
)}

<!-- ===== RELATED GUIDES ===== -->
{relatedPages.length > 0 && (
<section class="guide-related">
  <div class="container">
    <div class="section-header">
      <h2>Related Guides</h2>
    </div>
    <div class="guide-related-grid">
      {relatedPages.map((rp: any) => (
        <a href={`/guides/${rp.slug}`} class="guide-related-card">
          <div class="guide-related-badge" style={`background: ${verticalColors[rp.vertical]?.bg || vc.bg}; color: ${verticalColors[rp.vertical]?.text || vc.text};`}>
            {rp.verticalLabel}
          </div>
          <h3>{rp.title}</h3>
          <p>{rp.subtitle}</p>
          <span class="guide-related-link" style={`color: ${verticalColors[rp.vertical]?.text || vc.text};`}>Read Guide →</span>
        </a>
      ))}
    </div>
  </div>
</section>
)}

<!-- ===== CTA ===== -->
<section class="guide-cta-section">
  <div class="guide-cta-bg">
    <img src={ctaImage} alt="" loading="lazy" />
  </div>
  <div class="container" style="position:relative; z-index:2;">
    <div class="guide-cta-inner">
      {showEmployeeReferral ? (
      <div class="guide-cta-content">
        <span class="eyebrow" style="color: var(--orange-light);">For Individuals</span>
        <h2>Need help with your own visa or 30% ruling?</h2>
        <p>Our partner platform Quality Immigration advises individuals on work visas, residence permits, HSM applications and the 30% ruling, from start to finish.</p>
        <div class="guide-cta-buttons">
          <a href="https://quality-immigration.com/?utm_source=hrhelp&utm_medium=referral&utm_campaign=guides" target="_blank" rel="noopener" class="btn btn-primary btn-lg" onclick="typeof gtag==='function'&&gtag('event','referral_quality_immigration',{page_path:location.pathname})">Go to Quality Immigration</a>
          <a href="/contact" class="btn btn-ghost btn-lg">I'm an employer, talk to HRhelp</a>
        </div>
      </div>
      ) : (
      <div class="guide-cta-content">
        <span class="eyebrow" style="color: var(--orange-light);">Need Help?</span>
        <h2>Ready to get started with {page.parentServiceName}?</h2>
        <p>Book a free 30-minute consultation. We'll assess your situation and propose a clear path forward — no commitment required.</p>
        <div class="guide-cta-buttons">
          <a href="/contact" class="btn btn-primary btn-lg">Book a Consultation</a>
          <a href={page.parentService} class="btn btn-ghost btn-lg">Learn about {page.parentServiceName}</a>
        </div>
      </div>
      )}
    </div>
  </div>
</section>

</Layout>

<!-- TABLE OF CONTENTS SCRIPT -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const article = document.querySelector('.guide-article');
    const tocNav = document.getElementById('guide-toc');
    if (!article || !tocNav) return;

    const headings = article.querySelectorAll('h2');
    if (headings.length === 0) return;

    headings.forEach((h, i) => {
      const id = `section-${i}`;
      h.id = id;
      const link = document.createElement('a');
      link.href = `#${id}`;
      link.textContent = h.textContent || '';
      link.className = 'guide-toc-link';
      tocNav.appendChild(link);
    });

    // Active state on scroll
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          tocNav.querySelectorAll('.guide-toc-link').forEach(link => {
            link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
          });
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });

    headings.forEach(h => observer.observe(h));

    // Inject mid-article image after the 2nd H2
    if (headings.length >= 3) {
      const targetH2 = headings[2];
      const imgWrapper = document.createElement('div');
      imgWrapper.className = 'guide-article-img';
      const slug = window.location.pathname.split('/').filter(Boolean).pop();
      imgWrapper.innerHTML = `<img src="/images/guides/hero-${slug}.png" alt="" loading="lazy" />`;
      targetH2.parentNode?.insertBefore(imgWrapper, targetH2);
    }
  });
</script>

<style>
/* ===== HERO ===== */
.guide-hero {
  padding: 9rem 0 4rem;
  background: var(--navy);
  color: white;
  position: relative;
  overflow: hidden;
}
