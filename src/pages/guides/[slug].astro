---
import Layout from '../../components/Layout.astro';
import ServiceLinks from '../../components/ServiceLinks.astro';
import CtaBand from '../../components/CtaBand.astro';
import { guidePhotos } from '../../lib/guidePhotos';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import ArticleEnd from '../../components/ArticleEnd.astro';
import { addHeadingIds } from '../../lib/articleToc';
import { solutionBySlug } from '../../data/solutions.js';
import { servicesForSolution } from '../../data/pseo/service-groups.js';
import CoreExpertiseLinks from '../../components/CoreExpertiseLinks.astro';
import { expertiseForSlug } from '../../data/expertiseLinks.js';

// Guide data, pre-filtered to client-approved guides (all guides on staging).
import { settlersData, teamsData, sosData } from '../../data/pseo/guides.js';

// Combine all pages into a single lookup
const allPages = [
  ...settlersData,
  ...teamsData,
  ...sosData,
  // ...lawData,
];

const pageMap = new Map(allPages.map(p => [p.slug, p]));

export function getStaticPaths() {
  const pages = [
    ...settlersData,
    ...teamsData,
    ...sosData,
    // ...lawData,
  ];
  return pages.map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const page = pageMap.get(slug);
if (!page) return Astro.redirect('/guides/');

// Find related pages
const relatedPages = (page.relatedSlugs || [])
  .map((s: string) => pageMap.get(s))
  .filter(Boolean)
  .slice(0, 3);

// Guides that rank for employee/expat-intent queries (visa, 30% ruling, permits).
// These readers are not HRhelp's audience; refer them to the sister platform.
const EMPLOYEE_REFERRAL_SLUGS = new Set([
  '30-percent-ruling-application-2026',
  'work-permits-visa-sponsorship-netherlands',
  'expat-employee-management-netherlands',
]);
const showEmployeeReferral = EMPLOYEE_REFERRAL_SLUGS.has(slug);

// Cross-link this guide's vertical to the matching solution package and its services.
// Employee-referral guides keep the sister-site referral instead.
const crossSolution = solutionBySlug[page.vertical] || null;
const crossServices = crossSolution ? servicesForSolution(crossSolution.slug).slice(0, 3) : [];
// Core expertise pages matching the guide's topic (keywords in the slug, data/expertiseLinks.js)
const expertiseSlugs = expertiseForSlug(slug);

// Documentary photos instead of the generated per-guide renders (see src/lib/guidePhotos.ts)
const photos = guidePhotos(allPages.findIndex(p => p.slug === slug));
// h2 ids for the "In This Guide" navigation
const { html: articleHtml, toc } = addHeadingIds(page.content);
const ctaImage = { src: '/images/home/cornelis-candid.jpg', width: 962, height: 825 };

const guideSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": page.title,
  "description": page.subtitle,
  "author": {
    "@type": "Organization",
    "name": "HRHelp.nl",
    "url": "https://www.hrhelp.nl"
  },
  "publisher": {
    "@type": "Organization",
    "name": "HRHelp.nl",
    "logo": { "@type": "ImageObject", "url": "https://www.hrhelp.nl/favicon.svg" }
  },
  "mainEntityOfPage": `https://www.hrhelp.nl/guides/${slug}/`,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.hrhelp.nl" },
      { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://www.hrhelp.nl/guides/" },
      { "@type": "ListItem", "position": 3, "name": page.title, "item": `https://www.hrhelp.nl/guides/${slug}/` }
    ]
  }
};

// FAQ Schema
const faqSchema = page.faqs && page.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": page.faqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
} : null;
---

<Layout title={`${page.title} | HRHelp.nl`} description={page.subtitle} schema={guideSchema}>

{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

<!-- ===== HERO ===== -->
<ArticleHero title={page.title} dek={page.subtitle} pills={[page.verticalLabel]}>
  <nav class="guide-breadcrumb" aria-label="Breadcrumb" slot="top">
    <a href="/">Home</a>
    <span class="bc-sep">›</span>
    <a href="/guides/">Guides</a>
    <span class="bc-sep">›</span>
    <span class="bc-current">{page.title}</span>
  </nav>
  <span class="guide-meta-item">
    <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
    {page.readTime}
  </span>
  <span class="guide-meta-sep">·</span>
  <a href={page.parentService} class="guide-meta-link">
    <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    Part of {page.parentServiceName}
  </a>
</ArticleHero>

<!-- ===== MAIN CONTENT: at-a-glance facts (overlapping the hero), employee
     referral, article; sidebar with the section navigation ===== -->
<section class="guide-content-section ah-body">
  <div class="container">
    <div class="guide-layout ah-layout">
      <div class="guide-main">
        <div class="guide-glance ah-feature">
          <div class="guide-glance-grid">
            {page.atAGlance.map((item: any) => (
              <div class="guide-glance-card">
                <div class="guide-glance-content">
                  <span class="guide-glance-label">{item.label}</span>
                  <span class="guide-glance-value">{item.value}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        {showEmployeeReferral && (
        <div class="emp-referral">
    <div class="emp-referral-card">
      <div class="emp-referral-head">
        <span class="emp-referral-eyebrow">Are you an employee or expat?</span>
        <h2 class="as-h3">This guide is for employers. For your personal visa or 30% ruling, go here instead:</h2>
      </div>
      <div class="emp-referral-body">
        <a href="https://quality-immigration.com/?utm_source=hrhelp&utm_medium=referral&utm_campaign=guides" target="_blank" rel="noopener" class="emp-referral-logo" onclick="typeof gtag==='function'&&gtag('event','referral_quality_immigration',{page_path:location.pathname})">
          <img src="/images/partners/quality-immigration-logo.svg" alt="Quality Immigration" loading="lazy" />
        </a>
        <div class="emp-referral-text">
          <p><strong>Quality Immigration</strong> is our official partner platform for individuals: work visas, residence permits, HSM applications and the 30% ruling, handled personally from start to finish.</p>
          <p class="emp-referral-note">HRhelp advises companies only and cannot take on individual immigration cases.</p>
        </div>
        <a href="https://quality-immigration.com/?utm_source=hrhelp&utm_medium=referral&utm_campaign=guides" target="_blank" rel="noopener" class="emp-referral-btn" onclick="typeof gtag==='function'&&gtag('event','referral_quality_immigration',{page_path:location.pathname})">
          Book your immigration consultation
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg>
        </a>
      </div>
    </div>
        </div>
        )}

        <ArticleToc items={toc} variant="details" label="In This Guide" />
        <article class="guide-article ah-progress-target" data-article-img={photos.article.src} data-article-w={photos.article.width} data-article-h={photos.article.height} set:html={articleHtml} />
        <ArticleEnd title={page.title} />
      </div>

      <aside class="guide-sidebar ah-sidebar">

        <!-- CTA Card (routes to partner on employee-magnet guides) -->
        {showEmployeeReferral ? (
        <div class="guide-sidebar-card guide-cta-sidebar emp-sidebar-cta">
          <img src="/images/partners/quality-immigration-logo.svg" alt="Quality Immigration" class="emp-sidebar-logo" loading="lazy" />
          <h3>Applying for yourself?</h3>
          <p>Visas, permits and the 30% ruling for individuals are handled by our partner platform Quality Immigration.</p>
          <a href="https://quality-immigration.com/?utm_source=hrhelp&utm_medium=referral&utm_campaign=guides" target="_blank" rel="noopener" class="btn btn-primary emp-sidebar-btn" style="width:100%; text-align:center;" onclick="typeof gtag==='function'&&gtag('event','referral_quality_immigration',{page_path:location.pathname})">Book an Immigration Consultation →</a>
        </div>
        ) : (
        <div class="guide-sidebar-card guide-cta-sidebar">
          <h3>Need Expert Help?</h3>
          <p>Our HR specialists can guide you through every step of this process.</p>
          <a href="/contact/" class="btn btn-primary" style="width:100%; text-align:center;">Book a Consultation →</a>
        </div>
        )}

        <!-- Parent Service Card -->
        <div class="guide-sidebar-card">
          <h3>{page.parentServiceName}</h3>
          <p>This guide is part of our {page.parentServiceName} service: full HR support for companies in the Netherlands.</p>
          <a href={page.parentService} class="guide-sidebar-link">Learn about {page.parentServiceName} →</a>
        </div>
        <!-- Table of Contents (h2 ids added at build time) -->
        <ArticleToc items={toc} variant="card" label="In This Guide">
          <h3 slot="heading">In This Guide</h3>
        </ArticleToc>
      </aside>
    </div>
  </div>
</section>

<!-- ===== PROCESS STEPS ===== -->
{page.process && page.process.length > 0 && (
<section class="guide-process">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">How It Works</span>
      <h2>Step-by-Step Process</h2>
    </div>
    <div class="guide-process-grid">
      {page.process.map((step: any) => (
        <div class="guide-process-card">
          <div class="guide-process-num">{step.step}</div>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
)}

<!-- ===== KEY INSIGHTS: IMAGE-RICH SECTION ===== -->
<section class="guide-insights">
  <div class="container">
    <div class="guide-insights-top">
      <div class="guide-insights-img-left">
        <img src={photos.insight.src} alt={`${page.title}, key insight`} loading="lazy" decoding="async" width={photos.insight.width} height={photos.insight.height} />
      </div>
      <div class="guide-insights-content">
        <span class="eyebrow">Why It Matters</span>
        <h2>Key Insights for Your Business</h2>
        <div class="guide-insights-stats">
          <div class="guide-insight-stat">
            <div>
              <span class="guide-insight-stat-value">93%</span>
              <span class="guide-insight-stat-label">of companies report smoother operations with proper HR setup</span>
            </div>
          </div>
          <div class="guide-insight-stat">
            <div>
              <span class="guide-insight-stat-value">€25K+</span>
              <span class="guide-insight-stat-label">average savings from avoiding common compliance penalties</span>
            </div>
          </div>
          <div class="guide-insight-stat">
            <div>
              <span class="guide-insight-stat-value">4–6 weeks</span>
              <span class="guide-insight-stat-label">to fully operational with expert guidance vs. 3+ months DIY</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="guide-insights-bottom">
      <div class="guide-insights-quote">
        <blockquote>
          <p>"Having the right HR infrastructure in place from day one saved us months of fixing problems later. It's the foundation everything else builds on."</p>
          <cite>HR Director, International Company in NL</cite>
        </blockquote>
      </div>
      <div class="guide-insights-img-right">
        <img src={photos.inline.src} alt={`${page.title}, results`} loading="lazy" decoding="async" width={photos.inline.width} height={photos.inline.height} />
      </div>
    </div>
  </div>
</section>

<!-- ===== KEY CONSIDERATIONS / PITFALLS ===== -->
{page.pitfalls && page.pitfalls.length > 0 && (
<section class="guide-pitfalls">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Important Considerations</span>
      <h2>What to Watch Out For</h2>
    </div>
    <div class="guide-pitfalls-grid">
      {page.pitfalls.map((pitfall: any) => (
        <div class="guide-pitfall-card">
          <div class="guide-pitfall-header">
            <span class={`guide-severity guide-severity-${pitfall.severity}`}>{pitfall.severity}</span>
          </div>
          <h3>{pitfall.title}</h3>
          <p>{pitfall.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
)}

<!-- ===== FAQ ===== -->
{page.faqs && page.faqs.length > 0 && (
<section class="guide-faq">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Common Questions</span>
      <h2>Frequently Asked Questions</h2>
    </div>
    <div class="guide-faq-list">
      {page.faqs.map((faq: any) => (
        <details class="guide-faq-item">
          <summary>
            <span>{faq.q}</span>
            <svg aria-hidden="true" class="guide-faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="guide-faq-answer">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
)}

<!-- ===== RELATED SOLUTION AND SERVICES ===== -->
{!showEmployeeReferral && crossSolution && (
<section class="guide-crosslink">
  <div class="container">
    <div class="guide-crosslink-card">
      <span class="guide-crosslink-eyebrow">Related solution and services</span>
      <h2>How HRhelp handles this in practice</h2>
      <a href={`/solutions/${crossSolution.slug}/`} class="guide-crosslink-solution">
        <span class="guide-crosslink-sol-name">{crossSolution.name}</span>
        <span class="guide-crosslink-sol-tagline">{crossSolution.tagline}</span>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      {crossServices.length > 0 && (
        <div class="guide-crosslink-services">
          <span class="guide-crosslink-label">Specialist services</span>
          <ServiceLinks items={crossServices} variant="chips" />
        </div>
      )}
      {expertiseSlugs.length > 0 && (
        <div class="guide-crosslink-expertise"><CoreExpertiseLinks slugs={expertiseSlugs} /></div>
      )}
      <div class="guide-crosslink-cta">
        <CtaBand
          heading="Want this handled for you?"
          text="Talk it through with a senior Dutch HR consultant in a free 30 minute call."
          secondaryLabel="View all HR services"
          secondaryHref="/services/"
        />
      </div>
    </div>
  </div>
</section>
)}

<!-- ===== RELATED GUIDES ===== -->
{relatedPages.length > 0 && (
<section class="guide-related">
  <div class="container">
    <div class="section-header">
      <h2>Related Guides</h2>
    </div>
    <div class="guide-related-grid">
      {relatedPages.map((rp: any) => (
        <a href={`/guides/${rp.slug}/`} class="guide-related-card">
          <div class="guide-related-badge">
            {rp.verticalLabel}
          </div>
          <h3>{rp.title}</h3>
          <p>{rp.subtitle}</p>
          <span class="guide-related-link">Read Guide →</span>
        </a>
      ))}
    </div>
  </div>
</section>
)}

<!-- ===== CTA ===== -->
<section class="guide-cta-section">
  <div class="container">
    <div class:list={['guide-cta-inner', showEmployeeReferral && 'guide-cta-inner-single']}>
      {showEmployeeReferral ? (
      <div class="guide-cta-content">
        <span class="eyebrow">For Individuals</span>
        <h2>Need help with your own visa or 30% ruling?</h2>
        <p>Our partner platform Quality Immigration advises individuals on work visas, residence permits, HSM applications and the 30% ruling, from start to finish.</p>
        <div class="guide-cta-buttons">
          <a href="https://quality-immigration.com/?utm_source=hrhelp&utm_medium=referral&utm_campaign=guides" target="_blank" rel="noopener" class="btn btn-primary btn-lg" onclick="typeof gtag==='function'&&gtag('event','referral_quality_immigration',{page_path:location.pathname})">Go to Quality Immigration</a>
          <a href="/contact/" class="btn btn-secondary btn-lg">I'm an employer, talk to HRhelp</a>
        </div>
      </div>
      ) : (
      <div class="guide-cta-content">
        <span class="eyebrow">Need Help?</span>
        <h2>Ready to get started with {page.parentServiceName}?</h2>
        <p>Book a free 30-minute consultation. We'll assess your situation and propose a clear path forward. No commitment required.</p>
        <div class="guide-cta-buttons">
          <a href="/contact/" class="btn btn-primary btn-lg">Book a Consultation</a>
          <a href={page.parentService} class="btn btn-secondary btn-lg">Learn about {page.parentServiceName}</a>
        </div>
      </div>
      )}
      {!showEmployeeReferral && (
      <div class="guide-cta-photo">
        <img src={ctaImage.src} alt="Cornelis Leerlooijer, founder of HRHelp" loading="lazy" decoding="async" width={ctaImage.width} height={ctaImage.height} />
      </div>
      )}
    </div>
  </div>
</section>

</Layout>

<!-- TABLE OF CONTENTS SCRIPT -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const article = document.querySelector('.guide-article');
    if (!article) return;
    const headings = article.querySelectorAll('h2');

    // Inject mid-article photo after the 2nd H2
    const imgSrc = article.getAttribute('data-article-img');
    if (headings.length >= 3 && imgSrc) {
      const targetH2 = headings[2];
      const imgWrapper = document.createElement('div');
      imgWrapper.className = 'guide-article-img';
      const img = document.createElement('img');
      img.src = imgSrc;
      img.alt = '';
      img.loading = 'lazy';
      img.decoding = 'async';
      img.width = Number(article.getAttribute('data-article-w')) || 1200;
      img.height = Number(article.getAttribute('data-article-h')) || 900;
      imgWrapper.appendChild(img);
      targetH2.parentNode?.insertBefore(imgWrapper, targetH2);
    }
  });
</script>

<style>
/* Same sections and order as before; calmer treatment matching the service
   pages: light hero with a documentary photo, hairline 10-12px cards, 700
   headings, muted eyebrows, big numerals for steps, one light CTA panel with
   Cornelis. No mesh, background renders, icon tiles or hover lifts. */
h1, h2, h3 { font-weight: 700; letter-spacing: -0.015em; }
.eyebrow {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  color: #44546d;
  margin-bottom: 0.75rem;
}
.guide-process .section-header, .guide-pitfalls .section-header,
.guide-related .section-header {
  text-align: left;
  max-width: none;
  margin: 0 0 2.5rem;
}
.guide-process .section-header h2, .guide-pitfalls .section-header h2,
.guide-related .section-header h2 { margin: 0; font-size: clamp(1.7rem, 3.2vw, 2.3rem); }
.guide-faq .section-header h2 { font-size: clamp(1.7rem, 3.2vw, 2.3rem); }

/* ===== HERO (ArticleHero): meta on navy ===== */
.guide-meta-item { display: inline-flex; align-items: center; gap: 0.35rem; }
.guide-meta-sep { color: rgba(255, 255, 255, 0.4); }
.guide-meta-link { display: inline-flex; align-items: center; gap: 0.35rem; }

/* ===== AT A GLANCE: facts card reaching up into the hero ===== */
.guide-glance {
  background: var(--white);
  border: 1px solid rgba(15, 37, 72, 0.1);
  border-radius: 12px;
  padding: 0 1.75rem;
  box-shadow: 0 2px 4px rgba(15, 37, 72, 0.06), 0 18px 48px rgba(15, 37, 72, 0.16);
}
/* minmax(0, 1fr) + overflow-wrap: a long label or value wraps inside its card instead of
   widening the grid past the card on a 360px screen */
.guide-glance-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
.guide-glance-card { padding: 1.5rem 1.25rem 1.5rem 0; }
.guide-glance-card:not(:first-child) { padding-left: 1.25rem; border-left: 1px solid rgba(15, 37, 72, 0.12); }
.guide-glance-label {
  display: block;
  font-size: 0.7rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.12em;
  color: #44546d;
  margin-bottom: 0.25rem;
}
.guide-glance-value { display: block; font-size: 1.05rem; font-weight: 700; color: var(--navy); line-height: 1.35; }
.guide-glance-label, .guide-glance-value { overflow-wrap: anywhere; }

/* ===== MAIN CONTENT LAYOUT ===== */
.guide-content-section { padding: 0 0 4rem; background: var(--cream); }
/* Grid, overlap and sticky sidebar come from ArticleHero (.ah-*); the text
   inside the article card keeps a reading measure */
.guide-main { min-width: 0; }
.guide-main :global(.ae-author) { background: var(--white); }
.guide-article {
  background: white;
  border-radius: 12px;
  padding: 2.75rem 3rem;
  border: 1px solid rgba(15, 37, 72, 0.1);
  font-size: 1.05rem;
  line-height: 1.85;
  color: var(--gray-700);
  min-width: 0;
}
.guide-article :global(h2) {
  font-size: 1.45rem; font-weight: 700;
  color: var(--navy);
  margin: 2.75rem 0 1rem;
  padding-bottom: 0.6rem;
  border-bottom: 1px solid rgba(15, 37, 72, 0.14);
}
.guide-article :global(h2:first-child) { margin-top: 0; }
.guide-article :global(h3) { font-size: 1.15rem; font-weight: 700; margin: 1.75rem 0 0.6rem; }
.guide-article :global(p) { margin-bottom: 1.25rem; }
.guide-article :global(ul), .guide-article :global(ol) { margin: 1rem 0 1.5rem; padding-left: 1.4rem; }
.guide-article :global(li) { margin-bottom: 0.5rem; }
.guide-article :global(li::marker) { color: var(--gray-500); }
.guide-article :global(strong) { color: var(--navy); }
.guide-article :global(a) { color: var(--navy); font-weight: 600; text-decoration: underline; text-decoration-color: var(--orange-ink); text-underline-offset: 3px; }
.guide-article :global(ul ul) { margin: 0.5rem 0 0.75rem; }
.guide-article :global(table) { width: 100%; border-collapse: collapse; margin: 1.25rem 0 1.75rem; font-size: 0.95rem; display: block; overflow-x: auto; }
.guide-article :global(th), .guide-article :global(td) { padding: 0.6rem 0.75rem; border-bottom: 1px solid rgba(15, 37, 72, 0.12); text-align: left; vertical-align: top; }
.guide-article :global(th) { color: var(--navy); font-weight: 600; }
.guide-article :global(.guide-article-img) { margin: 2.25rem 0; }
.guide-article :global(.guide-article-img img) {
  width: 100%; height: auto; aspect-ratio: 16 / 8;
  object-fit: cover; display: block;
  border-radius: 10px;
  background: #e9edf2;
}

/* SIDEBAR */
.guide-sidebar { display: flex; flex-direction: column; gap: 1rem; }
.guide-sidebar-card {
  background: white;
  border-radius: 12px;
  padding: 1.5rem;
  border: 1px solid rgba(15, 37, 72, 0.1);
}
