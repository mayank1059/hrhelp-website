---
import Layout from '../../components/Layout.astro';
import PageHero from '../../components/PageHero.astro';

import { settlersData, teamsData, sosData } from '../../data/pseo/guides.js';

type PageData = {
  slug: string;
  title: string;
  subtitle: string;
  vertical: string;
  verticalLabel: string;
  readTime: string;
  topic: string;
  [key: string]: any;
};

const dataMap: Record<string, PageData[]> = {
  'hr-settlers': settlersData as PageData[],
  'hr-teams': teamsData as PageData[],
  'hr-sos': sosData as PageData[],
};

const verticalMeta: Record<string, {
  label: string;
  tagline: string;
  description: string;
}> = {
  'hr-settlers': {
    label: 'HR Settlers',
    tagline: 'Market Entry & Company Setup',
    description: 'Everything you need to establish your business in the Netherlands',
  },
  'hr-teams': {
    label: 'HR Teams',
    tagline: 'Payroll, Compliance & Workforce',
    description: 'In-depth guides on managing your Dutch workforce and HR compliance',
  },
  'hr-sos': {
    label: 'HR S.O.S.',
    tagline: 'Crisis & Employment Law',
    description: 'Urgent guidance for dismissals, disputes, and emergency HR situations',
  },
};

export function getStaticPaths() {
  return [
    { params: { vertical: 'hr-settlers' } },
    { params: { vertical: 'hr-teams' } },
    { params: { vertical: 'hr-sos' } },
  ];
}

const { vertical } = Astro.params;
const pages = dataMap[vertical as string] || [];
const meta = verticalMeta[vertical as string];

if (!meta || pages.length === 0) {
  return Astro.redirect('/guides/');
}

// Get unique topics for sub-filters
const topicCounts = new Map<string, number>();
for (const page of pages) {
  const t = page.topic || 'General';
  topicCounts.set(t, (topicCounts.get(t) || 0) + 1);
}
const topics = Array.from(topicCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));
---

<Layout
  title={`${meta.label} Guides | HRHelp.nl`}
  description={meta.description}
>

<!-- ===== HERO ===== -->
<PageHero variant="archive" title={meta.label}>
  <a href="/guides/" class="vg-back-link" slot="top">
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    All Guides
  </a>
  <span class="vg-hero-badge" slot="eyebrow">
    {pages.length} {pages.length === 1 ? 'Guide' : 'Guides'}
  </span>
  <p class="vg-hero-tagline">{meta.tagline}</p>
  <p class="vg-hero-desc">{meta.description}</p>
</PageHero>

<!-- ===== SUB-FILTERS + GRID ===== -->
<section class="vg-content">
  <div class="container">
    <!-- Sub-Filters -->
    <div class="vg-filters" id="vg-filters">
      <button class="vg-filter-btn active" data-topic="all">
        All
        <span class="vg-filter-count">{pages.length}</span>
      </button>
      {topics.map(t => (
        <button class="vg-filter-btn" data-topic={t.name}>
          {t.name}
          <span class="vg-filter-count">{t.count}</span>
        </button>
      ))}
    </div>

    <!-- Grid -->
    <div class="vg-grid" id="vg-grid">
      {pages.map(page => (
        <a href={`/guides/${page.slug}/`} class="vg-card" data-topic={page.topic}>
          <div class="vg-card-top">
            <span class="vg-card-topic">
              {page.topic}
            </span>
            <span class="vg-card-time">
              <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
              {page.readTime}
            </span>
          </div>
          <h2 class="as-h3">{page.title}</h2>
          <p>{page.subtitle}</p>
          <div class="vg-card-footer">
            <span class="vg-card-link">Read Guide →</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Empty State -->
    <div class="vg-empty" id="vg-empty" style="display:none;">
      <h2 class="as-h3">No guides match this filter</h2>
      <p>Try selecting a different topic filter above.</p>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="vg-cta">
  <div class="container">
    <div class="vg-cta-inner">
      <div>
        <h2>Need Personalised Guidance?</h2>
        <p>Our HR specialists can provide tailored advice for your specific situation.</p>
        <div class="vg-cta-btns">
          <a href="/contact/" class="btn btn-primary btn-lg">Book a Free Consultation →</a>
          <a href="/guides/" class="btn btn-secondary btn-lg">← Back to All Topics</a>
        </div>
      </div>
      <div class="vg-cta-photo">
        <img src="/images/home/cornelis-candid.jpg" alt="Cornelis Leerlooijer, founder of HRHelp" width="962" height="825" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

</Layout>

<!-- FILTER SCRIPT -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.vg-filter-btn');
    const cards = document.querySelectorAll('.vg-card');
    const empty = document.getElementById('vg-empty');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const topic = btn.getAttribute('data-topic');
        
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        let visible = 0;
        cards.forEach(card => {
          const cardTopic = card.getAttribute('data-topic');
          const show = topic === 'all' || cardTopic === topic;
          (card as HTMLElement).style.display = show ? '' : 'none';
          if (show) visible++;
        });

        if (empty) {
          empty.style.display = visible === 0 ? '' : 'none';
        }
      });
    });
  });
</script>

<style>
/* Same sections and order; calmer treatment: light hero with the topic
   photo, muted labels, hairline cards, quiet filter buttons, light CTA. */
h1, h2, h3 { font-weight: 700; letter-spacing: -0.015em; }
.vg-back-link { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.88rem; font-weight: 500; color: var(--gray-600); margin-bottom: 1.25rem; }
.vg-back-link:hover { color: var(--navy); text-decoration: underline; text-underline-offset: 3px; }
.vg-hero-badge { display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em; color: #44546d; margin-bottom: 1rem; }
.vg-hero-tagline { font-size: 1.2rem !important; font-weight: 600; color: var(--navy); margin-bottom: 0.6rem; }
.vg-hero-desc { font-size: 1.125rem !important; color: var(--gray-600); line-height: 1.65; max-width: 620px; }

.vg-content { padding: 4rem 0 5rem; background: var(--cream); }
.vg-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
.vg-filter-btn {
  display: inline-flex; align-items: center; gap: 0.45rem;
  font-family: inherit; font-size: 0.88rem; font-weight: 500;
  color: var(--gray-700);
  background: white;
  border: 1px solid rgba(15, 37, 72, 0.14);
  border-radius: var(--radius-full);
  padding: 0.5rem 0.9rem;
  cursor: pointer;
  transition: border-color 0.2s ease, color 0.2s ease;
}
.vg-filter-btn:hover { border-color: rgba(15, 37, 72, 0.4); color: var(--navy); }
.vg-filter-btn.active { background: var(--navy); border-color: var(--navy); color: white; }
.vg-filter-count { font-size: 0.75rem; font-weight: 600; opacity: 0.75; font-variant-numeric: tabular-nums; }

.vg-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
.vg-card {
  display: flex; flex-direction: column;
  background: white;
  border: 1px solid rgba(15, 37, 72, 0.1);
  border-radius: 10px;
  padding: 1.5rem;
  text-decoration: none;
  transition: border-color 0.2s ease;
}
.vg-card:hover { border-color: rgba(15, 37, 72, 0.28); }
.vg-card-top { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; margin-bottom: 0.9rem; }
.vg-card-topic { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #44546d; }
.vg-card-time { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.8rem; color: var(--gray-500); white-space: nowrap; }
.vg-card h2 { font-size: 1.08rem; line-height: 1.35; color: var(--navy); margin-bottom: 0.5rem; }
.vg-card p { font-size: 0.9rem; line-height: 1.6; color: var(--gray-600); margin-bottom: 1rem; flex: 1; }
.vg-card-link { font-size: 0.88rem; font-weight: 600; color: var(--navy); }
.vg-card:hover .vg-card-link { text-decoration: underline; text-decoration-color: var(--orange-ink); text-underline-offset: 3px; }
.vg-empty { text-align: center; padding: 3rem 1rem; color: var(--gray-600); }
.vg-empty h2 { margin-bottom: 0.5rem; }

.vg-cta { padding: 5rem 0 5.5rem; background: white; }
.vg-cta-inner {
  display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: 3rem; align-items: center;
  background: #f6f7f9; border: 1px solid rgba(15, 37, 72, 0.08); border-radius: 12px; padding: 2.75rem 3rem;
}
.vg-cta h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); color: var(--navy); margin-bottom: 0.9rem; }
.vg-cta p { color: var(--gray-600); line-height: 1.7; }
.vg-cta-btns { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.75rem; }
/* Photo fills the height of the text column (floor 220px) in a fixed 22rem column, instead of a fixed square */
.vg-cta-photo { position: relative; align-self: stretch; min-height: 220px; }
.vg-cta-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 22%; border-radius: 4px; background: #e9edf2; }

@media (max-width: 1024px) {
  .vg-grid { grid-template-columns: repeat(2, 1fr); }
  .vg-cta-inner { grid-template-columns: 1fr; gap: 2rem; }
  .vg-cta-photo { max-width: 360px; }
  .vg-cta-photo { min-height: 0; }
  .vg-cta-photo img { position: static; height: auto; aspect-ratio: 4 / 3; }
}
@media (max-width: 768px) {
  .vg-content { padding: 2.5rem 0 4rem; }
  .vg-grid { grid-template-columns: 1fr; gap: 0.75rem; }
  .vg-cta { padding: 3.5rem 0 4rem; }
  .vg-cta-inner { padding: 1.75rem 1.35rem; }
  .vg-cta-btns { flex-direction: column; align-items: stretch; }
  .vg-cta-btns .btn { justify-content: center; }
}

/* Mobile: cards keep a 1rem side padding inside the page gutter */
@media (max-width: 768px) {
  .vg-cta-inner {
    padding-left: 1rem;
    padding-right: 1rem;
  }
  .vg-card {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}
</style>
