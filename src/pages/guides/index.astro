---
import Layout from '../../components/Layout.astro';
import { verticalPhotos } from '../../lib/guidePhotos';
import PageHero from '../../components/PageHero.astro';

import { settlersData, teamsData, sosData } from '../../data/pseo/guides.js';

const allPages = [
  ...settlersData,
  ...teamsData,
  ...sosData,
];

const verticals = [
  {
    id: 'hr-settlers',
    label: 'HR Settlers',
    tagline: 'Market Entry & Company Setup',
    description: 'Everything you need to establish your business in the Netherlands, from entity formation and employer registration to hiring your first Dutch employee.',
    count: settlersData.length,
  },
  {
    id: 'hr-teams',
    label: 'HR Teams',
    tagline: 'Payroll, Compliance & Workforce',
    description: 'In-depth guides on Dutch employment contracts, payroll setup, pension systems, leave policies, and day-to-day HR compliance for established teams.',
    count: teamsData.length,
  },
  {
    id: 'hr-sos',
    label: 'HR S.O.S.',
    tagline: 'Crisis & Employment Law',
    description: 'Urgent guidance for dismissals, workplace conflicts, restructuring, sick leave disputes, and emergency HR situations under Dutch law.',
    count: sosData.length,
  },
].filter(v => v.count > 0);

---

<Layout title="HR Guides & Resources | HRHelp.nl" description="Guides for international companies dealing with Dutch employment law, HR compliance, and business setup in the Netherlands.">

<!-- ===== HERO ===== -->
<PageHero variant="archive" eyebrow="Guides & Resources" subtitle="Practical guides on Dutch employment law, company setup, HR compliance, and workforce management, written by our HR specialists.">
  <Fragment slot="title">Expert HR Guides for the <span>Netherlands</span></Fragment>
  <div class="gl-hero-stats">
    <div class="gl-stat">
      <span class="gl-stat-value">{allPages.length}</span>
      <span class="gl-stat-label">Expert Guides</span>
    </div>
    <div class="gl-stat">
      <span class="gl-stat-value">{verticals.length}</span>
      <span class="gl-stat-label">Topic Areas</span>
    </div>
    <div class="gl-stat">
      <span class="gl-stat-value">Free</span>
      <span class="gl-stat-label">Always</span>
    </div>
  </div>
</PageHero>

<!-- ===== CATEGORY BOXES ===== -->
<section class="gl-categories">
  <div class="container">
    <div class="gl-head">
      <h2 class="gl-section-title">Browse by <span>Topic</span></h2>
      <p class="gl-section-sub">Select a topic area to explore our in-depth guides</p>
    </div>

    <div class="gl-cat-grid">
      {verticals.map(v => (
        <a href={`/guides/${v.id}/`} class="gl-cat-card">
          <div class="gl-cat-img">
            <img src={verticalPhotos[v.id].src} alt={v.label} loading="lazy" decoding="async" width={verticalPhotos[v.id].width} height={verticalPhotos[v.id].height} />
          </div>
          <div class="gl-cat-body">
            <span class="gl-cat-badge">
              {v.count} {v.count === 1 ? 'Guide' : 'Guides'}
            </span>
            <h3>{v.label}</h3>
            <span class="gl-cat-tagline">{v.tagline}</span>
            <p>{v.description}</p>
            <span class="gl-cat-link">
              Explore Guides
              <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ===== FEATURED / POPULAR GUIDES ===== -->
<section class="gl-featured">
  <div class="container">
    <div class="gl-head">
      <h2 class="gl-section-title">Most Popular <span>Guides</span></h2>
      <p class="gl-section-sub">The guides our readers find most helpful</p>
    </div>

    <div class="gl-feat-grid">
      {allPages.slice(0, 6).map(page => (
        <a href={`/guides/${page.slug}/`} class="gl-feat-card">
          <div class="gl-feat-top">
            <span class="gl-feat-badge">
              {page.verticalLabel}
            </span>
            <span class="gl-feat-time">
              <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
              {page.readTime}
            </span>
          </div>
          <h3>{page.title}</h3>
          <p>{page.subtitle}</p>
          <span class="gl-feat-link">Read Guide →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="gl-cta">
  <div class="container">
    <div class="gl-cta-inner">
      <div>
        <h2>Can't Find What You're Looking For?</h2>
        <p>Our HR specialists are ready to answer any question about Dutch employment law and HR management.</p>
        <div class="gl-cta-btns">
          <a href="/contact/" class="btn btn-primary btn-lg">Book a Free Consultation →</a>
          <a href="/solutions/" class="btn btn-secondary btn-lg">View Our Solutions</a>
        </div>
      </div>
      <div class="gl-cta-photo">
        <img src="/images/home/cornelis-candid.jpg" alt="Cornelis Leerlooijer, founder of HRHelp" width="962" height="825" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

</Layout>

<style>
/* Same sections and order; calmer treatment matching the service pages:
   light hero, documentary topic photos instead of illustrations, hairline
   cards, muted labels, one light CTA panel with Cornelis. */
h1, h2, h3 { font-weight: 700; letter-spacing: -0.015em; }

/* ===== HERO stats (PageHero archive) ===== */
.gl-hero-stats { display: flex; gap: 0; flex-wrap: wrap; border-top: 1px solid rgba(15, 37, 72, 0.14); padding-top: 1.25rem; margin-top: 2rem; max-width: 560px; }
.gl-stat { display: flex; flex-direction: column; padding: 0 2rem; border-left: 1px solid rgba(15, 37, 72, 0.12); }
.gl-stat:first-child { padding-left: 0; border-left: 0; }
.gl-stat-value { font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; color: var(--navy); line-height: 1.1; }
.gl-stat-label { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #44546d; margin-top: 0.3rem; }

/* ===== SECTION HEADERS (left-aligned, list sections) ===== */
.gl-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; margin-bottom: 2.5rem; }
.gl-section-title { font-size: clamp(1.7rem, 3.2vw, 2.3rem); color: var(--navy); margin: 0; }
.gl-section-sub { color: var(--gray-600); font-size: 1rem; margin: 0; max-width: 380px; text-align: right; }

/* ===== CATEGORIES ===== */
.gl-categories { padding: 5.5rem 0; background: var(--white); }
.gl-cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
.gl-cat-card {
  display: flex; flex-direction: column;
  background: white;
  border: 1px solid rgba(15, 37, 72, 0.1);
  border-radius: 12px;
  box-shadow: 0 1px 2px rgba(15, 37, 72, 0.04), 0 4px 14px rgba(15, 37, 72, 0.04);
  overflow: hidden;
  text-decoration: none;
  transition: border-color 0.2s ease;
}
.gl-cat-card:hover { border-color: rgba(15, 37, 72, 0.28); }
.gl-cat-img { background: #e9edf2; }
.gl-cat-img img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; }
.gl-cat-body { padding: 1.5rem; display: flex; flex-direction: column; flex: 1; }
.gl-cat-badge { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #44546d; margin-bottom: 0.6rem; }
.gl-cat-body h3 { font-size: 1.3rem; color: var(--navy); margin-bottom: 0.25rem; }
.gl-cat-tagline { font-size: 0.9rem; font-weight: 600; color: var(--gray-700); margin-bottom: 0.75rem; }
.gl-cat-body p { font-size: 0.92rem; line-height: 1.65; color: var(--gray-600); margin-bottom: 1.1rem; flex: 1; }
.gl-cat-link { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.9rem; font-weight: 600; color: var(--navy); }
.gl-cat-card:hover .gl-cat-link { text-decoration: underline; text-decoration-color: var(--orange-ink); text-underline-offset: 3px; }

/* ===== FEATURED ===== */
.gl-featured { padding: 5.5rem 0; background: var(--cream); }
.gl-feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
.gl-feat-card {
  display: flex; flex-direction: column;
  background: white;
  border: 1px solid rgba(15, 37, 72, 0.1);
  border-radius: 10px;
  padding: 1.5rem;
  text-decoration: none;
  transition: border-color 0.2s ease;
}
.gl-feat-card:hover { border-color: rgba(15, 37, 72, 0.28); }
.gl-feat-top { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; margin-bottom: 0.9rem; }
.gl-feat-badge { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #44546d; }
.gl-feat-time { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.8rem; color: var(--gray-500); white-space: nowrap; }
.gl-feat-card h3 { font-size: 1.08rem; line-height: 1.35; color: var(--navy); margin-bottom: 0.5rem; }
.gl-feat-card p { font-size: 0.9rem; line-height: 1.6; color: var(--gray-600); margin-bottom: 1rem; flex: 1; }
.gl-feat-link { font-size: 0.88rem; font-weight: 600; color: var(--navy); }
.gl-feat-card:hover .gl-feat-link { text-decoration: underline; text-decoration-color: var(--orange-ink); text-underline-offset: 3px; }

/* ===== CTA: light panel ===== */
.gl-cta { padding: 5rem 0 5.5rem; background: white; }
.gl-cta-inner {
  display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: 3rem; align-items: center;
  background: #f6f7f9;
  border: 1px solid rgba(15, 37, 72, 0.08);
  border-radius: 12px;
  padding: 2.75rem 3rem;
}
.gl-cta h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); color: var(--navy); margin-bottom: 0.9rem; }
.gl-cta p { color: var(--gray-600); line-height: 1.7; max-width: 520px; }
.gl-cta-btns { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.75rem; }
/* Photo fills the height of the text column (floor 220px) in a fixed 22rem column, instead of a fixed square */
.gl-cta-photo { position: relative; align-self: stretch; min-height: 220px; }
.gl-cta-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 22%; border-radius: 4px; background: #e9edf2; }

@media (max-width: 1024px) {
  .gl-cat-grid, .gl-feat-grid { grid-template-columns: repeat(2, 1fr); }
  .gl-head { flex-direction: column; align-items: flex-start; gap: 0.6rem; }
  .gl-section-sub { text-align: left; }
  .gl-cta-inner { grid-template-columns: 1fr; gap: 2rem; }
  .gl-cta-photo { max-width: 360px; }
  .gl-cta-photo { min-height: 0; }
  .gl-cta-photo img { position: static; height: auto; aspect-ratio: 4 / 3; }
}
@media (max-width: 768px) {
  .gl-stat { padding: 0 1.25rem; }
  .gl-stat-value { font-size: 1.6rem; }
  .gl-categories, .gl-featured { padding: 4rem 0; }
  .gl-cat-grid, .gl-feat-grid { grid-template-columns: 1fr; gap: 0.75rem; }
  .gl-cat-img img { aspect-ratio: 2 / 1; }
  .gl-cta { padding: 3.5rem 0 4rem; }
  .gl-cta-inner { padding: 1.75rem 1.35rem; }
  .gl-cta-btns { flex-direction: column; align-items: stretch; }
  .gl-cta-btns .btn { justify-content: center; }
}

/* Mobile: cards keep a 1rem side padding inside the page gutter */
@media (max-width: 768px) {
  .gl-cat-body,
  .gl-stat,
  .gl-cta-inner {
    padding-left: 1rem;
    padding-right: 1rem;
  }
  .gl-feat-card {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}
</style>
