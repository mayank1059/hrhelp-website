---
import Layout from '../../components/Layout.astro';

import settlersData from '../../data/pseo/hr-settlers.json';
import teamsData from '../../data/pseo/hr-teams.json';
import sosData from '../../data/pseo/hr-sos.json';

const allPages = [
  ...settlersData,
  ...teamsData,
  ...sosData,
];

const verticals = [
  {
    id: 'hr-settlers',
    label: 'HR Settlers',
    tagline: 'Market Entry & Company Setup',
    description: 'Everything you need to establish your business in the Netherlands — from entity formation and employer registration to hiring your first Dutch employee.',
    count: settlersData.length,
    image: '/images/guides/category-hr-settlers.png',
    color: '#f47920',
    colorBg: 'rgba(244,121,32,0.06)',
  },
  {
    id: 'hr-teams',
    label: 'HR Teams',
    tagline: 'Payroll, Compliance & Workforce',
    description: 'In-depth guides on Dutch employment contracts, payroll setup, pension systems, leave policies, and day-to-day HR compliance for established teams.',
    count: teamsData.length,
    image: '/images/guides/category-hr-teams.png',
    color: '#3b82f6',
    colorBg: 'rgba(59,130,246,0.06)',
  },
  {
    id: 'hr-sos',
    label: 'HR S.O.S.',
    tagline: 'Crisis & Employment Law',
    description: 'Urgent guidance for dismissals, workplace conflicts, restructuring, sick leave disputes, and emergency HR situations under Dutch law.',
    count: sosData.length,
    image: '/images/guides/category-hr-sos.png',
    color: '#dc2626',
    colorBg: 'rgba(220,38,38,0.06)',
  },
].filter(v => v.count > 0);

const verticalColors: Record<string, { bg: string; text: string }> = {
  'hr-settlers': { bg: 'rgba(244,121,32,0.08)', text: '#f47920' },
  'hr-teams':    { bg: 'rgba(59,130,246,0.08)', text: '#3b82f6' },
  'hr-sos':      { bg: 'rgba(220,38,38,0.08)', text: '#dc2626' },
};
---

<Layout title="HR Guides & Resources | HRHelp.nl" description="Comprehensive guides for international companies navigating Dutch employment law, HR compliance, and business setup in the Netherlands.">

<!-- ===== HERO ===== -->
<section class="gl-hero">
  <div class="gl-hero-mesh"></div>
  <div class="gl-hero-bg">
    <img src="/images/guides/guides-hero-cover.png" alt="" loading="eager" />
  </div>
  <div class="container gl-hero-inner">
    <span class="eyebrow-badge" style="border-color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.85);">
      Guides & Resources
    </span>
    <h1>Expert HR Guides for the <span style="color: var(--orange);">Netherlands</span></h1>
    <p class="gl-hero-sub">Comprehensive, actionable guides on Dutch employment law, company setup, HR compliance, and workforce management — written by our team of HR specialists.</p>
    <div class="gl-hero-stats">
      <div class="gl-stat">
        <span class="gl-stat-value">{allPages.length}</span>
        <span class="gl-stat-label">Expert Guides</span>
      </div>
      <div class="gl-stat-sep"></div>
      <div class="gl-stat">
        <span class="gl-stat-value">{verticals.length}</span>
        <span class="gl-stat-label">Topic Areas</span>
      </div>
      <div class="gl-stat-sep"></div>
      <div class="gl-stat">
        <span class="gl-stat-value">Free</span>
        <span class="gl-stat-label">Always</span>
      </div>
    </div>
  </div>
</section>

<!-- ===== CATEGORY BOXES ===== -->
<section class="gl-categories">
  <div class="container">
    <h2 class="gl-section-title">Browse by <span style="color: var(--orange);">Topic</span></h2>
    <p class="gl-section-sub">Select a topic area to explore our in-depth guides</p>

    <div class="gl-cat-grid">
      {verticals.map(v => (
        <a href={`/guides/${v.id}`} class="gl-cat-card" style={`--card-accent: ${v.color};`}>
          <div class="gl-cat-img">
            <img src={v.image} alt={v.label} loading="lazy" />
          </div>
          <div class="gl-cat-body">
            <span class="gl-cat-badge" style={`background: ${v.colorBg}; color: ${v.color};`}>
              {v.count} {v.count === 1 ? 'Guide' : 'Guides'}
            </span>
            <h3>{v.label}</h3>
            <span class="gl-cat-tagline">{v.tagline}</span>
            <p>{v.description}</p>
            <span class="gl-cat-link" style={`color: ${v.color};`}>
              Explore Guides
              <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ===== FEATURED / POPULAR GUIDES ===== -->
<section class="gl-featured">
  <div class="container">
    <h2 class="gl-section-title">Most Popular <span style="color: var(--orange);">Guides</span></h2>
    <p class="gl-section-sub">The guides our readers find most helpful</p>

    <div class="gl-feat-grid">
      {allPages.slice(0, 6).map(page => {
        const vc = verticalColors[page.vertical] || verticalColors['hr-settlers'];
        return (
          <a href={`/guides/${page.slug}`} class="gl-feat-card">
            <div class="gl-feat-top">
              <span class="gl-feat-badge" style={`background: ${vc.bg}; color: ${vc.text};`}>
                {page.verticalLabel}
              </span>
              <span class="gl-feat-time">
                <span class="material-symbols-outlined" style="font-size:14px;">schedule</span>
                {page.readTime}
              </span>
            </div>
            <h3>{page.title}</h3>
            <p>{page.subtitle}</p>
            <span class="gl-feat-link" style={`color: ${vc.text};`}>Read Guide →</span>
          </a>
        );
      })}
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="gl-cta">
  <div class="container" style="text-align:center;">
    <h2>Can't Find What You're Looking For?</h2>
    <p>Our HR specialists are ready to answer any question about Dutch employment law and HR management.</p>
    <div style="display:flex; gap:1rem; justify-content:center; margin-top:1.5rem; flex-wrap:wrap;">
      <a href="/contact" class="btn btn-primary btn-lg">Book a Free Consultation →</a>
      <a href="/solutions" class="btn btn-ghost btn-lg" style="border-color:rgba(255,255,255,0.3); color:white;">View Our Solutions</a>
    </div>
  </div>
</section>

</Layout>

<style>
/* ===== HERO ===== */
.gl-hero {
  padding: 10rem 0 5rem;
  background: var(--navy);
  color: white;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.gl-hero-mesh {
  position: absolute; inset: 0;
  background:
    radial-gradient(circle at 30% 30%, rgba(244,121,32,0.1), transparent 40%),
    radial-gradient(circle at 80% 70%, rgba(255,255,255,0.04), transparent 40%);
  z-index: 1;
}
.gl-hero-bg {
  position: absolute; inset: 0; z-index: 0;
}
.gl-hero-bg img {
  width: 100%; height: 100%;
  object-fit: cover;
  opacity: 0.2;
  filter: blur(1px);
}
.gl-hero-inner { position: relative; z-index: 2; }
.gl-hero h1 {
  font-size: clamp(2.5rem, 5vw, 3.5rem);
  font-weight: 800; margin: 1rem 0 1.25rem;
  color: white;
}
.gl-hero-sub {
  font-size: 1.15rem;
  color: rgba(255,255,255,0.7);
  max-width: 620px;
  margin: 0 auto 2.5rem;
  line-height: 1.7;
}
.gl-hero-stats {
  display: flex; align-items: center; justify-content: center;
  gap: 2rem;
}
.gl-stat { text-align: center; }
.gl-stat-value {
  display: block; font-size: 1.8rem; font-weight: 800;
  color: var(--orange);
}
.gl-stat-label {
  display: block; font-size: 0.75rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.1em;
  color: rgba(255,255,255,0.5); margin-top: 0.2rem;
}
.gl-stat-sep {
  width: 1px; height: 40px;
  background: rgba(255,255,255,0.15);
}

/* ===== SECTION TITLES ===== */
.gl-section-title {
  font-size: clamp(1.8rem, 3vw, 2.4rem);
  font-weight: 800;
  color: var(--navy);
  text-align: center;
  margin-bottom: 0.5rem;
}
.gl-section-sub {
  text-align: center;
  color: var(--text-secondary);
  font-size: 1.05rem;
  margin-bottom: 3rem;
}

/* ===== CATEGORY BOXES ===== */
.gl-categories {
  padding: var(--section-padding);
  background: var(--cream);
}
.gl-cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}
.gl-cat-card {
  text-decoration: none;
  background: white;
  border-radius: var(--radius-xl);
  overflow: hidden;
  border: 1px solid var(--gray-200);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  display: flex;
  flex-direction: column;
}
.gl-cat-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 48px rgba(0,0,0,0.08);
  border-color: var(--card-accent, var(--orange));
}
.gl-cat-img {
  height: 220px;
  overflow: hidden;
  background: linear-gradient(135deg, #f8f9fb 0%, #eef1f5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
}
.gl-cat-img img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  transition: transform 0.4s ease;
}
.gl-cat-card:hover .gl-cat-img img {
  transform: scale(1.05);
}
.gl-cat-body {
  padding: 1.75rem;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.gl-cat-badge {
  display: inline-block;
  width: fit-content;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding: 0.3rem 0.75rem;
  border-radius: var(--radius-full);
  margin-bottom: 0.75rem;
}
.gl-cat-body h3 {
  font-size: 1.4rem;
  font-weight: 800;
  color: var(--navy);
  margin-bottom: 0.25rem;
}
.gl-cat-tagline {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--card-accent, var(--orange));
  margin-bottom: 0.75rem;
}
.gl-cat-body p {
  font-size: 0.88rem;
  line-height: 1.65;
  color: var(--text-secondary);
  margin-bottom: 1.25rem;
  flex: 1;
}
.gl-cat-link {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.9rem;
  font-weight: 700;
  transition: gap 0.2s ease;
}
.gl-cat-card:hover .gl-cat-link {
  gap: 0.6rem;
}

/* ===== FEATURED GUIDES ===== */
.gl-featured {
  padding: var(--section-padding);
  background: white;
}
.gl-feat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}
.gl-feat-card {
  text-decoration: none;
  background: var(--cream);
  border-radius: var(--radius-xl);
  padding: 1.75rem;
  border: 1px solid var(--gray-200);
  display: flex;
  flex-direction: column;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.gl-feat-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 30px rgba(0,0,0,0.06);
}
.gl-feat-top {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 1rem;
}
.gl-feat-badge {
  font-size: 0.65rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.1em;
  padding: 0.25rem 0.7rem;
  border-radius: var(--radius-full);
}
.gl-feat-time {
  display: inline-flex; align-items: center; gap: 0.25rem;
  font-size: 0.75rem; color: var(--text-secondary);
}
.gl-feat-card h3 {
  font-size: 1.05rem; font-weight: 700;
  color: var(--navy);
  margin-bottom: 0.5rem;
  line-height: 1.3;
}
.gl-feat-card p {
  font-size: 0.85rem; line-height: 1.6;
  color: var(--text-secondary);
  margin-bottom: 1rem;
  flex: 1;
}
.gl-feat-link {
  font-size: 0.85rem; font-weight: 700;
}

/* ===== CTA ===== */
.gl-cta {
  padding: 5rem 0;
  background: var(--navy);
  color: white;
}
.gl-cta h2 { color: white; margin-bottom: 0.75rem; }
.gl-cta p {
  color: rgba(255,255,255,0.7);
  max-width: 500px;
  margin: 0 auto;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 992px) {
  .gl-cat-grid { grid-template-columns: 1fr; max-width: 520px; margin: 0 auto; }
  .gl-feat-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .gl-hero { padding: 7.5rem 0 3.5rem; }
  .gl-hero-stats { gap: 1rem; }
  .gl-stat-value { font-size: 1.4rem; }
  .gl-feat-grid { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto; }
  .gl-cat-img { height: 180px; }
}
</style>
