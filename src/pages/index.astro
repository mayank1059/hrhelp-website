<script is:inline>
(function() {
  var form = document.getElementById('whitepaper-form');
  if (!form) return;

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var btn = document.getElementById('wp-download-btn');
    var status = document.getElementById('wp-form-status');

    var params = new URLSearchParams(window.location.search);
    var data = {
      name: form.querySelector('[name="name"]').value.trim(),
      email: form.querySelector('[name="email"]').value.trim(),
      source: 'Whitepaper Download',
      // Optional opt-in for HR updates; unticked by default.
      marketing_consent: form.querySelector('[name="marketing_consent"]').checked,
      url_confirm: form.querySelector('[name="url_confirm"]').value,
      utm_source: params.get('utm_source') || '',
      utm_medium: params.get('utm_medium') || '',
      utm_campaign: params.get('utm_campaign') || '',
      referrer: document.referrer || ''
    };
    // First-touch lead source (utm_*, click ids, referrer host, landing page)
    if (window.hrhelpAttribution) Object.assign(data, window.hrhelpAttribution());

    // The browser has checked the field; this is the same shape the CRM accepts.
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(data.email)) {
      status.style.display = 'block';
      status.style.background = '#fce4ec';
      status.style.color = '#c62828';
      status.textContent = '✗ Please enter a valid email address.';
      return;
    }

    // The lead goes to the CRM in the background. keepalive lets the request finish even
    // if the browser opens the PDF in this tab. Whatever it answers, the guide is theirs.
    fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
      keepalive: true
    }).catch(function() {});

    var link = document.createElement('a');
    link.href = '/downloads/hrhelp-hr-rules-regulations-2026-nl.pdf';
    link.download = 'HRHelp-HR-Rules-Regulations-2026-NL.pdf';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    if (typeof gtag === 'function') gtag('event', 'guide_download', { source: 'homepage' });

    status.style.display = 'block';
    status.style.background = '#e8f5e9';
    status.style.color = '#2e7d32';
    status.textContent = '✓ Downloading your guide now!';
    btn.disabled = true;
    btn.innerHTML = '<span class="material-symbols-outlined" aria-hidden="true" style="font-size:18px;">check_circle</span> Downloaded!';
    btn.style.background = '#2e7d32';
  });
})();
</script>


