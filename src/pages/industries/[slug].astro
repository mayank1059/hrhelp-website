export function getStaticPaths() {
  return [
    { params: { slug: 'technology' } },
    { params: { slug: 'life-sciences' } },
    { params: { slug: 'finance' } },
    { params: { slug: 'professional-services' } },
    { params: { slug: 'logistics' } },
    { params: { slug: 'ngo' } },
    { params: { slug: 'manufacturing' } },
    { params: { slug: 'industrial' } },
  ];
}

const { slug } = Astro.params;
const ind = industryData[slug];
if (!ind) return Astro.redirect('/industries/');

// Find related industries (exclude current)
const allSlugs = Object.keys(industryData);
const relatedSlugs = allSlugs.filter(s => s !== slug).slice(0, 3);
const related = relatedSlugs.map(s => ({ slug: s, ...industryData[s] }));

// Documentary photos (see src/lib/industryPhotos.ts)
const photos = industryPhotos(slug as string);
const ctaImage = { src: '/images/home/cornelis-candid.jpg', width: 962, height: 825 };

const industrySchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `${ind.name} HR Consulting`,
  "description": ind.description,
  "provider": {
    "@type": "Organization",
    "name": "HRHelp.nl",
    "url": "https://www.hrhelp.nl"
  },
  "areaServed": { "@type": "Country", "name": "Netherlands" },
  "serviceType": "HR Consulting",
  "url": `https://www.hrhelp.nl/industries/${slug}/`
};
---

<Layout title={`${ind.name} HR Consulting`} description={ind.description} schema={industrySchema}>

<!-- ===== HERO ===== -->
<PageHero variant="split" title={ind.tagline} subtitle={ind.description} image={{ src: photos.hero.src, width: photos.hero.width, height: photos.hero.height, alt: `${ind.name} industry`, position: photos.pos }}>
  <span class="idp-eyebrow" slot="eyebrow">
    <LineIcon name={ind.icon} size={18} /> {ind.name}
  </span>
  <div class="page-hero-actions">
    <a href="/contact/" class="btn btn-primary btn-lg">Schedule Consultation <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
    <a href="/solutions/" class="btn btn-secondary btn-lg">View Solutions</a>
  </div>
  <div class="idp-hero-card" slot="media">
    <p class="idp-hero-card-value">{ind.complianceScore}</p>
    <p class="idp-hero-card-label">{ind.complianceLabel}</p>
  </div>
</PageHero>

<!-- ===== STATS BAR ===== -->
<section class="idp-stats">
  <div class="container">
    <div class="idp-stats-grid">
      {ind.stats.map((stat: any) => (
        <div class="idp-stat-item">
          <span class={`idp-stat-value ${stat.highlight ? 'highlight' : ''}`}>{stat.value}</span>
          <span class="idp-stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== CHALLENGES ===== -->
<section class="idp-challenges section-cream">
  <div class="container">
    <div class="section-header idp-head-split">
      <div>
        <span class="eyebrow">Industry Challenges</span>
        <h2>Key HR Pain Points in {ind.name}</h2>
      </div>
      <p>Identifying critical friction points in your organisational structure before they cause systemic failure.</p>
    </div>
    <div class="idp-challenges-grid">
      {ind.challenges.map((ch: any, i: number) => (
        <div class="idp-challenge-card">
          <div class="idp-card-top">
            <span class="idp-card-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class={`idp-severity idp-severity-${ch.severity.toLowerCase()}`}>{ch.severity}</span>
          </div>
          <h3>{ch.title}</h3>
          <p>{ch.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== SOLUTIONS ===== -->
<section class="idp-solutions section-white">
  <div class="container">
    <div class="section-header idp-head-split">
      <div>
        <span class="eyebrow">Our Solutions</span>
        <h2>How We Help {ind.name}</h2>
      </div>
      <p>Specialized modules designed for your industry's unique HR requirements.</p>
    </div>
    <div class="idp-solutions-grid">
      {ind.solutions.map((sol: any, i: number) => (
        <div class="idp-solution-card">
          <span class="idp-card-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{sol.title}</h3>
          <p>{sol.desc}</p>
