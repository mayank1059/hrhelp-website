---
import Layout from '../../components/Layout.astro';
import LineIcon from '../../components/LineIcon.astro';
import PageHero from '../../components/PageHero.astro';
import { photo } from '../../lib/servicePhotos';
import { industryPhotos } from '../../lib/industryPhotos';

const industries = [
  { name: 'Technology & Startups', icon: 'terminal', slug: 'technology',
    desc: 'Seed to scale-up HR. Stock options, tech talent acquisition, 30% ruling applications, equity-based compensation, and global mobility.' },
  { name: 'Life Sciences & Pharma', icon: 'biotech', slug: 'life-sciences',
    desc: 'Compliance-focused for regulated industries. R&D tax benefits, clinical workforce management, and BIG registration guidance.' },
  { name: 'Finance & Fintech', icon: 'account_balance', slug: 'finance',
    desc: 'AFM/DNB compliance, executive compensation, banking-grade HR governance, bonus claw-back structuring, and MiFID staffing.' },
  { name: 'Professional Services', icon: 'work', slug: 'professional-services',
    desc: 'Consulting, legal, and advisory firms. Partnership structures, billable workforce management, and knowledge-worker retention.' },
  { name: 'Logistics & Supply Chain', icon: 'local_shipping', slug: 'logistics',
    desc: 'Distribution centers, shift workers, temporary labor, port operations HR. Cross-border driver compliance and CAO overleg.' },
  { name: 'NGO & Non-Profit', icon: 'public', slug: 'ngo',
    desc: 'Non-profit employment rules, volunteer management, grant-funded positions, and mission-driven talent acquisition strategies.' },
  { name: 'Greenfield & Manufacturing', icon: 'precision_manufacturing', slug: 'manufacturing',
    desc: 'New facility HR setup, production workforce, CLA negotiations, works councils, and CAO compliance for manufacturing environments.' },
  { name: 'Production & Industrial', icon: 'engineering', slug: 'industrial',
    desc: 'Health & safety compliance, union relations, blue-collar recruitment, shift-planning, and workplace safety audits.' },
].map((ind) => ({ ...ind, photo: industryPhotos(ind.slug, true) }));

const caseImage = photo('interim-hr-manager-hero');
const ctaImage = { src: '/images/home/cornelis-candid.jpg', width: 962, height: 825 };

const stats = [
  { value: '20+', label: 'Years in HR', icon: 'calendar_month' },
  { value: '75+', label: 'Clients Served', icon: 'groups' },
  { value: '€2M', label: 'Avg Cost Savings', icon: 'savings' },
  { value: '98%', label: 'Retention Rate', icon: 'trending_up' },
];

const steps = [
  { num: '01', title: 'Assessment', icon: 'analytics',
    desc: 'Analysis of your current organisational structure, talent gaps, and cultural blockers.' },
  { num: '02', title: 'Strategy', icon: 'strategy',
    desc: 'A roadmap of high-impact, low-friction changes that fit Dutch labor law.' },
  { num: '03', title: 'Implementation', icon: 'rocket_launch',
    desc: 'Hands-on support so the changes stick and deliver measurable results.' },
];
---

<Layout title="Industries" description="Specialized HR consulting across key sectors of the Dutch economy: technology, healthcare, finance, manufacturing, and more.">

<!-- ===== HERO ===== -->
<PageHero variant="archive" eyebrow="Industry Expertise" subtitle="Senior HR consulting for the sectors that drive the Dutch economy, built on data and tested methods.">
  <Fragment slot="title">Strategic HR for<br/><span>Dutch Industry Leaders</span></Fragment>
  <div class="page-hero-actions">
    <a href="/contact/" class="btn btn-primary btn-lg">Schedule Consultation →</a>
    <a href="/solutions/" class="btn btn-secondary btn-lg">Explore Services</a>
  </div>
  <div class="ia-hero-card">
    <p class="ia-hero-card-label">Market Analysis 2026</p>
    <p class="ia-hero-card-desc">Labor trends indicating a 14% shift in executive retention strategies across the Netherlands.</p>
  </div>
</PageHero>

<!-- ===== VISUAL INDUSTRY GRID ===== -->
<section class="ia-grid-section section-white" id="industries">
  <div class="container">
    <div class="section-header ia-head-split">
      <div>
        <span class="eyebrow">Industries Served</span>
        <h2>Specialized Expertise Across Sectors</h2>
      </div>
      <p>Deep domain knowledge for every corner of the Dutch economy.</p>
    </div>
    <div class="ia-grid">
      {industries.map((ind) => (
        <a href={`/industries/${ind.slug}/`} class="ia-card">
          <div class="ia-card-bg">
            <img src={ind.photo.hero.src} alt={ind.name} width={ind.photo.hero.width} height={ind.photo.hero.height} loading="lazy" decoding="async" style={`object-position: ${ind.photo.pos};`} />
          </div>
          <div class="ia-card-content">
            <div class="ia-card-icon">
              <LineIcon name={ind.icon} />
            </div>
            <h3>{ind.name}</h3>
            <p>{ind.desc}</p>
            <span class="ia-card-link">Explore <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ===== STATS BAR ===== -->
<section class="ia-stats section-navy">
  <div class="container">
    <div class="ia-stats-grid">
      {stats.map((stat) => (
        <div class="ia-stat">
          <span class="ia-stat-value">{stat.value}</span>
          <span class="ia-stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== METHODOLOGY ===== -->
<section class="ia-method section-cream">
  <div class="container">
    <div class="section-header ia-head-split">
      <div>
        <span class="eyebrow">Our Approach</span>
        <h2>Our Methodology</h2>
      </div>
      <p>How we work, in three steps.</p>
    </div>
    <div class="ia-method-grid">
      {steps.map((step) => (
        <div class="ia-method-step">
          <div class="ia-method-num">{step.num}</div>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== CASE STUDY ===== -->
<section class="ia-case section-white">
  <div class="container">
    <div class="section-header ia-head-split">
      <div>
        <span class="eyebrow">Case Study</span>
        <h2>Real Results, Real Impact</h2>
      </div>
    </div>
    <div class="ia-case-card">
      <div class="ia-case-image">
        <img src={caseImage.src} alt="Corporate restructuring case study" width={caseImage.width} height={caseImage.height} loading="lazy" decoding="async" />
      </div>
      <div class="ia-case-body">
        <h3>Delivering a Complex Site Closure on Time and Under Budget</h3>
        <p>When a multinational client decided to consolidate operations and close its Dutch site, we led the execution from start to finish, with full compliance, clear communication, and a process managed with respect.</p>
        <div class="ia-case-badges">
          <div class="ia-case-badge">
            <strong>50%</strong>
            <span>Cost Reduction</span>
          </div>
          <div class="ia-case-badge">
            <strong>100%</strong>
            <span>Compliance</span>
          </div>
          <div class="ia-case-badge">
            <strong>On-Time</strong>
            <span>Delivery</span>
          </div>
        </div>
        <a href="/resources/case-studies/" class="ia-case-link">Read Full Case Study <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg></a>
      </div>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="ia-cta section-white">
  <div class="container">
    <div class="ia-cta-inner">
      <div class="ia-cta-content">
        <h2>Ready to Transform Your Industry?</h2>
        <p>Our specialists will build an HR strategy for your sector.</p>
        <div class="ia-cta-btns">
          <a href="/contact/" class="btn btn-primary btn-lg">Schedule a Call →</a>
          <a href="/solutions/" class="btn btn-secondary btn-lg">View Solutions</a>
        </div>
      </div>
      <div class="ia-cta-photo">
        <img src={ctaImage.src} alt="Cornelis Leerlooijer, founder of HRHelp" width={ctaImage.width} height={ctaImage.height} loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

</Layout>

<style>
/* Same sections and order as before; calmer treatment matching the homepage
   and service pages: light hero, documentary photos, hairline 10-12px cards,
   700 headings, muted eyebrows, navy line icons, orange only on buttons and
   small markers, no scroll-reveal or hover lift. */
h1, h2, h3 { font-weight: 700; letter-spacing: -0.015em; }
.eyebrow {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  color: #44546d;
  margin-bottom: 0.75rem;
}
.ia-head-split {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 2.5rem;
  max-width: none;
  text-align: left;
  margin: 0 0 2.75rem;
}
.ia-head-split h2 { margin: 0; font-size: clamp(1.7rem, 3.2vw, 2.4rem); }
.ia-head-split > p {
  margin: 0;
  max-width: 400px;
  text-align: right;
  font-size: 1rem;
  color: var(--gray-600);
}

/* ===== HERO note (former glass card) ===== */
.ia-hero-card {
  max-width: 560px;
  margin-top: 2rem;
  padding-top: 1.1rem;
  border-top: 1px solid rgba(15, 37, 72, 0.14);
}
.ia-hero-card-label {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #44546d;
  margin-bottom: 0.25rem;
}
.ia-hero-card-desc { font-size: 0.93rem; font-weight: 500; color: var(--navy); line-height: 1.5; }

/* ===== VISUAL INDUSTRY GRID ===== */
.ia-grid-section { padding: 5.5rem 0; }
.ia-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;
}
.ia-card {
  display: flex;
  flex-direction: column;
  background: var(--white);
  border: 1px solid rgba(15, 37, 72, 0.1);
  border-radius: 12px;
  box-shadow: 0 1px 2px rgba(15, 37, 72, 0.04), 0 4px 14px rgba(15, 37, 72, 0.04);
  overflow: hidden;
  text-decoration: none;
  transition: border-color 0.2s ease;
}
.ia-card:hover { border-color: rgba(15, 37, 72, 0.28); }
.ia-card-bg { background: #e9edf2; }
.ia-card-bg img { width: 100%; height: auto; aspect-ratio: 16 / 11; object-fit: cover; }
.ia-card-content {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 1.25rem 1.3rem 1.35rem;
}
.ia-card-icon { color: var(--icon-accent); margin-bottom: 0.75rem; }
.ia-card-content h3 { font-size: 1.05rem; color: var(--navy); line-height: 1.3; margin-bottom: 0.45rem; }
.ia-card-content p { font-size: 0.88rem; color: var(--gray-600); line-height: 1.6; margin-bottom: 1rem; flex: 1; }
.ia-card-link {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--navy);
}
.ia-card:hover .ia-card-link { text-decoration: underline; text-decoration-color: var(--orange-ink); text-underline-offset: 3px; }

/* ===== STATS (the page's one navy band) ===== */
.ia-stats { padding: 4rem 0; }
.ia-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
}
.ia-stat { display: flex; flex-direction: column; padding-left: 1.5rem; border-left: 1px solid rgba(255, 255, 255, 0.16); }
.ia-stat-value { font-size: 2.6rem; font-weight: 700; letter-spacing: -0.02em; color: white; margin-bottom: 0.4rem; line-height: 1; }
.ia-stat-label {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: rgba(255, 255, 255, 0.88);
}

/* ===== METHODOLOGY: big numerals, no icon circles ===== */
.ia-method { padding: 5.5rem 0; }
.ia-method-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
}
.ia-method-step { position: relative; padding-top: 1.5rem; border-top: 1px solid rgba(15, 37, 72, 0.14); }
.ia-method-step::before {
  content: '';
  position: absolute;
  top: -1px;
  left: 0;
  width: 32px;
  height: 2px;
  background: var(--orange);
}
.ia-method-num {
  font-size: 2.5rem;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--navy);
  margin-bottom: 1rem;
  font-variant-numeric: tabular-nums;
}
.ia-method-step h3 { font-size: 1.15rem; margin-bottom: 0.5rem; }
.ia-method-step p { font-size: 0.95rem; line-height: 1.65; color: var(--gray-600); max-width: 340px; }

/* ===== CASE STUDY ===== */
.ia-case { padding: 5.5rem 0 4rem; }
.ia-case-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(15, 37, 72, 0.1);
  box-shadow: 0 1px 2px rgba(15, 37, 72, 0.04), 0 4px 14px rgba(15, 37, 72, 0.04);
  background: var(--white);
}
.ia-case-image { position: relative; min-height: 340px; background: #e9edf2; }
.ia-case-image img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.ia-case-body { padding: 3rem; display: flex; flex-direction: column; justify-content: center; }
.ia-case-body h3 { font-size: 1.5rem; line-height: 1.3; margin-bottom: 1rem; }
.ia-case-body p { margin-bottom: 1.5rem; line-height: 1.7; color: var(--gray-600); }
.ia-case-badges {
  display: grid;
  grid-template-columns: repeat(3, auto);
  justify-content: start;
  gap: 2rem;
  padding-top: 1.1rem;
  margin-bottom: 1.75rem;
  border-top: 1px solid rgba(15, 37, 72, 0.14);
}
.ia-case-badge strong { display: block; font-size: 1.5rem; font-weight: 700; color: var(--navy); line-height: 1.2; }
.ia-case-badge span { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; color: #44546d; letter-spacing: 0.12em; }
.ia-case-link {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  align-self: flex-start;
  color: var(--navy);
  font-weight: 600;
  text-decoration: underline;
  text-decoration-color: var(--orange-ink);
  text-underline-offset: 4px;
}
.ia-case-link:hover { color: var(--navy); text-decoration-thickness: 2px; }

/* ===== CTA: light panel with the founder ===== */
.ia-cta { padding: 4.5rem 0 5.5rem; }
.ia-cta-inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 22rem;
  gap: 3rem;
  align-items: center;
  background: #f6f7f9;
  border: 1px solid rgba(15, 37, 72, 0.08);
  border-radius: 12px;
  padding: 2.75rem 3rem;
}
.ia-cta h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); color: var(--navy); margin-bottom: 0.75rem; }
.ia-cta p { color: var(--gray-600); margin-bottom: 1.75rem; font-size: 1.05rem; }
.ia-cta-btns { display: flex; gap: 1rem; flex-wrap: wrap; }
/* Photo fills the height of the text column (floor 220px) in a fixed 22rem column, instead of a fixed square */
.ia-cta-photo { position: relative; align-self: stretch; min-height: 220px; }
.ia-cta-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 22%; border-radius: 4px; background: #e9edf2; }

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
  .ia-grid { grid-template-columns: repeat(2, 1fr); }
  .ia-stats-grid { grid-template-columns: repeat(2, 1fr); }
  .ia-head-split { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  .ia-head-split > p { text-align: left; }
  .ia-cta-inner { grid-template-columns: 1fr; gap: 2rem; }
  .ia-cta-photo { max-width: 360px; }
  .ia-cta-photo { min-height: 0; }
  .ia-cta-photo img { position: static; height: auto; aspect-ratio: 4 / 3; }
}

@media (max-width: 768px) {
  .ia-grid-section, .ia-method { padding: 4rem 0; }
  .ia-case { padding: 4rem 0 3rem; }
  .ia-stats { padding: 3rem 0; }
  .ia-grid { grid-template-columns: 1fr; gap: 1rem; }
  .ia-card-bg img { aspect-ratio: 2 / 1; }
  .ia-card-content { padding: 1.1rem 1.2rem 1.2rem; }
  .ia-stat-value { font-size: 2rem; }
  .ia-method-grid { grid-template-columns: 1fr; gap: 2rem; }
  .ia-case-card { grid-template-columns: 1fr; }
  .ia-case-image { min-height: 200px; }
  .ia-case-body { padding: 1.5rem 1.35rem; }
  .ia-case-body h3 { font-size: 1.2rem; }
  .ia-case-badges { gap: 1.25rem; }
  .ia-case-badge strong { font-size: 1.15rem; }
  .ia-cta { padding: 3rem 0 4rem; }
  .ia-cta-inner { padding: 1.75rem 1.35rem; }
  .ia-cta-btns { flex-direction: column; align-items: stretch; }
  .ia-cta-btns .btn { justify-content: center; }
}

/* Mobile: cards keep a 1rem side padding inside the page gutter */
@media (max-width: 768px) {
  .ia-card-content,
  .ia-case-body,
  .ia-cta-inner {
    padding-left: 1rem;
    padding-right: 1rem;
  }
  .ia-stat { padding-left: 1rem; }
}
</style>
