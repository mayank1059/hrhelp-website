---
// Resource Centre hub: one page that shows everything under Resources (employer
// guides, articles, case studies, FAQ, the free 2026 guide and the explainer video).
// Every count is computed from the same data the target pages use.
import Layout from '../components/Layout.astro';
import PageHero from '../components/PageHero.astro';
import PostCard from '../components/PostCard.astro';
import CtaBand from '../components/CtaBand.astro';
import LineIcon from '../components/LineIcon.astro';
import { settlersData, teamsData, sosData } from '../data/pseo/guides.js';
import { verticalPhotos } from '../lib/guidePhotos';
import { coreExpertise } from '../data/expertiseLinks.js';
import { getBlogPosts, getCaseStudies, getFAQGroups, clip } from '../lib/wordpress';

const SITE = 'https://www.hrhelp.nl';
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;

// ---------- Employer guides (client-approved guides only; all of them on staging) ----------
type Guide = { slug: string; title: string };
const COUNTRY_PREFIX = 'starting-business-netherlands-';
const isCountryGuide = (g: Guide) => g.slug.startsWith(COUNTRY_PREFIX);
// Link text in the collection cards: the whole page is about the Netherlands
const shortTitle = (t: string) => t.replace(/ in the Netherlands$/, '');

// Example links per collection: the most-read guides first (Search Console),
// topped up in the collection's own order when one is not published.
const pickExamples = (guides: Guide[], preferred: string[], n = 4) => {
  const pool = guides.filter((g) => !isCountryGuide(g));
  const chosen = preferred
    .map((slug) => pool.find((g) => g.slug === slug))
    .filter((g): g is Guide => Boolean(g));
  for (const g of pool) {
    if (chosen.length >= n) break;
    if (!chosen.includes(g)) chosen.push(g);
  }
  return chosen.slice(0, n);
};

const collections = [
  {
    id: 'hr-settlers',
    label: 'HR Settlers',
    focus: 'Starting and hiring',
    desc: 'Set up your Dutch entity, register as an employer and hire your first people, visas included.',
    guides: settlersData as Guide[],
    preferred: ['work-permits-visa-sponsorship-netherlands', 'hiring-first-employee-netherlands', 'netherlands-bv-vs-branch-office', '30-percent-ruling-application-2026'],
  },
  {
    id: 'hr-teams',
    label: 'HR Teams',
    focus: 'Managing your team',
    desc: 'Contracts, payroll, leave, sickness and works councils: the everyday HR of a Dutch team.',
    guides: teamsData as Guide[],
    preferred: ['dutch-sick-leave-management', 'dutch-employment-contracts-guide', 'dutch-parental-leave-policies', 'works-council-requirements-netherlands'],
  },
  {
    id: 'hr-sos',
    label: 'HR S.O.S.',
    focus: 'Urgent issues',
    desc: 'Dismissals, disputes and investigations: situations where you must act fast and get it right.',
    guides: sosData as Guide[],
    preferred: ['dismissing-employee-netherlands-procedure', 'settlement-agreement-netherlands', 'emergency-dismissal-netherlands', 'handling-workplace-conflict-netherlands'],
  },
]
  .map((c) => ({ ...c, count: c.guides.length, examples: pickExamples(c.guides, c.preferred), photo: verticalPhotos[c.id] }))
  .filter((c) => c.count > 0);
const guideCount = collections.reduce((n, c) => n + c.count, 0);

// "Starting a business in the Netherlands as a <country> company" guides, as country chips
const countryNames: Record<string, string> = {
  us: 'United States', uk: 'United Kingdom', german: 'Germany', french: 'France', indian: 'India',
  chinese: 'China', japanese: 'Japan', singapore: 'Singapore', canadian: 'Canada', australian: 'Australia',
};
const countryGuides = collections
  .flatMap((c) => c.guides)
  .filter(isCountryGuide)
  .map((g) => {
    const key = g.slug.slice(COUNTRY_PREFIX.length).replace(/-company$/, '');
    return { slug: g.slug, name: countryNames[key] ?? g.title.replace(/^.* as an? (.+?) Company$/, '$1') };
  })
  .sort((a, b) => a.name.localeCompare(b.name));

// ---------- Articles (WordPress) ----------
const blogFallbackImage = '/images/sections/team-meeting.jpg';
const posts = (await getBlogPosts())
  .map((p) => ({ ...p, ts: Date.parse(p.date) || 0 }))
  .sort((a, b) => b.ts - a.ts);
const postCount = posts.length;
const latestPosts = posts.slice(0, 4);

// ---------- Case studies (WordPress): same card content as before, each card to its own page ----------
const caseStudies = (await getCaseStudies()).map((cs) => ({
  slug: cs.slug,
  tag: cs.tag,
  title: cs.title,
  desc: clip(cs.intro, 120),
  icon: cs.icon,
}));
// Line icons for the case-study icon names LineIcon does not have (others fall back to LineIcon)
const caseIcons: Record<string, string> = {
  health_and_safety: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><line x1="12" y1="8.5" x2="12" y2="14.5"/><line x1="9" y1="11.5" x2="15" y2="11.5"/>',
  domain_disabled: '<path d="M3 21h18"/><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/><path d="M9 8h1M9 12h1M9 16h1M14 8h1M14 12h1M14 16h1"/>',
  school: '<path d="M22 9 12 4 2 9l10 5 10-5z"/><path d="M6 11.2V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-4.8"/>',
};

// ---------- FAQ highlights (WordPress, same answers as /resources/faq/) ----------
// Not picked until their WordPress answers are updated: employer costs (still calls pensions
// mandatory) and how quickly we start ("within 24 hours"; the site now says one business day).
const faqItems = (await getFAQGroups()).flatMap((g) => g.items).filter((i) => i.q && i.a);
const FAQ_PICKS = [
  'How long does it take to hire an employee in the Netherlands?',
  'How does sick leave work under Dutch law?',
  'Can you help with the 30% ruling for expats?',
  'What does a typical engagement look like?',
  'Do you support companies outside the Netherlands?',
];
const norm = (s: string) => s.trim().toLowerCase();
const faqHighlights = FAQ_PICKS
  .map((q) => faqItems.find((i) => norm(i.q) === norm(q)))
  .filter((i): i is (typeof faqItems)[number] => Boolean(i));
for (const i of faqItems) {
  if (faqHighlights.length >= 5) break;
  if (!faqHighlights.includes(i)) faqHighlights.push(i);
}

// ---------- Core expertise (hands-on help) ----------
const expertise = Object.entries(coreExpertise).map(([slug, e]) => ({ slug, ...e }));

// ---------- Page meta, jump links, structured data ----------
const pageTitle = 'HR Resources for Employers in the Netherlands';
const pageDescription = `Free resources for international employers in the Netherlands: ${guideCount} HR guides, articles on Dutch employment law, case studies, FAQs and a 2026 HR rules guide.`;

// Inline line icons (Feather-style, 24px grid) for the jump links
const icons: Record<string, string> = {
  book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>',
  file: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
  briefcase: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>',
  download: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>',
  play: '<circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/>',
  help: '<circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
};
// In page order
const jumpLinks = [
  { href: '#guides', label: 'Employer guides', icon: 'book', count: guideCount },
  { href: '#articles', label: 'Articles', icon: 'file', count: postCount },
  { href: '#case-studies', label: 'Case studies', icon: 'briefcase', count: caseStudies.length },
  { href: '#free-guide', label: 'Free 2026 guide', icon: 'download' },
  { href: '#video', label: 'Video', icon: 'play' },
  { href: '#faq', label: 'FAQ', icon: 'help' },
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": `${SITE}/resources/`,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE },
      { "@type": "ListItem", "position": 2, "name": "Resources", "item": `${SITE}/resources/` }
    ]
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      { name: 'Employer guides', path: '/guides/' },
      { name: 'HR blog', path: '/blog/' },
      { name: 'Client case studies', path: '/resources/case-studies/' },
      { name: 'Frequently asked questions', path: '/resources/faq/' },
    ].map((item, i) => ({ "@type": "ListItem", "position": i + 1, "name": item.name, "url": `${SITE}${item.path}` }))
  }
};
---

<Layout title={pageTitle} description={pageDescription} schema={collectionSchema}>

<!-- ===== HERO ===== -->
<PageHero
  variant="archive"
  eyebrow="Resource Centre"
  title={pageTitle}
  subtitle={`Everything we publish for international employers in the Netherlands, in one place: ${plural(guideCount, 'free employer guide')}, ${plural(postCount, 'article')}, client case studies, quick answers and a free guide to the 2026 HR rules.`}
/>

<!-- ===== JUMP LINKS ===== -->
<nav class="rh-jump" aria-label="On this page">
  <div class="container rh-jump-inner">
    <span class="rh-jump-label">On this page</span>
    <ul class="rh-jump-list">
      {jumpLinks.map((j) => (
        <li>
          <a href={j.href} class="rh-chip">
            <svg class="rh-chip-ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={icons[j.icon]} />
            {j.label}
            {j.count !== undefined && <span class="rh-chip-count">{j.count}</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<!-- ===== EMPLOYER GUIDES ===== -->
<section id="guides" class="rh-section rh-guides" aria-labelledby="guides-title">
  <div class="container">
    <div class="rh-head">
      <div>
        <span class="eyebrow">Employer guides</span>
        <h2 id="guides-title">Guides to employing people in the Netherlands</h2>
        <p>{plural(guideCount, 'free guide')} on Dutch employment law, company setup and HR compliance, grouped by the situation you are in.</p>
      </div>
      <a href="/guides/" class="btn btn-secondary">Browse all {plural(guideCount, 'guide')} <span aria-hidden="true">→</span></a>
    </div>

    <div class="rh-col-grid">
      {collections.map((c) => (
        <div class="rh-col-card">
          {c.photo && (
            <img class="rh-col-img" src={c.photo.src} alt="" width={c.photo.width} height={c.photo.height} loading="lazy" decoding="async" />
          )}
          <div class="rh-col-body">
            <div class="rh-col-top">
              <span class="rh-col-focus">{c.focus}</span>
              <span class="rh-col-count">{plural(c.count, 'guide')}</span>
            </div>
            <h3 class="rh-col-title"><a href={`/guides/${c.id}/`}>{c.label}</a></h3>
            <p class="rh-col-desc">{c.desc}</p>
            <ul class="rh-col-links">
              {c.examples.map((g) => (
                <li>
                  <a href={`/guides/${g.slug}/`}>
                    <span>{shortTitle(g.title)}</span>
                    <svg class="rh-col-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                </li>
              ))}
            </ul>
            <a href={`/guides/${c.id}/`} class="rh-more-link">All {plural(c.count, `${c.label} guide`)} <span aria-hidden="true">→</span></a>
          </div>
        </div>
      ))}
    </div>

    {countryGuides.length > 0 && (
      <div class="rh-countries">
        <div class="rh-countries-text">
          <h3>Starting a business from your country</h3>
          <p>Company setup, registration and hiring, explained for companies coming to the Netherlands from {plural(countryGuides.length, 'country', 'countries')}.</p>
        </div>
        <ul class="rh-country-list">
          {countryGuides.map((g) => (
            <li><a href={`/guides/${g.slug}/`} class="rh-chip rh-chip--country">{g.name}</a></li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<!-- ===== LATEST ARTICLES ===== -->
<section id="articles" class="rh-section rh-articles" aria-labelledby="articles-title">
  <div class="container">
    <div class="rh-head">
      <div>
        <span class="eyebrow">Articles</span>
        <h2 id="articles-title">Latest articles</h2>
        <p>{plural(postCount, 'article')} on Dutch employment law, HR practice and leading international teams.</p>
      </div>
      <a href="/blog/" class="btn btn-secondary">All {plural(postCount, 'article')} <span aria-hidden="true">→</span></a>
    </div>
    <div class="rh-post-grid">
      {latestPosts.map((post) => (
        <PostCard
          href={`/blog/${post.slug}/`}
          image={post.image || blogFallbackImage}
          alt=""
          width={800}
          height={450}
          title={post.title}
          heading="h3"
          date={post.date}
          datetime={post.ts ? new Date(post.ts).toISOString().slice(0, 10) : undefined}
          readTime={post.readTime}
          tags={post.tags}
        />
      ))}
    </div>
  </div>
</section>

<!-- ===== CASE STUDIES ===== -->
<section id="case-studies" class="rh-section rh-cases" aria-labelledby="cases-title">
  <div class="container">
    <div class="rh-head">
      <div>
        <span class="eyebrow">Case studies</span>
        <h2 id="cases-title">Client Case Studies</h2>
        <p>Real engagements with measurable outcomes. See how we work.</p>
      </div>
      <a href="/resources/case-studies/" class="btn btn-secondary">All case studies <span aria-hidden="true">→</span></a>
    </div>
    <div class="rh-cs-grid">
      {caseStudies.map((cs) => (
        <a href={`/resources/case-studies/${cs.slug}/`} class="rh-cs-card">
          <div class="rh-cs-top">
            {caseIcons[cs.icon]
              ? <svg class="line-ico rh-cs-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={caseIcons[cs.icon]} />
              : <LineIcon name={cs.icon} class="rh-cs-icon" />}
            <span class="rh-cs-tag">{cs.tag}</span>
          </div>
          <h3>{cs.title}</h3>
          <p>{cs.desc}</p>
          <span class="rh-cs-link">Read Case Study <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ===== FREE 2026 GUIDE (same form and endpoint as the homepage and footer) ===== -->
<section id="free-guide" class="rh-wp" aria-labelledby="free-guide-title">
  <div class="container">
    <div class="rh-wp-grid">
      <div class="rh-wp-visual">
        <picture>
          <source srcset="/images/whitepaper/whitepaper-photo.webp" type="image/webp" />
          <img src="/images/whitepaper/whitepaper-photo.jpg" alt="A printed copy of the HR Rules &amp; Regulations 2026 guide on a wooden desk" width="640" height="640" loading="lazy" decoding="async" />
        </picture>
      </div>
      <div class="rh-wp-content">
        <span class="rh-wp-badge">Free download · PDF</span>
        <h2 id="free-guide-title">The Most Important HR Rules &amp; Regulations in 2026</h2>
        <p class="rh-wp-intro">A short guide to the Dutch employment rules international employers need to know in 2026, from the first contract to a dismissal.</p>
        <p class="rh-wp-inside">What's inside</p>
        <ul class="rh-wp-list">
          <li>Employment contracts and the chain rule</li>
          <li>Working time, holidays and statutory leave</li>
          <li>Minimum wage, holiday allowance and pensions</li>
          <li>Sickness and reintegration duties</li>
          <li>Dismissal routes and the transition payment</li>
          <li>Works councils, privacy and CAOs</li>
        </ul>
        <form id="resources-wp-form" class="rh-wp-form">
          <div class="rh-wp-fields">
            <input type="text" name="name" placeholder="Your full name" aria-label="Your full name" autocomplete="name" required />
            <input type="email" name="email" placeholder="Work email" aria-label="Work email" autocomplete="email" required />
          </div>
          <!-- Honeypot: off-screen and out of the tab order, so only bots fill it.
               A non-empty url_confirm makes /api/contact drop the submission. -->
          <div aria-hidden="true" style="position:absolute; left:-9999px; top:-9999px; width:1px; height:1px; overflow:hidden;">
            <label for="resources-wp-url-confirm">Your website</label>
            <input type="text" id="resources-wp-url-confirm" name="url_confirm" tabindex="-1" autocomplete="off" />
          </div>
          <!-- The opt-in comes before the button, so it is seen before submitting. Optional and
               unticked: the guide never depends on joining the mailing list. -->
          <div class="rh-wp-submit">
            <label class="rh-wp-consent">
              <input type="checkbox" name="marketing_consent" />
              <span>Also send me occasional HR updates. You can unsubscribe at any time.</span>
            </label>
            <button type="submit" class="btn btn-accent" id="resources-wp-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={icons.download} />
              Download free guide
            </button>
          </div>
          <div id="resources-wp-status" class="rh-wp-status" role="status" aria-live="polite"></div>
          <p class="rh-wp-disclaimer">No spam. We respect your privacy.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var form = document.getElementById('resources-wp-form');
  if (!form) return;
  var PDF = '/downloads/hrhelp-hr-rules-regulations-2026-nl.pdf';
  // Inline check icon: the self-hosted Inter subset has no check mark character
  var CHECK = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="20 6 9 17 4 12"/></svg>';
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var btn = document.getElementById('resources-wp-btn');
    var status = document.getElementById('resources-wp-status');
    var params = new URLSearchParams(window.location.search);
    var data = {
      name: form.querySelector('[name="name"]').value.trim(),
      email: form.querySelector('[name="email"]').value.trim(),
      source: 'Whitepaper Download (Resources)',
      // Optional opt-in for HR updates; unticked by default.
      marketing_consent: form.querySelector('[name="marketing_consent"]').checked,
      url_confirm: form.querySelector('[name="url_confirm"]').value,
      utm_source: params.get('utm_source') || '',
      utm_medium: params.get('utm_medium') || '',
      utm_campaign: params.get('utm_campaign') || '',
      referrer: document.referrer || ''
    };
    // First-touch lead source (utm_*, click ids, referrer host, landing page)
    if (window.hrhelpAttribution) Object.assign(data, window.hrhelpAttribution());

    // The browser has checked the field; this is the same shape the CRM accepts.
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(data.email)) {
      status.className = 'rh-wp-status is-error';
      status.textContent = 'Please enter a valid email address.';
      return;
    }

    // The lead goes to the CRM in the background (keepalive lets it finish even if the
    // browser opens the PDF in this tab). Whatever it answers, the guide downloads now.
    fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
      keepalive: true
    }).catch(function () {});

    var a = document.createElement('a');
    a.href = PDF;
    a.download = 'HRHelp-HR-Rules-Regulations-2026-NL.pdf';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    if (typeof gtag === 'function') gtag('event', 'guide_download', { source: 'resources' });

    status.className = 'rh-wp-status is-ok';
    status.innerHTML = CHECK + ' Your guide is downloading. Not started? <a href="' + PDF + '" target="_blank" rel="noopener">Open the PDF</a>';
    btn.disabled = true;
    btn.innerHTML = CHECK + ' Downloaded';
  });
})();
</script>

<!-- ===== VIDEO: click-to-play facade, no mp4 loads until the visitor presses play.
     Captions are burned into the video itself, so no <track> element is needed. ===== -->
<section id="video" class="rh-section rh-video" aria-labelledby="video-title">
  <div class="container">
    <!-- Desktop: head and points left, video right. Phones: head, video, points (DOM order) -->
    <div class="rh-video-inner">
      <div class="rh-video-head">
        <span class="eyebrow">Video</span>
        <h2 id="video-title">What HRhelp does, in 60 seconds</h2>
        <p class="rh-video-note">Who we help, our four solutions and how pricing works. Captions are on, so it works with the sound off.</p>
      </div>
      <div class="rh-video-frame">
        <button type="button" class="rh-video-facade" aria-label="Play video: What is HRhelp (1 minute)" data-src-720="/videos/what-is-hrhelp-720p.mp4" data-src-1080="/videos/what-is-hrhelp-1080p.mp4" data-poster="/videos/what-is-hrhelp-poster.jpg">
          <picture>
            <source type="image/webp" srcset="/videos/what-is-hrhelp-poster-960.webp 960w, /videos/what-is-hrhelp-poster.webp 1600w" sizes="(max-width: 1024px) calc(100vw - 2rem), 880px" />
            <img src="/videos/what-is-hrhelp-poster.jpg" alt="" width="1920" height="1080" loading="lazy" decoding="async" />
          </picture>
          <span class="rh-video-play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
          </span>
          <span class="rh-video-duration" aria-hidden="true">1:03</span>
        </button>
      </div>
      <div class="rh-video-more">
        <ul class="rh-video-points">
          <li><span class="rh-num" aria-hidden="true">01</span>The HR you take on when you hire in the Netherlands</li>
          <li><span class="rh-num" aria-hidden="true">02</span>Four solutions, from market entry to HR emergencies</li>
          <li><span class="rh-num" aria-hidden="true">03</span>Senior consultants and a fixed price, agreed upfront</li>
        </ul>
        <a href="/solutions/" class="rh-text-link">Explore our solutions <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Swap the poster facade for a real <video> on click. The source is picked by viewport width
  // (720p on small screens, 1080p otherwise) and playback starts with sound, since the click is a user gesture.
  (function () {
    var facade = document.querySelector('.rh-video-facade');
    if (!facade) return;
    facade.addEventListener('click', function () {
      var small = window.matchMedia('(max-width: 768px)').matches;
      var img = facade.querySelector('img');
      var video = document.createElement('video');
      video.controls = true;
      video.playsInline = true;
      video.setAttribute('playsinline', '');
      video.preload = 'none';
      video.poster = (img && img.currentSrc) || facade.dataset.poster;
      video.setAttribute('aria-label', 'What is HRhelp? (1 minute video)');
      var order = small ? ['720', '1080'] : ['1080', '720'];
      order.forEach(function (q) {
        var s = document.createElement('source');
        s.src = facade.getAttribute('data-src-' + q);
        s.type = 'video/mp4';
        video.appendChild(s);
      });
      var track = function (name) {
        if (typeof gtag === 'function') gtag('event', name, { video_title: 'What is HRhelp' });
      };
      var started = false;
      video.addEventListener('play', function () {
        if (!started) { started = true; track('video_start'); }
      });
      video.addEventListener('ended', function () { track('video_complete'); });
      facade.replaceWith(video);
      video.focus();
      var p = video.play();
      if (p && p.catch) p.catch(function () {});
    }, { once: true });
  })();
</script>

