---
import Layout from '../../components/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import LineIcon from '../../components/LineIcon.astro';
import { resourcePhoto } from '../../lib/resourcePhotos';
import { getCaseStudies, clip } from '../../lib/wordpress';

const allCaseStudies = await getCaseStudies();
const caseStudies = allCaseStudies.map(cs => ({
  slug: cs.slug,
  tag: cs.tag,
  title: cs.title,
  desc: clip(cs.intro, 120),
  icon: cs.icon,
  image: resourcePhoto(cs.image, true),
}));
---

<Layout title="Case Studies" description="Real challenges, measurable outcomes: case studies from HRHelp.nl's client engagements.">

<!-- ===== HERO ===== -->
<PageHero variant="archive" eyebrow="Our Work in Practice" subtitle="Real challenges, measurable outcomes: a selection of engagements that reflect how we work.">
  <Fragment slot="title">Client <span>Case Studies</span></Fragment>
</PageHero>

<!-- ===== CASE STUDY CARDS ===== -->
<section class="cs-section">
  <div class="container">
    <div class="cs-grid">
      {caseStudies.map((cs) => (
        <a href={`/resources/case-studies/${cs.slug}/`} class="cs-card">
          <div class="cs-card-img">
            <img src={cs.image.src} alt={cs.title} width={cs.image.width} height={cs.image.height} loading="lazy" decoding="async" />
          </div>
          <div class="cs-card-body">
            <span class="cs-tag">
              <LineIcon name={cs.icon} size={16} />
              {cs.tag}
            </span>
            <h2 class="as-h3">{cs.title}</h2>
            <p>{cs.desc}</p>
            <span class="cs-link">Read Full Case Study →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="cs-cta">
  <div class="container">
    <div class="cs-cta-inner">
      <div>
        <h2>Ready to See Similar Results?</h2>
        <p>Every engagement starts with understanding your unique challenge. Let's discuss how we can help.</p>
        <a href="/contact/" class="btn btn-primary btn-lg">Book a Free Consultation →</a>
      </div>
      <div class="cs-cta-photo">
        <img src="/images/home/cornelis-candid.jpg" alt="Cornelis Leerlooijer, founder of HRHelp" width="962" height="825" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

</Layout>

<style>
/* Same sections; calmer treatment: shared archive hero, documentary photos,
   hairline cards, light CTA panel. */
h2 { font-weight: 700; letter-spacing: -0.015em; }
.cs-section { padding: 4.5rem 0 5rem; background: var(--white); }
.cs-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
.cs-card {
  display: flex; flex-direction: column; text-decoration: none;
  background: white; border: 1px solid rgba(15, 37, 72, 0.1); border-radius: 12px; overflow: hidden;
  box-shadow: 0 1px 2px rgba(15, 37, 72, 0.04), 0 4px 14px rgba(15, 37, 72, 0.04);
  transition: border-color 0.2s ease;
}
.cs-card:hover { border-color: rgba(15, 37, 72, 0.28); }
.cs-card-img { background: #e9edf2; }
.cs-card-img img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; }
.cs-card-body { padding: 1.4rem 1.5rem 1.5rem; display: flex; flex-direction: column; flex: 1; }
.cs-tag { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #44546d; margin-bottom: 0.75rem; }
.cs-tag :global(svg) { color: var(--icon-accent); }
.cs-card-body h2 { color: var(--navy); margin-bottom: 0.5rem; }
.cs-card-body p { font-size: 0.92rem; line-height: 1.6; color: var(--gray-600); margin-bottom: 1rem; flex: 1; }
.cs-link { font-size: 0.88rem; font-weight: 600; color: var(--navy); }
.cs-card:hover .cs-link { text-decoration: underline; text-decoration-color: var(--orange-ink); text-underline-offset: 3px; }

.cs-cta { padding: 0 0 5.5rem; background: var(--white); }
.cs-cta-inner {
  display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: 3rem; align-items: center;
  background: #f6f7f9; border: 1px solid rgba(15, 37, 72, 0.08); border-radius: 12px; padding: 2.75rem 3rem;
}
.cs-cta h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); color: var(--navy); margin-bottom: 0.9rem; }
.cs-cta p { color: var(--gray-600); line-height: 1.7; margin-bottom: 1.75rem; max-width: 520px; }
/* Photo fills the height of the text column (floor 220px) in a fixed 22rem column, instead of a fixed square */
.cs-cta-photo { position: relative; align-self: stretch; min-height: 220px; }
.cs-cta-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 22%; border-radius: 4px; background: #e9edf2; }

@media (max-width: 1024px) {
  .cs-grid { grid-template-columns: repeat(2, 1fr); }
  .cs-cta-inner { grid-template-columns: 1fr; gap: 2rem; }
  .cs-cta-photo { max-width: 360px; }
  .cs-cta-photo { min-height: 0; }
  .cs-cta-photo img { position: static; height: auto; aspect-ratio: 4 / 3; }
}
@media (max-width: 768px) {
  .cs-section { padding: 2.5rem 0 3.5rem; }
  .cs-grid { grid-template-columns: 1fr; gap: 1rem; }
  .cs-card-img img { aspect-ratio: 2 / 1; }
  .cs-cta { padding: 0 0 4rem; }
  .cs-cta-inner { padding: 1.75rem 1.35rem; }
  .cs-cta .btn { width: 100%; justify-content: center; }
}

/* Mobile: cards keep a 1rem side padding inside the page gutter */
@media (max-width: 768px) {
  .cs-card-body,
  .cs-cta-inner {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}
</style>
