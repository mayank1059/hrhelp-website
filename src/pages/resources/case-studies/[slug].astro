---
import Layout from '../../../components/Layout.astro';
import { getCaseStudies, getCaseStudy } from '../../../lib/wordpress';
import type { CaseStudy } from '../../../lib/wordpress';
import PageHero from '../../../components/PageHero.astro';
import LineIcon from '../../../components/LineIcon.astro';
import { resourcePhoto } from '../../../lib/resourcePhotos';

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();
  return caseStudies.map(cs => ({
    params: { slug: cs.slug },
  }));
}

const { slug } = Astro.params;
const cs = await getCaseStudy(slug as string);
if (!cs) return Astro.redirect('/resources/case-studies/');

const featureImage = resourcePhoto(cs.image);
const illusImage = resourcePhoto(cs.illustration);
const ctaImage = { src: '/images/home/cornelis-candid.jpg', width: 962, height: 825 };

const caseStudySchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": cs.title,
  "description": cs.intro.slice(0, 160),
  "image": cs.image?.startsWith('http') ? cs.image : `https://www.hrhelp.nl${cs.image}`,
  "author": { "@type": "Organization", "name": "HRHelp.nl" },
  "publisher": {
    "@type": "Organization",
    "name": "HRHelp.nl",
    "logo": { "@type": "ImageObject", "url": "https://www.hrhelp.nl/favicon.svg" }
  },
  "mainEntityOfPage": `https://www.hrhelp.nl/resources/case-studies/${slug}/`
};
---

<Layout title={`${cs.title} | Case Study`} description={cs.intro.slice(0, 160)} schema={caseStudySchema}>

<!-- ===== HERO ===== -->
<PageHero variant="split" title={cs.title} subtitle={cs.intro} image={{ ...featureImage, alt: cs.title }}>
  <span class="csd-eyebrow" slot="eyebrow">
    <LineIcon name={cs.icon} size={16} />
    {cs.tag}
  </span>
  <div class="page-hero-actions">
    <a href="/contact/" class="btn btn-primary btn-lg">Book a Consultation</a>
    <a href="#csd-approach" class="btn btn-secondary btn-lg">Our Approach</a>
  </div>
  <ul class="csd-hero-facts">
    <li>
      <span class="floating-label">{cs.floatCards.tl.label}</span>
      <strong class="floating-value">{cs.floatCards.tl.value}</strong>
    </li>
    <li>
      <span class="floating-label">{cs.floatCards.br.label}</span>
      <strong class="floating-value">{cs.floatCards.br.value}</strong>
    </li>
    <li class="csd-fact-note">
      <span>Client Engagement</span>
    </li>
  </ul>
</PageHero>

<!-- ===== WHAT WE DID ===== -->
<section class="csd-what section-white" id="csd-approach">
  <div class="container">
    <div class="csd-what-inner">
      <div class="csd-what-content">
        <span class="eyebrow">What We Did</span>
        <h2>Our Approach</h2>
        <p class="csd-what-intro">{cs.context}</p>
        <ul class="csd-checklist">
          {cs.items.map((item: string) => (
            <li>
              <LineIcon name="check" size={18} />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="csd-what-illus">
        <img src={illusImage.src} alt={`${cs.title} illustration`} width={illusImage.width} height={illusImage.height} loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

<!-- ===== OUTCOME ===== -->
<section class="csd-outcome section-cream">
  <div class="container">
    <div class="section-header csd-head">
      <span class="eyebrow">Results</span>
      <h2>The Outcome</h2>
    </div>
    <div class="csd-outcome-card">
      <p>{cs.outcome}</p>
      {cs.stats.length > 0 && (
        <div class="csd-outcome-stats">
          {cs.stats.map((stat: any) => (
            <div class="csd-stat">
              <span class="csd-stat-val">{stat.value}</span>
              <span class="csd-stat-lbl">{stat.label}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="csd-cta">
  <div class="container">
    <div class="csd-cta-inner">
      <div>
        <h2>Ready to See Similar Results?</h2>
        <p>Every engagement starts with understanding your unique challenge.</p>
        <div class="csd-cta-btns">
          <a href="/contact/" class="btn btn-primary btn-lg">Book a Free Consultation →</a>
          <a href="/resources/case-studies/" class="btn btn-secondary btn-lg">View All Case Studies</a>
        </div>
      </div>
      <div class="csd-cta-photo">
        <img src={ctaImage.src} alt="Cornelis Leerlooijer, founder of HRHelp" width={ctaImage.width} height={ctaImage.height} loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

</Layout>

<style>
/* Same sections and order; calmer treatment: shared split hero (feature photo) with the
   former floating cards as a quiet facts row, documentary photos, hairline
   rules, light CTA panel with Cornelis. */
h2, h3 { font-weight: 700; letter-spacing: -0.015em; }
.eyebrow { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; color: #44546d; margin-bottom: 0.75rem; }
.csd-head { text-align: left; max-width: 760px; margin: 0 0 2rem; }
.csd-head h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin: 0; }

/* HERO extras */
.csd-eyebrow { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #44546d; margin-bottom: 1rem; }
.csd-eyebrow :global(svg) { color: var(--icon-accent); }
.csd-hero-facts {
  list-style: none; display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 1.25rem 2.5rem;
  margin: 2.25rem 0 0; padding: 1.1rem 0 0; border-top: 1px solid rgba(15, 37, 72, 0.14); max-width: 620px;
}
.floating-label { display: block; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #44546d; margin-bottom: 0.25rem; }
.floating-value { display: block; font-size: 0.95rem; font-weight: 600; color: var(--navy); line-height: 1.35; }
.csd-fact-note span { display: block; font-size: 0.88rem; font-weight: 500; color: var(--gray-600); line-height: 1.4; padding-top: 1rem; }

/* WHAT WE DID */
.csd-what { padding: 5.5rem 0; }
.csd-what-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
.csd-what-content h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin-bottom: 1rem; }
.csd-what-intro { font-size: 1.05rem; line-height: 1.8; color: var(--gray-600); margin-bottom: 1.5rem; }
.csd-checklist { list-style: none; padding: 0; margin: 0; }
.csd-checklist li { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.7rem 0; border-top: 1px solid rgba(15, 37, 72, 0.1); font-size: 0.98rem; line-height: 1.6; color: var(--gray-700); }
.csd-checklist li :global(svg) { color: var(--orange-ink); flex-shrink: 0; margin-top: 0.15rem; }
/* Photo fills the height of the text column (floor 360px) instead of a fixed 4:5 */
.csd-what-illus { position: relative; align-self: stretch; min-height: 360px; }
.csd-what-illus img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; border-radius: 4px; background: #e9edf2; }

/* OUTCOME */
.csd-outcome { padding: 5.5rem 0; }
.csd-outcome-card { max-width: 860px; padding-left: 1.5rem; border-left: 3px solid var(--orange); }
.csd-outcome-card > p { font-size: 1.15rem; line-height: 1.75; color: var(--navy); font-weight: 500; }
.csd-outcome-stats { display: flex; flex-wrap: wrap; gap: 1.25rem 3rem; margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid rgba(15, 37, 72, 0.14); }
.csd-stat-val { display: block; font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; color: var(--navy); line-height: 1.1; }
.csd-stat-lbl { display: block; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #44546d; margin-top: 0.3rem; }

/* CTA */
.csd-cta { padding: 5.5rem 0; }
.csd-cta-inner {
  display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: 3rem; align-items: center;
  background: #f6f7f9; border: 1px solid rgba(15, 37, 72, 0.08); border-radius: 12px; padding: 2.75rem 3rem;
}
.csd-cta h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); color: var(--navy); margin-bottom: 0.9rem; }
.csd-cta p { color: var(--gray-600); line-height: 1.7; }
.csd-cta-btns { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.75rem; }
/* Photo fills the height of the text column (floor 220px) in a fixed 22rem column, instead of a fixed square */
.csd-cta-photo { position: relative; align-self: stretch; min-height: 220px; }
.csd-cta-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 22%; border-radius: 4px; background: #e9edf2; }

@media (max-width: 1024px) {
  .csd-what-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  .csd-what-illus { max-width: 480px; min-height: 0; }
  .csd-what-illus img { position: static; height: auto; aspect-ratio: 4 / 3; }
  .csd-cta-inner { grid-template-columns: 1fr; gap: 2rem; }
  .csd-cta-photo { max-width: 360px; }
  .csd-cta-photo { min-height: 0; }
  .csd-cta-photo img { position: static; height: auto; aspect-ratio: 4 / 3; }
}
@media (max-width: 768px) {
  .csd-what { padding: 4rem 0; }
  .csd-outcome, .csd-cta { padding: 4rem 0; }
  .csd-hero-facts { grid-template-columns: 1fr 1fr; gap: 1rem; }
  .csd-hero-facts li.csd-fact-note { grid-column: 1 / -1; }
  .csd-fact-note span { padding-top: 0; }
  .csd-outcome-card { padding-left: 1.1rem; }
  .csd-cta-inner { padding: 1.75rem 1.35rem; }
  .csd-cta-btns { flex-direction: column; align-items: stretch; }
  .csd-cta-btns .btn { justify-content: center; }
}

/* Mobile: cards keep a 1rem side padding inside the page gutter */
@media (max-width: 768px) {
  .csd-cta-inner {
    padding-left: 1rem;
    padding-right: 1rem;
  }
  .csd-outcome-card { padding-left: 1rem; }
}
</style>
