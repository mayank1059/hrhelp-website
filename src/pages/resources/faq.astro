---
import Layout from '../../components/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import LineIcon from '../../components/LineIcon.astro';
import { getFAQGroups } from '../../lib/wordpress';

const faqGroups = await getFAQGroups();

// Build FAQPage schema from all FAQ items
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqGroups.flatMap(group =>
    group.items.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  )
};
---

<Layout title="FAQ | Frequently Asked Questions" description="Common questions about HRHelp.nl services, Dutch HR law, the 30% ruling, and our network organization model." schema={faqSchema}>

<!-- ===== HERO ===== -->
<PageHero variant="archive" eyebrow="Help Center" subtitle="Everything you need to know about working with HRHelp.nl and navigating Dutch HR.">
  <Fragment slot="title">Frequently Asked <br/><span>Questions</span></Fragment>
</PageHero>

<!-- ===== FAQ LIST ===== -->
<section class="fq-content">
  <div class="container fq-narrow">
    {faqGroups.map(group => (
      <div class="fq-group">
        <h2 class="fq-group-title">{group.category}</h2>
        <div class="fq-list">
          {group.items.map(faq => (
            <details class="fq-item">
              <summary>
                <span>{faq.q}</span>
                <LineIcon name="expand_more" class="fq-arrow" />
              </summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    ))}

    <div class="fq-cta-card">
      <div class="fq-cta-inner">
        <h3>Still have questions?</h3>
        <p>Our senior consultants are ready to discuss your specific organisational challenges.</p>
        <div class="fq-cta-btns">
          <a href="/contact/" class="btn btn-primary btn-lg">Get in Touch</a>
          <a href="tel:+31857608188" class="btn btn-secondary btn-lg">Call +31 85 760 8188</a>
        </div>
      </div>
      <div class="fq-cta-photo">
        <img src="/images/home/cornelis-candid.jpg" alt="Cornelis Leerlooijer, founder of HRHelp" width="962" height="825" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

</Layout>

<style>
/* Same sections; calmer treatment: shared archive hero, plain accordion rows,
   light CTA panel with Cornelis. */
h2, h3 { font-weight: 700; letter-spacing: -0.015em; }
.fq-content { padding: 4.5rem 0 5.5rem; background: var(--white); }
.fq-item p { max-width: calc(var(--measure) + 2.8rem); }
.fq-group { margin-bottom: 3rem; }
.fq-group-title { font-size: clamp(1.35rem, 2.4vw, 1.7rem); color: var(--navy); margin-bottom: 1rem; padding-bottom: 0.6rem; border-bottom: 1px solid rgba(15, 37, 72, 0.14); }
.fq-list { display: flex; flex-direction: column; gap: 0.6rem; }
.fq-item { background: white; border: 1px solid rgba(15, 37, 72, 0.12); border-radius: 10px; overflow: hidden; }
.fq-item[open] { border-color: rgba(15, 37, 72, 0.3); }
.fq-item summary {
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: 1.15rem 1.4rem; cursor: pointer; list-style: none;
  font-weight: 600; font-size: 1rem; color: var(--navy);
}
.fq-item summary::-webkit-details-marker { display: none; }
:global(.fq-arrow) { color: var(--navy); flex-shrink: 0; transition: transform 0.2s ease; }
.fq-item[open] :global(.fq-arrow) { transform: rotate(180deg); }
.fq-item p { padding: 0 1.4rem 1.25rem; font-size: 0.97rem; line-height: 1.75; color: var(--gray-600); }

.fq-cta-card {
  display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: 2.5rem; align-items: center;
  background: #f6f7f9; border: 1px solid rgba(15, 37, 72, 0.08); border-radius: 12px; padding: 2.5rem;
  margin-top: 1rem;
}
.fq-cta-card h3 { font-size: clamp(1.4rem, 2.6vw, 1.8rem); color: var(--navy); margin-bottom: 0.75rem; }
.fq-cta-card p { color: var(--gray-600); line-height: 1.7; margin-bottom: 1.5rem; }
.fq-cta-btns { display: flex; gap: 1rem; flex-wrap: wrap; }
/* Photo fills the height of the text column (floor 220px) in a fixed 22rem column, instead of a fixed square */
.fq-cta-photo { position: relative; align-self: stretch; min-height: 220px; }
.fq-cta-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 22%; border-radius: 4px; background: #e9edf2; }

@media (max-width: 768px) {
  .fq-content { padding: 3rem 0 4rem; }
  .fq-item summary { padding: 1.05rem 1.15rem; font-size: 0.97rem; }
  .fq-item p { padding: 0 1.15rem 1.1rem; }
  .fq-cta-card { grid-template-columns: 1fr; padding: 1.75rem 1.35rem; gap: 1.5rem; }
  .fq-cta-photo { max-width: 320px; }
  .fq-cta-photo { min-height: 0; }
  .fq-cta-photo img { position: static; height: auto; aspect-ratio: 4 / 3; }
  .fq-cta-btns { flex-direction: column; align-items: stretch; }
  .fq-cta-btns .btn { justify-content: center; }
}

/* Mobile: cards keep a 1rem side padding inside the page gutter */
@media (max-width: 768px) {
  .fq-item summary,
  .fq-item p,
  .fq-cta-card {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}
</style>
