---
import Layout from '../../components/Layout.astro';
import LineIcon from '../../components/LineIcon.astro';
import PageHero from '../../components/PageHero.astro';
import { photo, photosFor } from '../../lib/servicePhotos';
import CoreExpertiseLinks from '../../components/CoreExpertiseLinks.astro';
import { expertiseForPage } from '../../data/expertiseLinks.js';

// Service pages, staging-gated (all on staging; only approved on production).
import { servicesData } from '../../data/pseo/services.js';

const allPages: any[] = [...(servicesData as any[])];
const pageMap = new Map<string, any>(allPages.map((p: any) => [p.slug, p]));

export function getStaticPaths() {
  return (servicesData as any[]).map((p: any) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const entry: any = pageMap.get(slug as string);
if (!entry) return Astro.redirect('/solutions/');

// ---- Data with safe fallbacks (content may still be in flight) ----
const name: string = entry.name || entry.title || 'HR Service';
const tagline: string = entry.tagline || entry.subtitle || '';
const heroText: string = entry.hero || entry.subtitle || '';
const metaDescription: string = entry.metaDescription || entry.subtitle || heroText;

const heroCards = entry.heroCards || {};
const heroCardTl = heroCards.tl || null;
const heroCardBr = heroCards.br || null;

const premiseHeading: string = entry.premiseHeading || '';
const premiseBody: string[] = Array.isArray(entry.premiseBody) ? entry.premiseBody : [];

const included: any[] = Array.isArray(entry.included) ? entry.included : [];
const benefits: any[] = Array.isArray(entry.benefits) ? entry.benefits : [];
const examples: any[] = Array.isArray(entry.examples) ? entry.examples : [];
const process: any[] = Array.isArray(entry.process) ? entry.process : [];
const ideal: string[] = Array.isArray(entry.ideal) ? entry.ideal : [];
const faqs: any[] = Array.isArray(entry.faqs) ? entry.faqs : [];

const sections = entry.sections || {};
const sec = (key: string, fallback: { eyebrow: string; heading: string; desc: string }) => ({
  eyebrow: (sections[key] && sections[key].eyebrow) || fallback.eyebrow,
  heading: (sections[key] && sections[key].heading) || fallback.heading,
  desc: (sections[key] && sections[key].desc) || fallback.desc,
});

const secIncluded = sec('included', {
  eyebrow: 'What You Get',
  heading: `What is included in ${name}`,
  desc: 'Everything covered from day one, agreed in writing before we start.',
});
const secBenefits = sec('benefits', {
  eyebrow: 'Why Clients Choose It',
  heading: 'What this delivers for you',
  desc: 'Senior HR capacity without the cost, delay and risk of hiring permanently.',
});
const secExamples = sec('examples', {
  eyebrow: 'In Practice',
  heading: 'What this looks like in real companies',
  desc: 'Three anonymised situations we handled, and what the client walked away with.',
});
const secProcess = sec('process', {
  eyebrow: 'How It Works',
  heading: 'From first call to work in progress',
  desc: 'A short, predictable start. You know who you get and what happens next.',
});
const secIdeal = sec('ideal', {
  eyebrow: 'Who It Is For',
  heading: `Companies that benefit most from ${name}`,
  desc: 'If any of these describe your situation, this service will fit.',
});
const secFaq = sec('faq', {
  eyebrow: 'Common Questions',
  heading: 'Questions buyers ask us',
  desc: 'Straight answers on speed, pricing and commitment.',
});

// Parent solution package this service belongs to (optional in the data)
const parentService: string = entry.parentService || '';
const parentServiceName: string = entry.parentServiceName || '';

// Related services
const relatedPages: any[] = (entry.relatedSlugs || [])
  .map((s: string) => pageMap.get(s))
  .filter(Boolean)
  .slice(0, 3);

// Core expertise pages on the same topics (data/expertiseLinks.js)
const expertiseSlugs = expertiseForPage(slug as string);

// Documentary photos per slug (see src/lib/servicePhotos.ts)
const heroImage = photo(photosFor(slug as string).hero);
const contentImage = photo(photosFor(slug as string).story);
const processImage = photo(photosFor(slug as string).process);
const ctaImage = { src: '/images/home/cornelis-candid.jpg', width: 962, height: 825 };
const relatedImage = (s: string) => photo(photosFor(s).hero, true);

const pageUrl = `https://www.hrhelp.nl/services/${slug}/`;

// ---- Structured data ----
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: name,
  serviceType: name,
  description: heroText,
  provider: {
    '@type': 'Organization',
    name: 'HRHelp.nl',
    url: 'https://www.hrhelp.nl',
  },
  areaServed: { '@type': 'Country', name: 'Netherlands' },
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: pageUrl,
    servicePhone: '+31-85-760-8188',
  },
  url: pageUrl,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.hrhelp.nl' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://www.hrhelp.nl/services/' },
    { '@type': 'ListItem', position: 3, name: name, item: pageUrl },
  ],
};

const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq: any) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
} : null;

const schemas = [serviceSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<Layout title={entry.title || name} description={metaDescription} schema={schemas}>

<!-- ===== HERO ===== -->
<PageHero variant="split" title={name} image={{ ...heroImage, alt: name }}>
  <nav class="svc-breadcrumb" aria-label="Breadcrumb" slot="top">
    <a href="/">Home</a>
    <span class="svc-bc-sep">›</span>
    <a href="/services/">Services</a>
    <span class="svc-bc-sep">›</span>
    <span class="svc-bc-current">{name}</span>
  </nav>
  <Fragment slot="eyebrow">
    {parentService && parentServiceName && (
      <a href={parentService} class="svc-parent-pill">
        Part of {parentServiceName}
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    )}
  </Fragment>
  {tagline && <p class="svc-hero-tagline">{tagline}</p>}
  <p class="svc-hero-desc">{heroText}</p>
  <div class="page-hero-actions svc-hero-actions">
    <a href="/contact/" class="btn btn-primary btn-lg">Book free consultation</a>
    <a href="/services/" class="btn btn-secondary btn-lg">See all services</a>
  </div>
  <ul class="svc-hero-proof">
    <li>
      <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      <span>Senior consultants only</span>
    </li>
    <li>
      <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      <span>Fixed pricing agreed upfront</span>
    </li>
    <li>
      <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      <span>Consultants with 15+ years in Dutch employment law</span>
    </li>
  </ul>
  <ul class="svc-hero-facts" slot="media">
    {heroCardTl && (
      <li>
        <span class="svc-fact-label">{heroCardTl.label}</span>
        <strong class="svc-fact-value">{heroCardTl.value}</strong>
      </li>
    )}
    {heroCardBr && (
      <li>
        <span class="svc-fact-label">{heroCardBr.label}</span>
        <strong class="svc-fact-value">{heroCardBr.value}</strong>
      </li>
    )}
    <li class="svc-fact-note">
      <span>One named consultant per client</span>
    </li>
  </ul>
</PageHero>

<!-- ===== PREMISE / STORY ===== -->
<section class="svc-story section-white">
  <div class="container">
    <div class="svc-story-split">
      <div class="svc-story-text">
        {premiseHeading && (
          <div class="svc-story-insight">
            <h2>{premiseHeading}</h2>
          </div>
        )}
        {premiseBody.map((p: string, i: number) => (
          <p class={i === 0 ? 'svc-story-lead' : ''}>{p}</p>
        ))}
        <div class="svc-story-cta-line">
          <a href="/contact/" class="svc-story-link">
            Talk to a senior consultant
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
      </div>

      <figure class="svc-story-illus">
        <img src={contentImage.src} alt={`${name} at HRhelp`} class="svc-story-photo" loading="lazy" decoding="async" width={contentImage.width} height={contentImage.height} />
        <figcaption class="svc-story-caption">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span><span class="svc-overlay-label">Trusted by</span> <span class="svc-overlay-value">75+ international clients</span></span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- ===== WHAT'S INCLUDED ===== -->
{included.length > 0 && (
<section class="svc-included section-cream" id="svc-included">
  <div class="container">
    <div class="section-header svc-head-split">
      <div>
        <span class="eyebrow">{secIncluded.eyebrow}</span>
        <h2>{secIncluded.heading}</h2>
      </div>
      <p class="section-desc">{secIncluded.desc}</p>
    </div>
    <div class="svc-feature-grid">
      {included.map((item: any, i: number) => (
        <div class="svc-feature-card">
          <div class="svc-feature-top">
            <LineIcon name={item.icon} class="svc-line-ico" />
            <span class="svc-feature-num">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
)}

<!-- ===== BENEFITS ===== -->
{benefits.length > 0 && (
<section class="svc-benefits section-white">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">{secBenefits.eyebrow}</span>
      <h2>{secBenefits.heading}</h2>
      <p class="section-desc">{secBenefits.desc}</p>
    </div>
    <div class="svc-benefit-grid">
      {benefits.map((item: any) => (
        <div class="svc-benefit-card">
          <LineIcon name={item.icon} class="svc-line-ico svc-benefit-icon" />
          <div class="svc-benefit-body">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
)}

<!-- ===== EXAMPLES IN PRACTICE ===== -->
{examples.length > 0 && (
<section class="svc-examples section-cream">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">{secExamples.eyebrow}</span>
      <h2>{secExamples.heading}</h2>
      <p class="section-desc">{secExamples.desc}</p>
    </div>
    <div class="svc-example-grid">
      {examples.map((ex: any, i: number) => (
        <article class="svc-example-card">
          <div class="svc-example-head">
            <span class="svc-example-tag">{ex.tag}</span>
            <span class="svc-example-index">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="svc-example-block">
            <span class="svc-example-label">The situation</span>
            <p class="svc-example-situation">{ex.situation}</p>
          </div>
          <div class="svc-example-result">
            <span class="svc-example-label svc-label-result">What we delivered</span>
            <p>{ex.result}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="svc-example-note">Client situations are anonymised. Names and identifying details have been changed.</p>
  </div>
</section>
)}

<!-- ===== HOW IT WORKS ===== -->
{process.length > 0 && (
<section class="svc-process section-white">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">{secProcess.eyebrow}</span>
      <h2>{secProcess.heading}</h2>
      <p class="section-desc">{secProcess.desc}</p>
    </div>

    <div class="svc-process-split">
      <div class="svc-process-visual">
        <img src={processImage.src} alt={`How ${name} works`} loading="lazy" decoding="async" width={processImage.width} height={processImage.height} />
      </div>

      <ol class="svc-timeline">
        {process.map((step: any, i: number) => (
          <li class="svc-timeline-step">
            <span class="svc-step-num">{step.step || String(i + 1).padStart(2, '0')}</span>
            <div class="svc-timeline-content">
              {step.timeframe && <span class="svc-step-badge">{step.timeframe}</span>}
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
)}

<!-- ===== FIXED PRICING BAND ===== -->
<section class="svc-pricing section-navy">
  <div class="container">
    <div class="svc-pricing-inner">
      <div class="svc-pricing-text">
        <span class="eyebrow svc-eyebrow-light">Pricing</span>
        <h2>Fixed pricing, agreed before we start</h2>
        <p>You get a written scope and a fixed fee before any work begins, so the cost is settled at the start instead of arriving as an hourly invoice at the end of the month.</p>
        <ul class="svc-pricing-chips">
          <li>No hourly billing</li>
          <li>One named senior consultant</li>
          <li>Scope agreed in writing</li>
        </ul>
      </div>
      <div class="svc-pricing-action">
        <a href="/contact/" class="btn btn-primary btn-lg">Get your fixed quote</a>
        <span class="svc-pricing-note">Free 30 minute consultation, no obligation.</span>
      </div>
    </div>
  </div>
</section>

<!-- ===== WHO IT IS FOR ===== -->
{ideal.length > 0 && (
<section class="svc-ideal section-cream">
  <div class="container">
    <div class="section-header svc-head-split">
      <div>
        <span class="eyebrow">{secIdeal.eyebrow}</span>
        <h2>{secIdeal.heading}</h2>
      </div>
      <p class="section-desc">{secIdeal.desc}</p>
    </div>
    <div class="svc-ideal-grid">
      {ideal.map((item: string, i: number) => (
        <div class="svc-ideal-card">
          <span class="svc-ideal-num">{String(i + 1).padStart(2, '0')}</span>
          <p>{item}</p>
        </div>
      ))}
    </div>
  </div>
</section>
)}

<!-- ===== FAQ ===== -->
{faqs.length > 0 && (
<section class="svc-faq section-white">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">{secFaq.eyebrow}</span>
      <h2>{secFaq.heading}</h2>
      <p class="section-desc">{secFaq.desc}</p>
    </div>
    <div class="svc-faq-list">
      {faqs.map((faq: any) => (
        <details class="svc-faq-item">
          <summary>
            <span>{faq.q}</span>
            <svg aria-hidden="true" class="svc-faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="svc-faq-answer">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
)}

<!-- ===== CTA ===== -->
<section class="svc-cta section-white">
  <div class="container">
    <div class="svc-cta-inner">
      <div class="svc-cta-content">
        <span class="eyebrow">Next Step</span>
        <h2>Ready to get started with {name}?</h2>
        <p>Book a free 30 minute consultation. We will look at your situation, tell you exactly what we would do, and put a fixed price in writing before you commit to anything.</p>
        <div class="svc-cta-buttons">
          <a href="/contact/#book" class="btn btn-primary btn-lg">Book a Free Consultation</a>
          {parentService && parentServiceName ? (
            <a href={parentService} class="btn btn-secondary btn-lg">Explore {parentServiceName}</a>
          ) : (
            <a href="/services/" class="btn btn-secondary btn-lg">See all HR services</a>
          )}
        </div>
      </div>
      <div class="svc-cta-photo">
        <img src={ctaImage.src} alt="Cornelis Leerlooijer, founder of HRHelp" loading="lazy" decoding="async" width={ctaImage.width} height={ctaImage.height} />
      </div>
    </div>
  </div>
</section>

<!-- ===== RELATED ===== -->
{relatedPages.length > 0 && (
<section class="svc-related section-cream">
  <div class="container">
    <div class="section-header svc-head-split">
      <div>
        <span class="eyebrow">Keep Exploring</span>
        <h2>Related services</h2>
      </div>
      <p class="section-desc">Other ways we support international employers operating in the Netherlands.</p>
    </div>
    <div class="svc-related-grid">
      {relatedPages.map((r: any) => {
        const img = relatedImage(r.slug);
        return (
          <a href={`/services/${r.slug}/`} class="svc-related-card">
            <div class="svc-related-media">
              <img src={img.src} alt={r.name || r.title} loading="lazy" decoding="async" width={img.width} height={img.height} />
            </div>
            <div class="svc-related-body">
              <h3>{r.name || r.title}</h3>
              <p>{r.tagline || r.subtitle}</p>
              <span class="svc-related-link">
                View service
                <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
              </span>
            </div>
          </a>
        );
      })}
    </div>
    {expertiseSlugs.length > 0 && (
      <div class="svc-expertise"><CoreExpertiseLinks slugs={expertiseSlugs} /></div>
    )}
  </div>
</section>
)}

</Layout>

<style>
/* Same sections and order as before; calmer treatment matching the homepage:
   hairline cards (10-12px), one soft shadow, 700 headings, muted eyebrows,
   plain navy line icons, orange only for buttons and small markers. */
h1, h2, h3, h4 { font-weight: 700; letter-spacing: -0.015em; }

.eyebrow {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  color: #44546d;
  margin-bottom: 0.75rem;
}
.svc-eyebrow-light { color: rgba(255, 255, 255, 0.88); }

.section-desc {
  max-width: 660px;
  margin: 0.75rem auto 0;
  color: var(--gray-600);
  font-size: 1.05rem;
  line-height: 1.7;
  text-align: center;
}

/* Left-aligned header for list-like sections (as "What We Handle" on the homepage) */
.svc-head-split {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 2.5rem;
  max-width: none;
  text-align: left;
  margin: 0 0 2.75rem;
}
.svc-head-split h2 { margin-bottom: 0; font-size: clamp(1.7rem, 3.2vw, 2.4rem); }
.svc-head-split .section-desc {
  margin: 0;
  max-width: 400px;
  text-align: right;
  font-size: 1rem;
}

:global(.svc-line-ico) { display: block; color: var(--icon-accent); flex-shrink: 0; }

/* ========== HERO (PageHero split) ========== */
.svc-bc-sep { color: var(--gray-400); }
.svc-bc-current { color: var(--navy); }

.svc-parent-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #44546d;
  margin-bottom: 1rem;
  text-decoration: none;
}
.svc-parent-pill:hover { color: var(--navy); text-decoration: underline; text-decoration-color: var(--orange-ink); text-underline-offset: 3px; }

.svc-hero-tagline {
  font-size: clamp(1.1rem, 1.8vw, 1.25rem);
  font-weight: 600;
  color: var(--navy);
  line-height: 1.45;
  margin-bottom: 1.1rem;
}
.svc-hero-desc {
  font-size: 1.125rem;
  color: var(--gray-600);
  line-height: 1.65;
  max-width: 620px;
}
.svc-hero-actions { margin-bottom: 1.75rem; }
.svc-hero-proof {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
  padding: 0;
  margin: 0;
}
.svc-hero-proof li {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--gray-600);
}
.svc-hero-proof svg { color: var(--orange-ink); flex-shrink: 0; }

/* Former floating badges, now one calm row under the photo */
.svc-hero-facts {
  list-style: none;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 1.25rem;
  margin: 1.25rem 0 0;
  padding: 1.1rem 0 0;
  border-top: 1px solid rgba(15, 37, 72, 0.14);
}
.svc-hero-facts li + li { border-left: 1px solid rgba(15, 37, 72, 0.12); padding-left: 1.25rem; }
.svc-fact-label {
  display: block;
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #44546d;
  margin-bottom: 0.25rem;
}
.svc-fact-value {
  display: block;
  font-size: 0.93rem;
  font-weight: 600;
  color: var(--navy);
  line-height: 1.35;
}
.svc-fact-note span {
  display: block;
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--gray-600);
  line-height: 1.4;
}

/* ========== STORY / PREMISE ========== */
.svc-story { padding: 6rem 0 5.5rem; }
.svc-story-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}
.svc-story-text { display: flex; flex-direction: column; gap: 1.3rem; }
.svc-story-insight {
  border-left: 3px solid var(--orange);
  padding: 0.15rem 0 0.15rem 1.4rem;
  margin-bottom: 0.4rem;
}
.svc-story-insight h2 {
  font-size: clamp(1.25rem, 2.2vw, 1.6rem);
  line-height: 1.4;
  color: var(--navy);
  margin: 0;
}
.svc-story-text p {
  font-size: 1.05rem;
  color: var(--gray-600);
  line-height: 1.8;
  margin: 0;
}
