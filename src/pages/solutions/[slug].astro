.sv-testimonial-avatar span { color: var(--navy); font-size: 0.85rem; font-weight: 600; letter-spacing: 0.04em; }
.sv-testimonial-author strong { display: block; font-size: 1rem; color: var(--navy); margin-bottom: 0.1rem; }
