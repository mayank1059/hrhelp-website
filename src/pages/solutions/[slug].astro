}
.sv-testimonial-card blockquote::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 32px;
  height: 2px;
  background: var(--orange);
}
.sv-testimonial-author {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(15, 37, 72, 0.08);
}
.sv-testimonial-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
