}
.sv-story-text p { font-size: 1.05rem; color: var(--gray-600); line-height: 1.8; }
.sv-story-lead {
  font-size: 1.12rem !important;
  color: var(--navy) !important;
  line-height: 1.75 !important;
}
.sv-story-cta-line { padding-top: 0.3rem; }
.sv-story-link {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 1rem;
  font-weight: 600;
  color: var(--navy);
  text-decoration: underline;
  text-decoration-color: var(--orange-ink);
  text-underline-offset: 4px;
}
.sv-story-link:hover { color: var(--navy); text-decoration-thickness: 2px; }
/* Photo fills the height of the text column (floor 400px) instead of a fixed 4:5 */
.sv-story-illus { margin: 0; align-self: stretch; display: flex; flex-direction: column; }
.sv-story-photo {
  display: block;
  flex: 1 1 0;
  min-height: 400px;
