.sv-sol-item svg { color: var(--navy); flex-shrink: 0; margin-top: 3px; }
.sv-sol-item strong { display: block; font-size: 1rem; color: var(--navy); margin-bottom: 0.2rem; }
.sv-sol-item span { font-size: 0.92rem; color: var(--gray-600); line-height: 1.55; }

/* ========== TESTIMONIAL ========== */
.sv-testimonial { padding: 5rem 0; }
.sv-testimonial-card {
  background: white;
  padding: 2.75rem 3.25rem 2.5rem;
  border: 1px solid rgba(15, 37, 72, 0.1);
  border-radius: 12px;
  box-shadow: 0 1px 2px rgba(15, 37, 72, 0.04), 0 4px 14px rgba(15, 37, 72, 0.04);
}
.sv-testimonial-card blockquote {
  position: relative;
  max-width: 920px;
  font-size: clamp(1.2rem, 2vw, 1.45rem);
  font-weight: 500;
  line-height: 1.55;
  letter-spacing: -0.01em;
  color: var(--navy);
  margin: 0 0 2rem;
