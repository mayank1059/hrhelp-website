  padding: 1.1rem 0 0;
  border-top: 1px solid rgba(15, 37, 72, 0.14);
}
.sv-hero-facts li + li { border-left: 1px solid rgba(15, 37, 72, 0.12); padding-left: 1.25rem; }
.floating-label {
  display: block;
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #44546d;
  margin-bottom: 0.25rem;
}
.floating-value { display: block; font-size: 0.95rem; font-weight: 600; color: var(--navy); line-height: 1.35; }
.sv-fact-note span { display: block; font-size: 0.88rem; font-weight: 500; color: var(--gray-600); line-height: 1.4; }

/* ========== STORY ========== */
.sv-story { padding: 6rem 0 5rem; background: var(--white); }
.sv-story-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}
.sv-story-text { display: flex; flex-direction: column; gap: 1.3rem; }
.sv-story-insight {
  border-left: 3px solid var(--orange);
  padding: 0.15rem 0 0.15rem 1.4rem;
  margin-bottom: 0.4rem;
}
.sv-story-insight h2 {
  font-size: clamp(1.2rem, 2.1vw, 1.5rem);
  line-height: 1.45;
  color: var(--navy);
