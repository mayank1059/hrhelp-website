const { slug } = Astro.params;
if (!slug || !serviceData[slug]) {
  return Astro.redirect('/solutions/');
}
const service = serviceData[slug];
const related = service.relatedServices.map((s: string) => ({ slug: s, ...serviceData[s] }));

// Specialist service pages that sit under this package (staging-gated source)
const packageServices = servicesForSolution(slug);
// Core expertise pages on the same topics (data/expertiseLinks.js)
const expertiseSlugs = expertiseForPage(slug);

export function getStaticPaths() {
  return [
    { params: { slug: 'hr-settlers' } },
    { params: { slug: 'hr-teams' } },
    { params: { slug: 'hr-reset' } },
    { params: { slug: 'hr-sos' } },
  ];
}

const solutionSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.hero,
  "provider": {
    "@type": "Organization",
    "name": "HRHelp.nl",
    "url": "https://www.hrhelp.nl"
  },
  "areaServed": { "@type": "Country", "name": "Netherlands" },
  "url": `https://www.hrhelp.nl/solutions/${slug}/`
};
---

<Layout title={`${service.name}`} description={service.hero} schema={solutionSchema}>

<!-- HERO -->
<PageHero variant="split" eyebrow={service.name} title={service.tagline} image={{ src: service.heroPhoto, width: 1200, height: 900, alt: service.name }}>
  <p class="sv-hero-desc">{service.hero}</p>
  <div class="page-hero-actions">
    <a href="/contact/" class="btn btn-primary btn-lg">Book a Consultation</a>
    <a href="#sv-included" class="btn btn-secondary btn-lg">What's Included</a>
  </div>
  <ul class="sv-hero-facts" slot="media">
    <li>
      <span class="floating-label">{service.heroCards.tl.label}</span>
      <strong class="floating-value">{service.heroCards.tl.value}</strong>
    </li>
    <li>
      <span class="floating-label">{service.heroCards.br.label}</span>
      <strong class="floating-value">{service.heroCards.br.value}</strong>
