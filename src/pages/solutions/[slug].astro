<style>
/* Same sections and order as before; calmer treatment matching the homepage:
   no glass or floating badges, hairline cards (10-12px), 700 headings, muted
   eyebrows, plain navy line icons, orange only for buttons and small markers,
   documentary photos in the hero and story; related-solution cards use the
   redrawn solution illustrations. */
h1, h2, h3, h4 { font-weight: 700; letter-spacing: -0.015em; }

.eyebrow {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  color: #44546d;
  margin-bottom: 0.75rem;
}
.sv-eyebrow-light { color: rgba(255, 255, 255, 0.88); }

.section-desc {
  max-width: 640px;
  margin: 0.75rem auto 0;
  color: var(--gray-600);
  font-size: 1.05rem;
  line-height: 1.7;
  text-align: center;
}

.sv-head-split {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 2.5rem;
  max-width: none;
  text-align: left;
  margin: 0 0 2.75rem;
}
.sv-head-split h2 { margin-bottom: 0; font-size: clamp(1.7rem, 3.2vw, 2.4rem); }
.sv-head-split .section-desc { margin: 0; max-width: 420px; text-align: right; font-size: 1rem; }

:global(.sv-line-ico) { display: block; color: var(--icon-accent); flex-shrink: 0; }

/* ========== HERO (PageHero split) ========== */
