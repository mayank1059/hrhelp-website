---
import Layout from '../../components/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import LineIcon from '../../components/LineIcon.astro';

const services = [
  {
    slug: 'hr-settlers',
    name: 'HR Settlers',
    tagline: 'Enter the Dutch market with confidence',
    badge: 'Market Entry',
    illus: '/images/solutions-illus/style1-final-settlers',
    illusAlt: 'Illustration of a businesswoman planting a flag on a map of the Netherlands, a briefcase beside her',
    description: 'Complete HR infrastructure for companies establishing their first presence in the Netherlands. From entity setup to your first hire.',
    features: ['Entity & payroll setup', '30% ruling applications', 'Employment contracts', 'Visa & work permits', 'Compliance framework', 'First 90 days support'],
    ideal: 'Companies opening their first Netherlands office or hiring their first Dutch employee.',
    timeline: '2-6 weeks',
    model: 'Project',
  },
  {
    slug: 'hr-teams',
    name: 'HR Teams',
    tagline: 'Your outsourced HR department',
    badge: 'Outsourced HR',
    illus: '/images/solutions-illus/style1-final-teams',
    illusAlt: 'Illustration of an HR manager with a checklist working alongside a small team',
    description: 'Full HR management with a dedicated HR manager for growing international businesses in the Netherlands.',
    features: ['Dedicated HR Manager', 'Policy development', 'Employee lifecycle', 'Performance management', 'Strategic HR planning', 'Quarterly reviews'],
    ideal: 'Growing companies with 5-50+ employees who need ongoing HR support without a full in-house team.',
    timeline: 'Ongoing',
    model: 'Retainer',
  },
  {
    slug: 'hr-reset',
    name: 'HR Reset',
    tagline: 'Modernise your existing HR',
    badge: 'Transformation',
    illus: '/images/solutions-illus/style1-final-reset',
    illusAlt: 'Illustration of a person rebuilding a wall of blocks under a circular refresh arrow',
    description: 'HR audit and transformation for established companies with compliance gaps or legacy processes holding them back.',
    features: ['Full HR compliance audit', 'Contract modernisation', 'Process optimization', 'Restructuring support', 'Policy overhaul', 'Change management'],
    ideal: 'Established companies with outdated HR policies, compliance concerns, or undergoing organisational change.',
    timeline: '4-12 weeks',
    model: 'Project',
  },
  {
    slug: 'hr-sos',
    name: 'HR S.O.S.',
    tagline: 'Urgent HR crisis support',
    badge: 'Urgent Support',
    badgeClass: 'sol2-badge-red',
    illus: '/images/solutions-illus/style1-final-sos',
    illusAlt: 'Illustration of a consultant running with a lifebuoy past an alert sign and a stopwatch',
    description: 'Rapid-response support for urgent HR situations: dismissals, workplace conflicts, legal disputes.',
    features: ['Same-business-day response', 'Dismissal procedures', 'Settlement agreements', 'Conflict resolution', 'Legal liaison', 'UWV procedures'],
    ideal: 'Any company facing an urgent HR crisis that requires immediate expert guidance.',
    timeline: 'Immediate',
    model: 'On-demand',
  }
];
---

<Layout title="Solutions" description="HR solutions for every stage of doing business in the Netherlands. From market entry to full HR outsourcing.">

<!-- ===== HERO ===== -->
<PageHero variant="archive" eyebrow="Our Solutions" subtitle="From your first Dutch hire to full organisational transformation, we have the right HR solution for each stage of your business in the Netherlands.">
  <Fragment slot="title">HR Solutions Built for<br/><span>Every Business Stage</span></Fragment>
  <div class="page-hero-actions">
    <a href="/contact/" class="btn btn-primary btn-lg">Book Free Consultation →</a>
    <a href="#solutions" class="btn btn-secondary btn-lg">View Solutions</a>
  </div>
  <div class="sol2-hero-trust">
    <div class="sol2-trust-item">
      <span class="sol2-trust-value">75+</span>
      <span class="sol2-trust-label">Clients Served</span>
    </div>
    <div class="sol2-trust-item">
      <span class="sol2-trust-value">98%</span>
      <span class="sol2-trust-label">Client Retention</span>
    </div>
    <div class="sol2-trust-item">
      <span class="sol2-trust-value">20+</span>
      <span class="sol2-trust-label">Years in HR</span>
    </div>
    <div class="sol2-trust-item">
      <span class="sol2-trust-value">100%</span>
      <span class="sol2-trust-label">NL Compliant</span>
    </div>
  </div>
</PageHero>

<!-- ===== SOLUTIONS SHOWCASE ===== -->
<section class="sol2-showcase section-white" id="solutions">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Our Solutions</span>
      <h2>Choose Your Path Forward</h2>
      <p>Four specialized solutions designed for different stages and challenges of operating in the Netherlands.</p>
    </div>

    <div class="sol2-cards">
      {services.map((service, i) => (
        <a href={`/solutions/${service.slug}/`} class="sol2-card">
          <div class="sol2-card-illus">
            <picture>
              <source srcset={`${service.illus}.webp`} type="image/webp" />
              <img src={`${service.illus}.png`} alt={service.illusAlt} width="800" height="800" loading="lazy" decoding="async" />
            </picture>
            <span class={`sol2-card-badge ${service.badgeClass || ''}`}>{service.badge}</span>
          </div>
          <div class="sol2-card-content">
            <h3>{service.name}</h3>
            <p class="sol2-card-tagline">{service.tagline}</p>
            <p class="sol2-card-desc">{service.description}</p>
            <ul class="sol2-card-features">
              {service.features.map((f: string) => (
                <li>
                  <LineIcon name="check" size={14} class="sol2-check" />
                  {f}
                </li>
              ))}
            </ul>
            <div class="sol2-card-meta">
              <span class="sol2-meta-item">
                <LineIcon name="schedule" size={16} class="sol2-meta-ico" />
                {service.timeline}
              </span>
              <span class="sol2-meta-item">
                <LineIcon name="handshake" size={16} class="sol2-meta-ico" />
                {service.model}
              </span>
            </div>
            <span class="sol2-card-link">Explore {service.name} →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ===== COMPARISON TABLE ===== -->
<section class="sol2-comparison section-cream">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Compare</span>
      <h2>Which Solution Fits You?</h2>
      <p>A quick comparison to help you decide.</p>
    </div>
    <div class="comp-table-wrap" tabindex="0" role="region" aria-label="Solution comparison table">
      <table class="comp-table">
        <thead>
          <tr>
            <th>Feature</th>
            <th>HR Settlers</th>
            <th>HR Teams</th>
            <th>HR Reset</th>
            <th>HR S.O.S.</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Best for</td><td>Market entry</td><td>Ongoing HR</td><td>Transformation</td><td>Crises</td></tr>
          <tr><td>Dedicated consultant</td><td class="check">✓</td><td class="check">✓</td><td class="check">✓</td><td class="check">✓</td></tr>
          <tr><td>Employment contracts</td><td class="check">✓</td><td class="check">✓</td><td class="check">✓</td><td>–</td></tr>
          <tr><td>Payroll setup</td><td class="check">✓</td><td class="check">✓</td><td>–</td><td>–</td></tr>
          <tr><td>30% Ruling</td><td class="check">✓</td><td class="check">✓</td><td>–</td><td>–</td></tr>
          <tr><td>HR policy development</td><td>Basic</td><td>Full</td><td>Full</td><td>–</td></tr>
          <tr><td>Compliance audit</td><td>–</td><td>Annual</td><td class="check">✓</td><td>–</td></tr>
          <tr><td>Dismissal support</td><td>–</td><td class="check">✓</td><td class="check">✓</td><td class="check">✓</td></tr>
          <tr><td>Same-business-day response</td><td>–</td><td>–</td><td>–</td><td class="check">✓</td></tr>
          <tr><td>Engagement model</td><td>Project</td><td>Retainer</td><td>Project</td><td>On-demand</td></tr>
          <tr><td>Timeline</td><td>2-6 weeks</td><td>Ongoing</td><td>4-12 weeks</td><td>Immediate</td></tr>
        </tbody>
      </table>
    </div>
    <div class="comp-cta">
      <p>Not sure which fits? Let us help you decide.</p>
      <a href="/contact/" class="btn btn-primary btn-lg">Book a Free Consultation →</a>
    </div>
  </div>
</section>

<!-- ===== PROCESS ===== -->
<section class="sol2-process section-white">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">How It Works</span>
      <h2>Getting Started is Simple</h2>
    </div>
    <div class="sol2-process-row">
      <div class="sol2-process-step">
        <div class="sol2-process-num">01</div>
        <h3 class="as-h4">Free Discovery Call</h3>
        <p>30-minute call to understand your situation and recommend the best solution.</p>
      </div>
      <div class="sol2-process-step">
        <div class="sol2-process-num">02</div>
        <h3 class="as-h4">Custom Proposal</h3>
        <p>Detailed scope, timeline, and fixed pricing within 48 hours. No surprises.</p>
      </div>
      <div class="sol2-process-step">
        <div class="sol2-process-num">03</div>
        <h3 class="as-h4">Start Immediately</h3>
        <p>Your dedicated consultant begins work. Regular updates, full transparency.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="sol2-cta section-cream">
  <div class="container sol2-cta-inner">
    <h2>Ready to Take the Next Step?</h2>
    <p>Book a free 30-minute discovery call and let's find the right solution for your business.</p>
    <div class="sol2-cta-actions">
      <a href="/contact/" class="btn btn-primary btn-lg">Book Free Consultation →</a>
      <span class="sol2-cta-phone">Or call: <strong>+31 85 760 8188</strong></span>
    </div>
  </div>
</section>

</Layout>

<style>
/* Same sections as before, calmer treatment matching the homepage: shared
   PageHero, no mesh/gradient text/floating glass, 700 headings, muted eyebrows,
   numerals instead of icon tiles. Each solution card shows its redrawn
   illustration; the hero keeps the documentary photo. */
h1, h2, h3, h4 { font-weight: 700; letter-spacing: -0.015em; }
.eyebrow {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  color: #44546d;
  margin-bottom: 0.75rem;
}
.section-header p { line-height: 1.7; }

/* ===== HERO ===== */
/* Hero uses PageHero (archive); trust figures sit under the buttons */
.sol2-hero-trust {
  display: flex; flex-wrap: wrap; gap: 1.25rem 2.5rem;
  margin-top: 2.25rem; padding-top: 1.25rem;
  border-top: 1px solid rgba(15, 37, 72, 0.14);
  max-width: 620px;
}
.sol2-trust-item { display: flex; flex-direction: column; }
.sol2-trust-value { font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; color: var(--navy); line-height: 1.1; }
.sol2-trust-label { font-size: 0.7rem; font-weight: 600; color: #44546d; text-transform: uppercase; letter-spacing: 0.12em; margin-top: 0.35rem; }

/* ===== SOLUTIONS SHOWCASE ===== */
.sol2-showcase { padding: var(--section-padding); }
.sol2-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
.sol2-card {
  display: flex; flex-direction: column;
  text-decoration: none;
  background: white;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(15, 37, 72, 0.1);
  box-shadow: 0 1px 2px rgba(15, 37, 72, 0.04), 0 4px 14px rgba(15, 37, 72, 0.04);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.sol2-card:hover {
  border-color: rgba(15, 37, 72, 0.22);
  box-shadow: 0 1px 2px rgba(15, 37, 72, 0.05), 0 8px 24px rgba(15, 37, 72, 0.07);
}
.sol2-card-illus { position: relative; aspect-ratio: 16 / 9; background: white; overflow: hidden; border-bottom: 1px solid rgba(15, 37, 72, 0.08); }
.sol2-card-illus img { width: 100%; height: 100%; object-fit: contain; display: block; padding: 1rem 0 0.5rem; }
.sol2-card-badge {
  position: absolute; top: 1rem; left: 1rem;
  background: white; color: var(--navy);
  font-size: 0.68rem; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.12em; padding: 0.35rem 0.6rem;
  border-radius: 4px;
}
.sol2-badge-red { color: #b42318; }

.sol2-card-content { flex: 1; padding: 1.75rem 2rem 2rem; display: flex; flex-direction: column; }
.sol2-card-content h3 { font-size: 1.5rem; color: var(--navy); margin-bottom: 0.25rem; }
.sol2-card-tagline { font-size: 0.95rem; color: var(--navy); font-weight: 500; margin-bottom: 0.85rem; }
.sol2-card-desc { font-size: 0.95rem; color: var(--gray-600); line-height: 1.7; margin-bottom: 1.1rem; }
.sol2-card-features {
  list-style: none; padding: 1rem 0 0;
  border-top: 1px solid rgba(15, 37, 72, 0.1);
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 0.45rem 1rem; margin-bottom: 1.1rem;
}
.sol2-card-features li { font-size: 0.85rem; color: var(--gray-600); display: flex; align-items: center; gap: 0.45rem; }
:global(.sol2-check) { color: var(--navy); flex-shrink: 0; }
.sol2-card-meta { display: flex; gap: 1.5rem; margin-bottom: 1.25rem; }
.sol2-meta-item { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.82rem; font-weight: 600; color: var(--navy); }
:global(.sol2-meta-ico) { color: var(--icon-accent); }
.sol2-card-link { margin-top: auto; font-size: 0.92rem; font-weight: 600; color: var(--navy); }
.sol2-card:hover .sol2-card-link { text-decoration: underline; text-decoration-color: var(--orange-ink); text-underline-offset: 3px; }

/* ===== COMPARISON TABLE ===== */
.sol2-comparison { padding: var(--section-padding); }
.comp-table-wrap {
  overflow-x: auto; margin-bottom: 2.5rem;
  border-radius: 12px;
  border: 1px solid rgba(15, 37, 72, 0.1);
  background: white;
}
.comp-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; background: white; }
.comp-table th, .comp-table td { padding: 0.85rem 1.25rem; text-align: center; border-bottom: 1px solid rgba(15, 37, 72, 0.08); }
.comp-table tbody tr:last-child td { border-bottom: 0; }
.comp-table th:first-child, .comp-table td:first-child { text-align: left; font-weight: 600; color: var(--navy); min-width: 180px; }
.comp-table thead th {
  background: var(--navy); color: white;
  font-weight: 600; font-size: 0.78rem;
  text-transform: uppercase; letter-spacing: 0.1em;
}
.comp-table tbody tr:hover { background: #f6f7f9; }
.comp-table .check { color: var(--navy); font-weight: 700; font-size: 1.05rem; }
.comp-cta { text-align: center; }
.comp-cta p { margin-bottom: 1rem; font-size: 1rem; }

/* ===== PROCESS: numerals, no icon tiles or connectors ===== */
.sol2-process { padding: var(--section-padding); }
.sol2-process-row {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 3rem;
}
.sol2-process-step { position: relative; padding-top: 1.5rem; border-top: 1px solid rgba(15, 37, 72, 0.15); }
.sol2-process-step::before {
  content: ''; position: absolute; top: -1px; left: 0;
  width: 32px; height: 2px; background: var(--orange);
}
.sol2-process-num {
  font-family: var(--font-heading);
  font-size: 2.5rem; font-weight: 700; line-height: 1;
  letter-spacing: -0.02em; color: var(--navy);
  margin-bottom: 1rem; font-variant-numeric: tabular-nums;
}
.sol2-process-step h3 { margin-bottom: 0.5rem; font-size: 1.1rem; }
.sol2-process-step p { font-size: 0.93rem; line-height: 1.65; }

/* ===== CTA ===== */
.sol2-cta { padding: 5.5rem 0; }
.sol2-cta-inner { text-align: center; }
.sol2-cta-inner > * { max-width: 680px; margin-inline: auto; }
.sol2-cta h2 { color: var(--navy); margin-bottom: 0.75rem; font-size: clamp(1.7rem, 3vw, 2.2rem); }
.sol2-cta p { color: var(--gray-600); margin-bottom: 2rem; font-size: 1.05rem; line-height: 1.7; }
.sol2-cta-actions { display: flex; flex-direction: column; align-items: center; gap: 1rem; }
.sol2-cta-phone { font-size: 0.9rem; color: var(--gray-600); }
.sol2-cta-phone strong { color: var(--navy); }

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
  .sol2-hero-trust { gap: 1rem; }

  .sol2-card-content { padding: 1.35rem 1.25rem 1.5rem; }
  .sol2-card-features { grid-template-columns: 1fr; }

  .sol2-process-row { grid-template-columns: 1fr; gap: 1.5rem; }
  .sol2-process-step { display: grid; grid-template-columns: 3rem 1fr; column-gap: 0.75rem; padding-top: 1.25rem; }
  .sol2-process-num { grid-row: 1 / span 2; font-size: 2rem; margin: 0; }
  .sol2-cta { padding: 4rem 0; }
}

/* Mobile: cards keep a 1rem side padding inside the page gutter */
@media (max-width: 768px) {
  .sol2-card-content {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}
</style>
